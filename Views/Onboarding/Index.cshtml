@{
    ViewData["Title"] = "Welcome to FitLog";
    Layout = null;
    string displayName = TempData.Peek("DisplayName")?.ToString() ?? "there";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to FitLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/darkly/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #1a1a2e; min-height: 100vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="text-center mb-4">
                    <p class="text-muted small mb-2">Step 1 of 4</p>
                    <div class="progress" style="height: 6px; background-color: #3a3a5c;">
                        <div class="progress-bar bg-success" style="width: 25%"></div>
                    </div>
                </div>
                <div class="card p-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold mb-2" style="color: var(--fitlog-green);">Welcome, @displayName!</h1>
                        <p class="text-muted">Let's personalize your experience in 4 quick steps.</p>
                    </div>
                    <form asp-action="Step1" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-lg w-100">Let's Get Started</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>