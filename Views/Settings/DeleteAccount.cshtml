@{
    ViewData["Title"] = "Delete Account";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4" style="border-left: 3px solid #dc3545;">
            <h3 class="fw-bold text-danger mb-1">Delete Account</h3>
            <p class="text-muted mb-4">This will permanently delete your account and all associated data including workouts, nutrition logs, supplements, and settings. This cannot be undone.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-action="DeleteAccountConfirmed" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label class="fw-bold">Type <span class="text-danger">DELETE</span> to confirm</label>
                    <input name="confirmText" class="form-control mt-1" placeholder="DELETE" autocomplete="off" />
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancel</a>
                    <button type="submit" class="btn btn-danger w-100">Delete My Account</button>
                </div>
            </form>
        </div>
    </div>
</div>