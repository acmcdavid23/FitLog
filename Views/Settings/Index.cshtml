@model FitLog.Models.UserSettings
@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-1">Settings</h2>
<p class="text-muted mb-4">Customize your daily goals and preferences.</p>

<div class="card p-4 mb-4">
    <h5 class="fw-bold mb-3" style="border-bottom:1px solid #3a3a5c; padding-bottom:8px;">Profile photo</h5>
    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
    {
        <div class="mb-2"><img src="@Model.ProfileImageUrl" alt="" style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:1px solid #32383e;" /></div>
    }
    <form asp-action="UploadProfilePhoto" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="file" name="photo" id="settingsProfilePhoto" accept="image/*" class="visually-hidden" data-image-crop-circle="true" data-crop-auto-submit="true" />
        <button type="button" class="btn btn-outline-success btn-sm" onclick="document.getElementById('settingsProfilePhoto').click()">@(string.IsNullOrEmpty(Model.ProfileImageUrl) ? "Add profile photo" : "Change profile photo")</button>
        <p class="text-muted small mt-2 mb-0">After you tap Apply in the crop dialog, the upload runs automatically.</p>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProfileImageUrl" />
    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card p-4">
                <h5 class="fw-bold mb-3" style="border-bottom:1px solid #3a3a5c; padding-bottom:8px;">Nutrition Goals</h5>
                <div class="form-group mb-3">
                    <label asp-for="CalorieGoal" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="CalorieGoal" class="form-control" type="number" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">kcal</span>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ProteinGoal" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="ProteinGoal" class="form-control" type="number" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">g</span>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CarbGoal" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="CarbGoal" class="form-control" type="number" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">g</span>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="FatGoal" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="FatGoal" class="form-control" type="number" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">g</span>
                    </div>
                </div>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnCalculateMacros">Calculate macros from profile</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#macroGuideModal">View Macro Calculator Guide</button>
                </div>
                <p class="text-muted small mb-0 mt-2">Uses age, gender, height, weight, activity level, and your body goal (from Body Stats and Preferences). You can accept the numbers into your goals or edit them first.</p>
            </div>
        </div>

        <div class="col-md-5 mb-4">
            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-3" style="border-bottom:1px solid #3a3a5c; padding-bottom:8px;">Water Goal</h5>
                <div class="form-group mb-3">
                    <label asp-for="WaterGoal" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="WaterGoal" class="form-control" type="number" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">oz</span>
                    </div>
                    <small class="text-muted">128 oz = 1 gallon</small>
                </div>
            </div>

            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-3" style="border-bottom:1px solid #3a3a5c; padding-bottom:8px;">Preferences</h5>
                <div class="form-group mb-3">
                    <label asp-for="DisplayName" class="control-label"></label>
                    <input asp-for="DisplayName" class="form-control" placeholder="Your display name" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Username" class="control-label"></label>
                    <input asp-for="Username" class="form-control" placeholder="Letters and numbers only" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                    <small class="text-muted">Used by others to add you as a friend.</small>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CityRegion" class="control-label"></label>
                    <input asp-for="CityRegion" class="form-control" placeholder="e.g. Tuscaloosa, AL" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="WeightUnit" class="control-label"></label>
                    <select asp-for="WeightUnit" class="form-select">
                        <option value="lbs">lbs</option>
                        <option value="kg">kg</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="FitnessGoal" class="control-label"></label>
                    <select asp-for="FitnessGoal" class="form-select">
                        <option value="Strength">Strength</option>
                        <option value="Hypertrophy">Hypertrophy (Muscle Growth)</option>
                        <option value="Conditioning">Conditioning / Endurance</option>
                        <option value="Weight Loss">Weight Loss</option>
                        <option value="General Fitness">General Fitness</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="BodyGoal" class="control-label"></label>
                    <select asp-for="BodyGoal" class="form-select">
                        <option value="Bulk">Bulk</option>
                        <option value="Cut">Cut</option>
                        <option value="Maintain">Maintain</option>
                    </select>
                </div>
                <div class="form-group mb-0 form-check">
                    <input class="form-check-input" asp-for="ShowOnLeaderboard" />
                    <label class="form-check-label" asp-for="ShowOnLeaderboard">Show my stats on leaderboards</label>
                    <small class="d-block text-muted">Uncheck to hide your name from all public leaderboards</small>
                </div>
            </div>

            <div class="card p-4">
                <h5 class="fw-bold mb-3" style="border-bottom:1px solid #3a3a5c; padding-bottom:8px;">Body Stats</h5>
                <div class="row mb-3">
                    <div class="col-6">
                        <label asp-for="Age" class="control-label"></label>
                        <div class="input-group">
                            <input asp-for="Age" class="form-control" type="number" min="13" max="100" />
                            <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">yrs</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label asp-for="Gender" class="control-label"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <label asp-for="CurrentWeight" class="control-label"></label>
                        <div class="input-group">
                            <input asp-for="CurrentWeight" class="form-control" type="number" step="0.1" />
                            <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">lbs</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label asp-for="GoalWeight" class="control-label"></label>
                        <div class="input-group">
                            <input asp-for="GoalWeight" class="form-control" type="number" step="0.1" />
                            <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">lbs</span>
                        </div>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="HeightInches" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="HeightInches" class="form-control" type="number" step="0.1" />
                        <span class="input-group-text" style="background-color:#2d2d44; border-color:#3a3a5c; color:#e0e0e0;">in</span>
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label asp-for="ActivityLevel" class="control-label"></label>
                    <select asp-for="ActivityLevel" class="form-select">
                        <option value="Sedentary">Sedentary (little or no exercise)</option>
                        <option value="Light">Light (exercise 1–3 days/week)</option>
                        <option value="Moderate">Moderate (3–5 days/week)</option>
                        <option value="Active">Active (6–7 days/week)</option>
                        <option value="VeryActive">Very active (athlete / physical job)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="settings-actions-stack d-flex flex-column gap-3 w-100">
        <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-3">
            <button type="submit" class="btn btn-success btn-lg flex-fill">Save Settings</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill text-center">Cancel</a>
        </div>
        <a asp-controller="Settings" asp-action="DeleteAccount" class="btn btn-outline-danger btn-lg w-100 text-center">Delete Account</a>
    </div>
</form>

<div class="modal fade" id="macroCalcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Calculated macros</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="macroCalcLoading" class="text-muted mb-0">Calculating…</p>
                <div id="macroCalcError" class="alert alert-danger d-none" role="alert"></div>
                <div id="macroCalcResult" class="d-none">
                    <p class="text-muted small" id="macroCalcMeta"></p>
                    <div class="form-group mb-2">
                        <label class="control-label" for="macroCalcCalories">Calories (kcal)</label>
                        <input type="number" class="form-control" id="macroCalcCalories" min="500" max="20000" />
                    </div>
                    <div class="form-group mb-2">
                        <label class="control-label" for="macroCalcProtein">Protein (g)</label>
                        <input type="number" class="form-control" id="macroCalcProtein" min="0" max="2000" />
                    </div>
                    <div class="form-group mb-2">
                        <label class="control-label" for="macroCalcCarbs">Carbs (g)</label>
                        <input type="number" class="form-control" id="macroCalcCarbs" min="0" max="2000" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label" for="macroCalcFat">Fat (g)</label>
                        <input type="number" class="form-control" id="macroCalcFat" min="0" max="2000" />
                    </div>
                    <p class="text-muted small mb-3">Adjust any value above, then apply to copy them into your nutrition goals. Save settings when you are done.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success" id="macroCalcApply">Apply to nutrition goals</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="macroGuideModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Macro calculator guide</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_MacroCalculatorGuide")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var calcUrl = @System.Text.Json.JsonSerializer.Serialize(Url.Action("CalculateMacros", "Settings"));
            var btn = document.getElementById('btnCalculateMacros');
            if (!btn || !calcUrl) return;
            var modalEl = document.getElementById('macroCalcModal');
            var loadingEl = document.getElementById('macroCalcLoading');
            var errEl = document.getElementById('macroCalcError');
            var resultEl = document.getElementById('macroCalcResult');
            var metaEl = document.getElementById('macroCalcMeta');
            var applyBtn = document.getElementById('macroCalcApply');
            function valNum(id) {
                var el = document.getElementById(id);
                if (!el) return 0;
                var n = parseFloat(el.value);
                return isNaN(n) ? 0 : n;
            }
            function valStr(id) {
                var el = document.getElementById(id);
                return el ? (el.value || '').trim() : '';
            }
            function showState(loading, err, showResult) {
                loadingEl.classList.toggle('d-none', !loading);
                if (!err) {
                    errEl.classList.add('d-none');
                    errEl.textContent = '';
                } else {
                    errEl.classList.remove('d-none');
                    errEl.textContent = err;
                }
                resultEl.classList.toggle('d-none', !showResult);
            }
            btn.addEventListener('click', function () {
                var payload = {
                    age: Math.round(valNum('Age')),
                    gender: valStr('Gender'),
                    heightInches: valNum('HeightInches'),
                    currentWeight: valNum('CurrentWeight'),
                    weightUnit: valStr('WeightUnit'),
                    activityLevel: valStr('ActivityLevel'),
                    bodyGoal: valStr('BodyGoal'),
                    fitnessGoal: valStr('FitnessGoal')
                };
                var m = bootstrap.Modal.getOrCreateInstance(modalEl);
                m.show();
                showState(true, '', false);
                fetch(calcUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                }).then(function (r) { return r.json(); }).then(function (j) {
                    showState(false, '', false);
                    var ok = j && (j.ok === true || j.Ok === true);
                    if (!ok) {
                        var msg = (j && (j.error || j.Error)) ? (j.error || j.Error) : 'Could not calculate macros.';
                        showState(false, msg, false);
                        return;
                    }
                    var d = j.data || j.Data;
                    if (!d) {
                        showState(false, 'Unexpected response.', false);
                        return;
                    }
                    document.getElementById('macroCalcCalories').value = d.calories != null ? d.calories : d.Calories;
                    document.getElementById('macroCalcProtein').value = d.protein != null ? d.protein : d.Protein;
                    document.getElementById('macroCalcCarbs').value = d.carbs != null ? d.carbs : d.Carbs;
                    document.getElementById('macroCalcFat').value = d.fat != null ? d.fat : d.Fat;
                    var bmr = d.bmr != null ? d.bmr : d.Bmr;
                    var tdee = d.tdee != null ? d.tdee : d.Tdee;
                    metaEl.textContent = 'Estimated BMR ' + bmr + ' kcal/day, maintenance (TDEE) about ' + tdee + ' kcal. Target calories reflect your body goal (bulk/cut/maintain).';
                    showState(false, '', true);
                }).catch(function () {
                    showState(false, 'Network error. Try again.', false);
                });
            });
            applyBtn.addEventListener('click', function () {
                var c = document.getElementById('macroCalcCalories');
                var p = document.getElementById('macroCalcProtein');
                var cb = document.getElementById('macroCalcCarbs');
                var f = document.getElementById('macroCalcFat');
                document.getElementById('CalorieGoal').value = c.value;
                document.getElementById('ProteinGoal').value = p.value;
                document.getElementById('CarbGoal').value = cb.value;
                document.getElementById('FatGoal').value = f.value;
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            });
        })();
    </script>
}