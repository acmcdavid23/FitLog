@{
    ViewData["Title"] = "Manage Roles";
    var allRoles = ViewBag.AllRoles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
    var userRoles = ViewBag.UserRoles as IList<string>;
    string displayName = ViewBag.DisplayName;
    string userEmail = ViewBag.UserEmail;
    string userId = ViewBag.UserId;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Back to Admin Panel</a>
    <h2 class="mb-1">Manage Roles</h2>
    <p class="text-muted mb-0">
        <strong>@(string.IsNullOrEmpty(displayName) ? userEmail : displayName)</strong>
        &nbsp;<span class="text-muted small">@userEmail</span>
    </p>
</div>

<div class="card" style="max-width: 480px;">
    <div class="card-header">
        <strong>Role Assignment</strong>
    </div>
    <div class="card-body">
        <form method="post" asp-action="ManageRoles">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@userId" />

            @if (allRoles != null && allRoles.Any())
            {
                foreach (var role in allRoles)
                {
                    bool isChecked = userRoles != null && userRoles.Contains(role.Name ?? string.Empty);
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox"
                               name="selectedRoles" value="@role.Name"
                               id="role-@role.Name"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label fw-bold" for="role-@role.Name">
                            @role.Name
                            @if (role.Name == "Admin")
                            {
                                <span class="badge bg-danger ms-2">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">@role.Name</span>
                            }
                        </label>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No roles found in the system.</p>
            }

            <hr />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancel</a>
                <button type="submit" class="btn btn-success w-100">Save Roles</button>
            </div>
        </form>
    </div>
</div>