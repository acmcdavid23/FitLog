@{
    ViewData["Title"] = "Manage Roles";
}

<div class="mb-4">
    <h2 class="mb-1">Manage Roles</h2>
    <p class="text-muted">Assign or remove roles for <strong>@ViewBag.UserEmail</strong></p>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-header">
        <strong>Role Assignment</strong>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="userId" value="@ViewBag.UserId" />
            @foreach (var role in ViewBag.AllRoles)
            {
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="selectedRoles"
                           value="@role.Name"
                           @(((List<string>)ViewBag.UserRoles).Contains(role.Name) ? "checked" : "") />
                    <label class="form-check-label fw-semibold">@role.Name</label>
                </div>
            }
            <hr />
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a href="/Admin" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>