@{
    ViewData["Title"] = "Manage Roles";
}

<h2>Manage Roles for @ViewBag.UserEmail</h2>

<form method="post">
    <input type="hidden" name="userId" value="@ViewBag.UserId" />

    @foreach (var role in ViewBag.AllRoles)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="selectedRoles"
                   value="@role.Name"
                   @(((List<string>)ViewBag.UserRoles).Contains(role.Name) ? "checked" : "") />
            <label class="form-check-label">@role.Name</label>
        </div>
    }

    <br />
    <button type="submit" class="btn btn-success">Save Roles</button>
    <a href="/Admin" class="btn btn-secondary">Back</a>
</form>