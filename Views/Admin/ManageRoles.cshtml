@model FitLog.ViewModels.ManageRolesPageViewModel
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Back to Admin Panel</a>
    <h2 class="mb-1">Manage Roles</h2>
    <p class="text-muted mb-0">
        <strong>@(string.IsNullOrEmpty(Model.DisplayName) ? Model.UserEmail : Model.DisplayName)</strong>
        &nbsp;<span class="text-muted small">@Model.UserEmail</span>
    </p>
</div>

<div class="card" style="max-width: 480px;">
    <div class="card-header">
        <strong>Role Assignment</strong>
    </div>
    <div class="card-body">
        <form method="post" asp-action="ManageRoles"
              data-fitlog-ajax-url="@Url.Action("ManageRolesAjax", "Admin")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.UserId" />

            @if (Model.Roles.Any())
            {
                foreach (var role in Model.Roles)
                {
                    var idSafe = "role-" + role.RoleName.Replace(" ", "-");
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox"
                               name="selectedRoles" value="@role.RoleName"
                               id="@idSafe"
                               @(role.IsAssigned ? "checked" : "") />
                        <label class="form-check-label fw-bold" for="@idSafe">
                            @role.RoleName
                            @if (role.RoleName == "Admin")
                            {
                                <span class="badge bg-danger ms-2">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">@role.RoleName</span>
                            }
                        </label>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No roles found in the system.</p>
            }

            <hr />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancel</a>
                <button type="submit" class="btn btn-success w-100">Save Roles</button>
            </div>
        </form>
    </div>
</div>
