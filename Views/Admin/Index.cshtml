@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Admin Panel";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
    var displayNames = ViewBag.DisplayNames as Dictionary<string, string>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Admin Panel</h2>
        <p class="text-muted mb-0">Manage user accounts and role assignments.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="PlatformReports" class="btn btn-outline-success btn-sm">Platform reports</a>
        <span class="badge bg-secondary fs-6">@Model.Count() users</span>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Registered Users</strong>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Display Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var roles = userRoles != null && userRoles.ContainsKey(user.Id)
                    ? userRoles[user.Id] : new List<string>();
                    var name = displayNames != null && displayNames.ContainsKey(user.Id)
                    ? displayNames[user.Id] : "\u2014";

                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold">@name</span>
                        </td>
                        <td class="text-muted">@user.Email</td>
                        <td>
                            @{
                                var roleList = roles != null && roles.Any() ? roles : new List<string> { "User" };
                            }
                            @foreach (var role in roleList)
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-secondary") me-1">@role</span>
                            }
                        </td>
                        <td>
                            <a asp-action="ManageRoles" asp-route-userId="@user.Id"
                               class="btn btn-sm btn-outline-primary me-1">Manage Roles</a>
                            <form method="post" asp-action="DeleteUser" style="display:inline"
                                  data-fitlog-ajax-url="@Url.Action("DeleteUserAjax", "Admin")"
                                  data-fitlog-success-event="fitlog:admin-user-deleted">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this user? This cannot be undone.')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('fitlog:admin-user-deleted', function (e) {
            var uid = e.detail && e.detail.data && e.detail.data.deletedUserId;
            if (!uid) return;
            var btn = e.detail.form && e.detail.form.querySelector('button[type="submit"]');
            var tr = (btn && btn.closest('tr')) || document.querySelector('input[name="userId"][value="' + uid + '"]')?.closest('tr');
            tr?.remove();
        });
    </script>
}
