@{
    ViewData["Title"] = "Leaderboard";
}

<div id="leaderboardShell">
    @await Html.PartialAsync("_LeaderboardShell")
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <p class="text-muted small mt-2">Your name appears highlighted in green. To opt out, <a asp-controller="Settings" asp-action="Index">go to Settings</a>.</p>
}

@section Scripts {
    <script>
        function lbCloseDropdown() {
            const shell = document.getElementById('leaderboardShell');
            if (!shell) return;
            const toggle = shell.querySelector('.dropdown [data-bs-toggle="dropdown"]');
            if (toggle && window.bootstrap?.Dropdown) {
                const inst = bootstrap.Dropdown.getInstance(toggle);
                inst?.hide();
            }
        }

        function lbBuildParams(tab, groupId, exercise) {
            const params = new URLSearchParams();
            params.set('tab', tab);
            if (groupId) params.set('groupId', groupId);
            if (exercise) params.set('exercise', exercise);
            return params;
        }

        function lbReplaceUrl(params) {
            const url = new URL(window.location.href);
            url.search = params.toString();
            window.history.replaceState({}, '', url.toString());
        }

        document.addEventListener('click', async function (e) {
            const link = e.target.closest('a[data-lb-tab]');
            if (!link || !document.getElementById('leaderboardShell')?.contains(link)) return;
            e.preventDefault();
            const tab = link.dataset.lbTab;
            const groupId = link.dataset.lbGroupId || '';
            lbCloseDropdown();
            const params = lbBuildParams(tab, groupId, '');
            const res = await fetch('@Url.Action("ShellPartial", "Leaderboard")?' + params.toString());
            document.getElementById('leaderboardShell').innerHTML = await res.text();
            lbReplaceUrl(params);
        });

        document.addEventListener('change', async function (e) {
            const sel = e.target;
            if (!sel || sel.id !== 'leaderboardExerciseSelect') return;
            const tab = sel.dataset.activeTab || 'global';
            const gid = sel.dataset.groupId || '';
            const exercise = sel.value;
            const params = lbBuildParams(tab, gid, exercise);
            const res = await fetch('@Url.Action("BoardsPartial", "Leaderboard")?' + params.toString());
            const boards = document.getElementById('leaderboardBoards');
            if (boards) boards.innerHTML = await res.text();
            lbReplaceUrl(params);
        });
    </script>
}
