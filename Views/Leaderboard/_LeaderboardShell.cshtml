@using FitLog.Models
@{
    string activeTab = ViewBag.ActiveTab ?? "global";
    var userGroups = ViewBag.UserGroups as List<FitLogGroup> ?? new();
    int? activeGroupId = ViewBag.ActiveGroupId as int?;
    string tabLabel = activeTab == "friends" ? "Friends" : activeTab == "group" ? (ViewBag.ActiveGroupName as string ?? "Group") : "Global";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Leaderboard</h2>
        <p class="text-muted mb-0">Compete with FitLog users. Rankings reset weekly.</p>
    </div>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @tabLabel
        </button>
        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
            <li>
                <a class="dropdown-item @(activeTab == "global" ? "active" : "")"
                   href="@Url.Action("Index", new { tab = "global" })"
                   data-lb-tab="global">Global</a>
            </li>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li>
                    <a class="dropdown-item @(activeTab == "friends" ? "active" : "")"
                       href="@Url.Action("Index", new { tab = "friends" })"
                       data-lb-tab="friends">Friends</a>
                </li>
                @foreach (var g in userGroups)
                {
                    <li>
                        <a class="dropdown-item @(activeTab == "group" && activeGroupId == g.Id ? "active" : "")"
                           href="@Url.Action("Index", new { tab = "group", groupId = g.Id })"
                           data-lb-tab="group"
                           data-lb-group-id="@g.Id">@g.Name</a>
                    </li>
                }
            }
        </ul>
    </div>
</div>

<div id="leaderboardBoards">
    @await Html.PartialAsync("_LeaderboardBoards")
</div>
