@model IEnumerable<FitLog.Models.WeightLog>
@{
    ViewData["Title"] = "Bodyweight Progress";
    string unit = ViewBag.WeightUnit ?? "lbs";
    decimal goalWeight = (decimal)(ViewBag.GoalWeight ?? 0);
    var logs = Model.ToList();
    var latest = logs.FirstOrDefault();
    var oldest = logs.LastOrDefault();
    decimal change = (latest != null && oldest != null && logs.Count > 1)
        ? latest.WeightLbs - oldest.WeightLbs : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Bodyweight Progress</h2>
        <p class="text-muted mb-0">Log and track your weight over time.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Current Weight</p>
            <h3 style="color: var(--fitlog-green);">
                @if (latest != null)
                {
                    @(unit == "kg"
                        ? Math.Round(latest.WeightLbs / 2.205m, 1).ToString()
                        : latest.WeightLbs.ToString("F1"))
                }
                else
                {
                    <text>—</text>
                }
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Goal Weight</p>
            <h3 style="color: #17a2b8;">
                @if (goalWeight > 0)
                {
                    @(unit == "kg"
                        ? Math.Round(goalWeight / 2.205m, 1).ToString()
                        : goalWeight.ToString("F1"))
                }
                else
                {
                    <text>—</text>
                }
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Total Change</p>
            <h3 style="color: @(change <= 0 ? "#28a745" : "#ffc107");">
                @(change > 0 ? "+" : "")@(unit == "kg"
                    ? Math.Round(change / 2.205m, 1).ToString("F1")
                    : change.ToString("F1"))
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Entries</p>
            <h3 style="color: var(--fitlog-green);">@logs.Count</h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Log Today's Weight</h5>
            <form asp-action="Log" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label class="fw-bold mb-1">Weight</label>
                    <div class="input-group">
                        <input name="weightLbs" type="number" step="0.1" class="form-control form-control-lg"
                               placeholder="e.g. 185.5" required />
                        <select name="weightUnit" class="form-select" style="max-width:80px;">
                            <option value="lbs">lbs</option>
                            <option value="kg">kg</option>
                        </select>
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label class="fw-bold mb-1">Notes <span class="text-muted small">(optional)</span></label>
                    <input name="notes" class="form-control" placeholder="e.g. Morning, post-workout..." />
                </div>
                <button type="submit" class="btn btn-success w-100">Log Weight</button>
            </form>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header"><strong>Weight History</strong></div>
            @if (!logs.Any())
            {
                <div class="text-center py-4">
                    <p class="text-muted">No weight entries yet. Log your first weight on the left.</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Weight (@unit)</th>
                                    <th>Change</th>
                                    <th>Notes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < logs.Count; i++)
                                {
                                    var log = logs[i];
                                    decimal displayWeight = unit == "kg"
                                        ? Math.Round(log.WeightLbs / 2.205m, 1)
                                        : log.WeightLbs;
                                    decimal diff = i < logs.Count - 1
                                        ? log.WeightLbs - logs[i + 1].WeightLbs
                                        : 0;
                                    decimal displayDiff = unit == "kg"
                                        ? Math.Round(diff / 2.205m, 1)
                                        : Math.Round(diff, 1);

                                    <tr>
                                        <td class="ps-4">@log.LogDate.ToString("MMM d, yyyy")</td>
                                        <td class="fw-bold">@displayWeight</td>
                                        <td>
                                            @if (i < logs.Count - 1)
                                            {
                                                <span style="color: @(diff < 0 ? "#28a745" : diff > 0 ? "#ffc107" : "#6c757d");">
                                                    @(displayDiff > 0 ? "+" : "")@displayDiff
                                                </span>
                                            }
                                        </td>
                                        <td class="text-muted small">@log.Notes</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-secondary me-1"
                                                    onclick="openEdit(@log.Id, @log.WeightLbs, '@log.Notes')">
                                                Edit
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@log.Id"
                                                  method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Delete this entry?')">✕</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Edit Weight Entry</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <input type="hidden" name="weightUnit" value="@unit" />
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Weight (@unit)</label>
                        <input name="weightLbs" id="editWeight" type="number" step="0.1"
                               class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="fw-bold mb-1">Notes</label>
                        <input name="notes" id="editNotes" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEdit(id, weightLbs, notes) {
            const unit = '@unit';
            const displayWeight = unit === 'kg'
                ? Math.round(weightLbs / 2.205 * 10) / 10
                : weightLbs;
            document.getElementById('editId').value = id;
            document.getElementById('editWeight').value = displayWeight;
            document.getElementById('editNotes').value = notes;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}