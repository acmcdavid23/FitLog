@model IEnumerable<FitLog.Models.WeightLog>
@{
    ViewData["Title"] = "Bodyweight Progress";
    string unit = ViewBag.WeightUnit ?? "lbs";
    decimal goalWeight = (decimal)(ViewBag.GoalWeight ?? 0);
    var logs = Model.ToList();
    var latest = logs.FirstOrDefault();
    var oldest = logs.LastOrDefault();
    decimal settingsWeight = (decimal)(ViewBag.SettingsCurrentWeight ?? 0);
    decimal change = (latest != null && oldest != null && logs.Count > 1)
        ? latest.WeightLbs - oldest.WeightLbs : 0;

    // Chart data — last 30 entries oldest first
    var chartLogs = logs.AsEnumerable().Reverse().Take(30).ToList();
    var chartLabels = chartLogs.Select(l => l.LogDate.ToString("MMM d")).ToList();
    var chartData = chartLogs.Select(l => unit == "kg"
        ? Math.Round(l.WeightLbs / 2.205m, 1)
        : l.WeightLbs).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Bodyweight Progress</h2>
        <p class="text-muted mb-0">Log and track your weight over time.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Current Weight</p>
            <h3 style="color: var(--fitlog-green);">
                @{
                    decimal? curLbs = latest != null ? latest.WeightLbs : (settingsWeight > 0 ? settingsWeight : null);
                }
                @if (curLbs != null)
                {
                    @(unit == "kg"
                        ? Math.Round(curLbs.Value / 2.205m, 1).ToString()
                        : curLbs.Value.ToString("F1"))
                }
                else { <text>—</text> }
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Goal Weight</p>
            <h3 style="color: #17a2b8;">
                @if (goalWeight > 0)
                {
                    @(unit == "kg"
                        ? Math.Round(goalWeight / 2.205m, 1).ToString()
                        : goalWeight.ToString("F1"))
                }
                else { <text>—</text> }
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Total Change</p>
            <h3 style="color: @(change <= 0 ? "#28a745" : "#ffc107");">
                @(change > 0 ? "+" : "")@(unit == "kg"
                    ? Math.Round(change / 2.205m, 1).ToString("F1")
                    : change.ToString("F1"))
                <span class="text-muted" style="font-size:1rem;">@unit</span>
            </h3>
        </div>
    </div>
    <div class="col-6 col-md-3 mb-3">
        <div class="card p-3 text-center">
            <p class="text-muted small mb-1">Entries</p>
            <h3 style="color: var(--fitlog-green);">@logs.Count</h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Log Today's Weight</h5>
            <form asp-controller="WeightLog" asp-action="Log" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label class="fw-bold mb-1">Weight</label>
                    <div class="input-group">
                        <input name="weightLbs" type="number" step="0.1" class="form-control form-control-lg"
                               placeholder="e.g. 185.5" required />
                        <select name="weightUnit" class="form-select" style="max-width:80px;">
                            <option value="lbs">lbs</option>
                            <option value="kg">kg</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-success w-100">Log Weight</button>
            </form>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        @if (chartLogs.Any())
        {
            <div class="card p-4 mb-4">
                <h6 class="fw-bold mb-3">Progress Chart</h6>
                <canvas id="weightChart" height="120"></canvas>
            </div>
        }

        <div class="card">
            <div class="card-header"><strong>Weight History</strong></div>
            @if (!logs.Any() && settingsWeight <= 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted">No weight entries yet. Log your first weight on the left.</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Weight (@unit)</th>
                                    <th>Change</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!logs.Any() && settingsWeight > 0)
                                {
                                    decimal displayProfile = unit == "kg"
                                        ? Math.Round(settingsWeight / 2.205m, 1)
                                        : settingsWeight;
                                    <tr>
                                        <td class="ps-4 text-muted">Profile</td>
                                        <td class="fw-bold">@displayProfile.ToString("F1")</td>
                                        <td colspan="2" class="text-muted small">From your account settings. Log weight to build full history.</td>
                                    </tr>
                                }
                                @for (int i = 0; i < logs.Count; i++)
                                {
                                    var log = logs[i];
                                    decimal displayWeight = unit == "kg"
                                        ? Math.Round(log.WeightLbs / 2.205m, 1)
                                        : log.WeightLbs;
                                    decimal diff = i < logs.Count - 1
                                        ? log.WeightLbs - logs[i + 1].WeightLbs : 0;
                                    decimal displayDiff = unit == "kg"
                                        ? Math.Round(diff / 2.205m, 1)
                                        : Math.Round(diff, 1);

                                    <tr>
                                        <td class="ps-4">@log.LogDate.ToString("MMM d, yyyy")</td>
                                        <td class="fw-bold">@displayWeight</td>
                                        <td>
                                            @if (i < logs.Count - 1)
                                            {
                                                <span style="color: @(diff < 0 ? "#28a745" : diff > 0 ? "#ffc107" : "#6c757d");">
                                                    @(displayDiff > 0 ? "+" : "")@displayDiff
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-secondary me-1"
                                                    onclick="openEdit(@log.Id, @log.WeightLbs)">
                                                Edit
                                            </button>
                                            <form asp-controller="WeightLog" asp-action="Delete"
                                                  asp-route-id="@log.Id" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Delete this entry?')">&#x2715;</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Edit Weight Entry</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="WeightLog" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <input type="hidden" name="weightUnit" value="@unit" />
                <input type="hidden" name="notes" value="" />
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Weight (@unit)</label>
                        <input name="weightLbs" id="editWeight" type="number" step="0.1"
                               class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function openEdit(id, weightLbs) {
            const unit = '@unit';
            const displayWeight = unit === 'kg'
                ? Math.round(weightLbs / 2.205 * 10) / 10
                : weightLbs;
            document.getElementById('editId').value = id;
            document.getElementById('editWeight').value = displayWeight;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        @if (chartLogs.Any())
        {
            <text>
            const ctx = document.getElementById('weightChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartLabels)),
                    datasets: [{
                        label: 'Weight (@unit)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData)),
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40, 167, 69, 0.1)',
                        borderWidth: 2,
                        pointBackgroundColor: '#28a745',
                        pointRadius: 3,
                        tension: 0.3,
                        fill: true
                    }@if (goalWeight > 0)
                    {
                        var goalDisplay = unit == "kg" ? Math.Round(goalWeight / 2.205m, 1) : goalWeight;
                        <text>
                    ,{
                        label: 'Goal (@unit)',
                        data: Array(@chartLogs.Count).fill(@goalDisplay),
                        borderColor: '#17a2b8',
                        borderWidth: 1,
                        borderDash: [5, 5],
                        pointRadius: 0,
                        fill: false
                    }
                        </text>
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { labels: { color: '#e0e0e0' } }
                    },
                    scales: {
                        x: { ticks: { color: '#adb5bd' }, grid: { color: '#3a3a5c' } },
                        y: { ticks: { color: '#adb5bd' }, grid: { color: '#3a3a5c' } }
                    }
                }
            });
            </text>
        }
    </script>
}