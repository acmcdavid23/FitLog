<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/slate/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="110" height="32" viewBox="0 0 110 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Dumbbell icon -->
                        <rect x="1" y="11" width="4" height="10" rx="1.5" fill="#28a745" />
                        <rect x="5" y="13" width="3" height="6" rx="1" fill="#28a745" />
                        <rect x="8" y="14.5" width="10" height="3" rx="1" fill="#28a745" />
                        <rect x="18" y="13" width="3" height="6" rx="1" fill="#28a745" />
                        <rect x="21" y="11" width="4" height="10" rx="1.5" fill="#28a745" />
                        <!-- FitLog text -->
                        <text x="30" y="22" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#28a745">Fit</text>
                        <text x="52" y="22" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="400" fill="#e0e0e0">Log</text>
                    </svg>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                @(User.Identity != null && User.Identity.IsAuthenticated ? "Dashboard" : "Home")
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Friends" asp-action="Index">Friends</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Groups" asp-action="Index">Groups</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">Leaderboard</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item align-self-md-center ms-md-2 mt-2 mt-md-0">
                                <a class="nav-link py-1 px-3 workout-nav-btn" asp-controller="WorkoutEntries" asp-action="StartWorkout">Start workout</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Fitness</a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="WorkoutEntries" asp-action="Index">My Workouts</a></li>
                                    <li><a class="dropdown-item" asp-controller="ExerciseLibrary" asp-action="Index">Exercise Library</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Reports</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Wellness</a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="Nutrition" asp-action="Index">Nutrition</a></li>
                                    <li><a class="dropdown-item" asp-controller="WeightLog" asp-action="Index">Bodyweight Progress</a></li>
                                    <li><a class="dropdown-item" asp-controller="Supplement" asp-action="Index">Supplements</a></li>
                                    <li><a class="dropdown-item" asp-controller="Water" asp-action="Index">Water</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Settings" asp-action="Index">Settings</a></li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="fitlog-logout-form">
                                    <button type="submit" class="nav-link border-0 bg-transparent fitlog-nav-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @await Component.InvokeAsync("UsernameRequired")
    }

    <footer class="border-top footer mt-4 py-3">
        <div class="container">&copy; 2026 - FitLog</div>
    </footer>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <button class="floating-ai-btn" onclick="toggleFloatingChat()" title="AI Coach">AI</button>
        <div class="floating-chat-window" id="floatingChatWindow">
            <div class="floating-chat-header">
                <div><strong style="color: var(--fitlog-green);">AI Coach</strong><span class="text-muted small ms-2">Ask me anything</span></div>
                <button onclick="toggleFloatingChat()" style="background:none;border:none;color:#e0e0e0;font-size:1.2rem;cursor:pointer;">&#x2715;</button>
            </div>
            <div class="floating-chat-messages" id="floatingChatMessages">
                <div class="chat-bubble-ai">Hey! I'm your AI Coach. Ask me about workouts, nutrition, or recovery.</div>
            </div>
            <div class="floating-chat-input">
                <input type="text" id="floatingInput" class="form-control form-control-sm" placeholder="Ask your coach..." onkeypress="handleFloatingKey(event)" />
                <button class="btn btn-success btn-sm px-3" onclick="sendFloatingMessage()" id="floatingSendBtn">Send</button>
            </div>
        </div>
    }

    <div class="modal fade" id="imageCropModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#272b30;border:1px solid #3a3a5c;">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Adjust picture</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="image-crop-stage mb-3">
                        <canvas id="imageCropCanvas" width="320" height="320"></canvas>
                        <div class="image-crop-circle-overlay"></div>
                    </div>
                    <label class="form-label small text-muted">Zoom</label>
                    <input type="range" id="imageCropZoom" class="form-range" min="1" max="3" step="0.01" value="1" />
                    <small class="text-muted d-block mb-1">Scroll up or down on the preview to zoom (pinch with two fingers on a phone). Drag to reposition.</small>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-success" id="imageCropApplyBtn">Apply Crop</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            let floatingHistory = [], chatOpen = false;
            function toggleFloatingChat() {
                const win = document.getElementById('floatingChatWindow');
                chatOpen = !chatOpen;
                win.style.display = chatOpen ? 'flex' : 'none';
                if (chatOpen) setTimeout(() => document.getElementById('floatingInput').focus(), 100);
            }
            function handleFloatingKey(e) { if (e.key === 'Enter') sendFloatingMessage(); }
            async function sendFloatingMessage() {
                const input = document.getElementById('floatingInput');
                const message = input.value.trim();
                if (!message) return;
                input.value = '';
                addFloatingMessage('user', message);
                const btn = document.getElementById('floatingSendBtn');
                btn.disabled = true; btn.textContent = '...';
                try {
                    const res = await fetch('/AICoach/Chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message, history: floatingHistory }) });
                    const data = await res.json();
                    floatingHistory.push({ role: 'user', content: message });
                    floatingHistory.push({ role: 'assistant', content: data.response });
                    const parsed = window.fitlogAI
                        ? window.fitlogAI.parseActionEnvelope(data.response)
                        : { displayText: data.response.replace(/```json[\s\S]*?```/g, '').trim(), envelope: null };
                    addFloatingMessage('assistant', parsed.displayText.replace(/```json[\s\S]*?```/g, '').trim(), parsed.envelope);
                } catch { addFloatingMessage('assistant', 'Sorry, something went wrong.'); }
                btn.disabled = false; btn.textContent = 'Send';
            }
            function addFloatingMessage(role, content, envelope) {
                const c = document.getElementById('floatingChatMessages');
                if (role === 'assistant' && window.fitlogAI) {
                    window.fitlogAI.appendAiMessage(c, content, envelope);
                    return;
                }
                const d = document.createElement('div');
                d.className = role === 'user' ? 'chat-bubble-user' : 'chat-bubble-ai';
                d.textContent = content;
                c.appendChild(d);
                c.scrollTop = c.scrollHeight;
            }
        </script>
    }
</body>
</html>