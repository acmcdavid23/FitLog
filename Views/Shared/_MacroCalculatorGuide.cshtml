        <div class="col-6"><div class="p-2" style="background:#1f1f38;border-radius:8px;"><h6 style="font-size:0.85rem;">Weight Loss</h6><p class="text-muted mb-0" style="font-size:0.75rem;">-300 to -500 kcal</p><p class="text-muted mb-0" style="font-size:0.75rem;">P: 40% | C: 35% | F: 25%</p></div></div>
        <div class="col-6"><div class="p-2" style="background:#1f1f38;border-radius:8px;"><h6 style="font-size:0.85rem;">Maintenance</h6><p class="text-muted mb-0" style="font-size:0.75rem;">TDEE calories</p><p class="text-muted mb-0" style="font-size:0.75rem;">P: 30% | C: 45% | F: 25%</p></div></div>
        <div class="col-6"><div class="p-2" style="background:#1f1f38;border-radius:8px;"><h6 style="font-size:0.85rem;">Muscle Gain</h6><p class="text-muted mb-0" style="font-size:0.75rem;">+200 to +300 kcal</p><p class="text-muted mb-0" style="font-size:0.75rem;">P: 30% | C: 50% | F: 20%</p></div></div>
        <div class="col-6"><div class="p-2" style="background:#1f1f38;border-radius:8px;"><h6 style="font-size:0.85rem;">Endurance</h6><p class="text-muted mb-0" style="font-size:0.75rem;">+100 to +250 kcal</p><p class="text-muted mb-0" style="font-size:0.75rem;">P: 25% | C: 55% | F: 20%</p></div></div>
    </div>
</div>
