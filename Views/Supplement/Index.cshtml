@model FitLog.ViewModels.SupplementJournalPageViewModel
@{
    ViewData["Title"] = "Supplement Journal";
    var taken = Model.TakenSupplementIdsToday.Count;
    var total = Model.ActiveSupplements.Count;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Supplement Journal</h2>
        <p class="text-muted mb-0">@taken of @total taken today.</p>
    </div>
    <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addSupplementModal">
        + Add Supplement
    </button>
</div>

@if (!Model.ActiveSupplements.Any())
{
    <div class="card p-4 text-center mb-4">
        <p class="text-muted mb-3">No supplements set up yet. Add one above or browse the library below.</p>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <h2 style="color: var(--fitlog-green);">@taken / @total</h2>
                <p class="text-muted mb-0">Taken Today</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <h2 style="color: var(--fitlog-green);">@(total > 0 ? Math.Round((double)taken / total * 100, 0) : 0)%</h2>
                <p class="text-muted mb-0">Completion Rate</p>
            </div>
        </div>
    </div>

    <div class="row mb-4" id="supplementList">
        @foreach (var supplement in Model.ActiveSupplements)
        {
            var isTaken = Model.TakenSupplementIdsToday.Contains(supplement.Id);
            <div class="col-md-4 mb-3">
                <div class="card p-4 h-100" id="supp-border-@supplement.Id"
                     style="border-left: 3px solid @(isTaken ? "#28a745" : "#3a3a5c");">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold mb-1">@supplement.Name</h5>
                            <p class="text-muted small mb-1">@supplement.Dosage</p>
                            <p class="text-muted small mb-0">@supplement.TimeToTake</p>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="toggle-@supplement.Id"
                                       @(isTaken ? "checked" : "")
                                       onchange="toggleSupplement(@supplement.Id)" />
                            </div>
                            <form asp-action="Delete" asp-route-id="@supplement.Id" method="post"
                                  data-fitlog-ajax-url="@Url.Action("DeleteAjax", "Supplement", new { id = supplement.Id })"
                                  data-fitlog-success-event="fitlog:supplement-deleted">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove this supplement?')">
                                    ✕
                                </button>
                            </form>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(supplement.Notes))
                    {
                        <p class="text-muted small mt-2 mb-0">@supplement.Notes</p>
                    }
                    <div class="mt-2">
                        <span id="supp-status-@supplement.Id"
                              class="badge @(isTaken ? "bg-success" : "bg-secondary")">
                            @(isTaken ? "Taken" : "Not taken")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Supplement Library -->
<div class="mb-2">
    <button class="btn btn-outline-secondary w-100 mb-3"
            onclick="document.getElementById('librarySection').style.display = document.getElementById('librarySection').style.display === 'none' ? 'block' : 'none'">
        Browse Supplement Library
    </button>
    <div id="librarySection" style="display:none;">
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Supplement Library</h5>
            @if (Model.LibraryByCategory.Any())
            {
                @foreach (var cat in Model.LibraryByCategory)
                {
                    <h6 class="text-muted fw-bold mb-2 mt-3" style="text-transform:uppercase; font-size:0.8rem;">@cat.Category</h6>
                    <div class="row">
                        @foreach (var item in cat.Items)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card p-3 h-100" style="background-color:#1f1f38; border:1px solid #3a3a5c;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0">@item.Name</h6>
                                        @if (item.IsRecommended)
                                        {
                                            <span class="badge bg-success ms-2">Recommended</span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-1">
                                        <strong>Dose:</strong> @item.RecommendedDosage &bull;
                                        <strong>When:</strong> @item.WhenToTake
                                    </p>
                                    <p class="text-muted small mb-2">@item.Description</p>
                                    <div class="d-flex gap-2 mt-auto">
                                        <button class="btn btn-sm btn-outline-success"
                                                onclick="quickAddSupplement('@item.Name', '@item.RecommendedDosage', '@item.WhenToTake')">
                                            + Add to Mine
                                        </button>
                                        @if (!string.IsNullOrEmpty(item.InfoUrl))
                                        {
                                            <a href="@item.InfoUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                Learn More
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Add Supplement Modal -->
<div class="modal fade" id="addSupplementModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Add Supplement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Add" method="post" id="addSupplementForm"
                  data-fitlog-ajax-url="@Url.Action("AddAjax", "Supplement")"
                  data-fitlog-success-event="fitlog:supplement-added"
                  data-fitlog-close-modal="addSupplementModal">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Name</label>
                        <input name="Name" id="suppName" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Dosage</label>
                        <input name="Dosage" id="suppDosage" class="form-control" placeholder="e.g. 5g" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Time to Take</label>
                        <select name="TimeToTake" id="suppTime" class="form-control">
                            <option value="Morning">Morning</option>
                            <option value="Pre-Workout">Pre-Workout</option>
                            <option value="Post-Workout">Post-Workout</option>
                            <option value="With Meals">With Meals</option>
                            <option value="Before Bed">Before Bed</option>
                            <option value="Any time">Any time</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Notes</label>
                        <input name="Notes" class="form-control" placeholder="Optional notes" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Supplement</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function fetchToken() {
            const response = await fetch('/Supplement/GetToken');
            const data = await response.json();
            return data.token;
        }

        async function toggleSupplement(supplementId) {
            const token = await fetchToken();
            const formData = new FormData();
            formData.append('supplementId', supplementId);
            formData.append('__RequestVerificationToken', token);

            const response = await fetch('/Supplement/ToggleAjax', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                const badge = document.getElementById('supp-status-' + supplementId);
                const border = document.getElementById('supp-border-' + supplementId);
                if (data.isTaken) {
                    badge.className = 'badge bg-success';
                    badge.textContent = 'Taken';
                    border.style.borderLeft = '3px solid #28a745';
                } else {
                    badge.className = 'badge bg-secondary';
                    badge.textContent = 'Not taken';
                    border.style.borderLeft = '3px solid #3a3a5c';
                }
            }
        }

        function quickAddSupplement(name, dosage, timeToTake) {
            document.getElementById('suppName').value = name;
            document.getElementById('suppDosage').value = dosage;
            const timeSelect = document.getElementById('suppTime');
            for (let opt of timeSelect.options) {
                if (opt.value.toLowerCase().includes(timeToTake.toLowerCase().split(' ')[0]))
                    opt.selected = true;
            }
            new bootstrap.Modal(document.getElementById('addSupplementModal')).show();
        }

        function escSupp(s) {
            if (s == null) return '';
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        }

        const __suppDeleteUrlTpl = '@Url.Action("DeleteAjax", "Supplement", new { id = 99999999 })';

        async function deleteSupplementClient(id, btn) {
            if (!confirm('Remove this supplement?')) return false;
            btn.disabled = true;
            try {
                const token = await fetchToken();
                const fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                const url = __suppDeleteUrlTpl.replace('99999999', String(id));
                const res = await fetch(url, { method: 'POST', body: fd });
                const data = await res.json();
                if (data && data.success) {
                    btn.closest('.col-md-4')?.remove();
                    if (window.fitlogAlert) window.fitlogAlert(data.message || 'Removed.', 'success');
                } else if (window.fitlogAlert) window.fitlogAlert((data && (data.message || data.error)) || 'Could not remove.', 'danger');
            } finally {
                btn.disabled = false;
            }
            return false;
        }

        document.addEventListener('fitlog:supplement-added', function (e) {
            const s = e.detail?.data?.supplement;
            if (!s) return;
            const list = document.getElementById('supplementList');
            if (!list) return;
            const id = s.id;
            const name = escSupp(s.name || '');
            const dosage = escSupp(s.dosage || '');
            const time = escSupp(s.timeToTake || '');
            const col = document.createElement('div');
            col.className = 'col-md-4 mb-3';
            col.innerHTML = '<div class="card p-4 h-100" id="supp-border-' + id + '" style="border-left: 3px solid #3a3a5c;"><div class="d-flex justify-content-between align-items-start"><div><h5 class="fw-bold mb-1">' + name + '</h5><p class="text-muted small mb-1">' + dosage + '</p><p class="text-muted small mb-0">' + time + '</p></div><div class="d-flex flex-column align-items-end gap-2"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" role="switch" id="toggle-' + id + '" onchange="toggleSupplement(' + id + ')" /></div><button type="button" class="btn btn-sm btn-outline-danger" onclick="return deleteSupplementClient(' + id + ', this)">&#x2715;</button></div></div><div class="mt-2"><span id="supp-status-' + id + '" class="badge bg-secondary">Not taken</span></div></div>';
            list.appendChild(col);
        });

        document.addEventListener('fitlog:supplement-deleted', function (e) {
            const form = e.detail?.form;
            const id = e.detail?.data?.deletedId;
            const wrap = form?.closest('.col-md-4') || (id ? document.querySelector('#supp-border-' + id)?.closest('.col-md-4') : null);
            wrap?.remove();
        });
    </script>
}