@model FitLog.ViewModels.ExerciseLibraryIndexPageViewModel

@if (Model.PersonalExercises != null && Model.PersonalExercises.Any())
{
    <div class="mb-4">
        <h4 class="mb-3" style="border-bottom: 1px solid var(--fitlog-green); padding-bottom: 8px; color: var(--fitlog-green);">
            My Exercises
        </h4>
        <div class="row">
            @foreach (var exercise in Model.PersonalExercises)
            {
                <div class="col-md-4 mb-3" data-exercise-id="@exercise.Id">
                    <div class="card h-100 p-3" style="border-left: 3px solid var(--fitlog-green);">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold mb-1">@exercise.Name</h6>
                                <span class="badge bg-secondary mb-1">@exercise.MuscleGroup</span>
                                <p class="text-muted small mb-0">@exercise.Equipment</p>
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-1 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openExerciseModal(@exercise.Id)">View Details</button>
                            <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-exercise-delete-ajax"
                                    data-exercise-id="@exercise.Id"
                                    data-delete-url="@Url.Action("DeleteAjax", "ExerciseLibrary", new { id = exercise.Id })">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@foreach (var group in Model.SystemGrouped)
{
    <div class="mb-4">
        <h4 class="mb-3" style="border-bottom: 1px solid #3a3a5c; padding-bottom: 8px;">@group.MuscleGroup</h4>
        <div class="row">
            @foreach (var exercise in group.Exercises)
            {
                <div class="col-md-4 mb-3" data-exercise-id="@exercise.Id">
                    <div class="card h-100 p-3">
                        <div>
                            <h6 class="fw-bold mb-1">@exercise.Name</h6>
                            <p class="text-muted small mb-0">@exercise.Equipment</p>
                            @if (!string.IsNullOrEmpty(exercise.Description))
                            {
                                <p class="text-muted small mt-1 mb-0" style="font-size:0.8rem;">
                                    @(exercise.Description.Length > 80 ? exercise.Description.Substring(0, 80) + "..." : exercise.Description)
                                </p>
                            }
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openExerciseModal(@exercise.Id)">View Details</button>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-exercise-delete-ajax"
                                        data-exercise-id="@exercise.Id"
                                        data-delete-url="@Url.Action("DeleteAjax", "ExerciseLibrary", new { id = exercise.Id })">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (!Model.SystemGrouped.Any() && (Model.PersonalExercises == null || !Model.PersonalExercises.Any()))
{
    <div class="text-center py-5">
        <p class="text-muted">No exercises found. Try adjusting your search or filters.</p>
    </div>
}
