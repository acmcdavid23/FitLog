@model Dictionary<string, List<FitLog.Models.Exercise>>

@{
    ViewData["Title"] = "Exercise Library";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Exercise Library</h2>
        <p class="text-muted mb-0">Discover and research exercises. View details in a panel without leaving this page.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPersonalExerciseModal">+ My Exercise</button>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-outline-success">Add to Library</a>
        }
    </div>
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form id="filterForm" class="row g-3 align-items-end" onsubmit="return false;">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Search exercises..." id="searchInput" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Muscle Group</label>
            <select name="muscleGroup" class="form-select" id="muscleGroupSelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All Muscle Groups</option>
                @foreach (var mg in ViewBag.MuscleGroups)
                {
                    if (ViewBag.MuscleGroup == mg)
                    {
                        <option value="@mg" selected>@mg</option>
                    }
                    else
                    {
                        <option value="@mg">@mg</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Equipment</label>
            <select name="equipment" class="form-select" id="equipmentSelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All equipment</option>
                @foreach (var eq in ViewBag.EquipmentOptions)
                {
                    if (ViewBag.Equipment == eq)
                    {
                        <option value="@eq" selected>@eq</option>
                    }
                    else
                    {
                        <option value="@eq">@eq</option>
                    }
                }
            </select>
        </div>
    </form>
</div>

<div id="libraryMain">
    @await Html.PartialAsync("_ExerciseLibraryMain", Model)
</div>

<!-- Exercise detail modal -->
<div class="modal fade" id="exerciseDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Exercise details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="exerciseModalBody">
                <p class="text-muted">Loading…</p>
            </div>
        </div>
    </div>
</div>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="addPersonalExerciseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold">Add My Exercise</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Create a custom exercise that only you can see.</p>
                    <form asp-action="CreatePersonal" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-1" for="peName">Exercise name</label>
                            <input id="peName" name="Name" class="form-control" placeholder="e.g. Viking Press" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-1" for="peMuscle">Muscle group</label>
                            <select id="peMuscle" name="MuscleGroup" class="form-select" required
                                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                                <option value="">— Select muscle group —</option>
                                <option>Chest</option>
                                <option>Back</option>
                                <option>Shoulders</option>
                                <option>Biceps</option>
                                <option>Triceps</option>
                                <option>Legs</option>
                                <option>Core</option>
                                <option>Cardio</option>
                                <option>Full Body</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-1" for="peEquip">Equipment</label>
                            <input id="peEquip" name="Equipment" class="form-control" placeholder="e.g. Barbell, Dumbbells, Bodyweight" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-1" for="peDesc">Description</label>
                            <textarea id="peDesc" name="Description" class="form-control" rows="3" placeholder="Brief description..."></textarea>
                        </div>
                        <div class="form-group mb-3">
                            <label class="fw-bold mb-1" for="peTips">Form tips</label>
                            <textarea id="peTips" name="Tips" class="form-control" rows="3" placeholder="Form tips, one per line..."></textarea>
                        </div>
                        <input type="hidden" name="Category" value="" />
                        <input type="hidden" name="RecommendedSets" value="0" />
                        <input type="hidden" name="RecommendedReps" value="" />
                        <button type="submit" class="btn btn-success">Save Exercise</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        let searchTimeout;
        async function refreshLibrary() {
            const form = document.getElementById('filterForm');
            const params = new URLSearchParams(new FormData(form));
            const res = await fetch('@Url.Action("LibraryMainPartial", "ExerciseLibrary")?' + params.toString());
            document.getElementById('libraryMain').innerHTML = await res.text();
            try {
                const url = new URL(window.location.href);
                url.search = params.toString();
                window.history.replaceState({}, '', url);
            } catch { }
        }
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(refreshLibrary, 400);
        });
        document.getElementById('muscleGroupSelect').addEventListener('change', refreshLibrary);
        document.getElementById('equipmentSelect').addEventListener('change', refreshLibrary);

        const exerciseModalEl = document.getElementById('exerciseDetailModal');
        exerciseModalEl.addEventListener('hidden.bs.modal', function () {
            document.getElementById('exerciseModalBody').innerHTML = '<p class="text-muted">Loading…</p>';
        });

        window.openExerciseModal = async function (id) {
            const body = document.getElementById('exerciseModalBody');
            body.innerHTML = '<p class="text-muted p-2">Loading…</p>';
            const modal = bootstrap.Modal.getOrCreateInstance(exerciseModalEl);
            modal.show();
            try {
                const res = await fetch('@Url.Action("ExerciseModalBody", "ExerciseLibrary")?id=' + encodeURIComponent(id));
                if (!res.ok) { body.innerHTML = '<p class="text-danger p-2">Could not load exercise.</p>'; return; }
                body.innerHTML = await res.text();
            } catch {
                body.innerHTML = '<p class="text-danger p-2">Could not load exercise.</p>';
            }
        };
    </script>
}
