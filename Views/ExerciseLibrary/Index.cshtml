@model Dictionary<string, List<FitLog.Models.Exercise>>

@{
    ViewData["Title"] = "Exercise Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Exercise Library</h2>
        <p class="text-muted mb-0">Discover and research exercises. Click any exercise for full details, tips, and form guidance.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="CreatePersonal" class="btn btn-outline-success">+ My Exercise</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">Add to Library</a>
        }
    </div>
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form method="get" id="filterForm" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Search exercises..." id="searchInput" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Muscle Group</label>
            <select name="muscleGroup" class="form-select" id="muscleGroupSelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All Muscle Groups</option>
                @foreach (var mg in ViewBag.MuscleGroups)
                {
                    if (ViewBag.MuscleGroup == mg)
                    {
                        <option value="@mg" selected>@mg</option>
                    }
                    else
                    {
                        <option value="@mg">@mg</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" id="categorySelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All Categories</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    if (ViewBag.Category == cat)
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Personal Exercises -->
@if (ViewBag.PersonalExercises != null && ((List<FitLog.Models.Exercise>)ViewBag.PersonalExercises).Any())
{
    <div class="mb-4">
        <h4 class="mb-3" style="border-bottom: 1px solid var(--fitlog-green); padding-bottom: 8px; color: var(--fitlog-green);">
            My Exercises
        </h4>
        <div class="row">
            @foreach (var exercise in ViewBag.PersonalExercises)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 p-3" style="border-left: 3px solid var(--fitlog-green);">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold mb-1">@exercise.Name</h6>
                                <span class="badge bg-secondary mb-1">@exercise.MuscleGroup</span>
                                <p class="text-muted small mb-0">@exercise.Equipment</p>
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@exercise.Id" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this exercise?')">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Library Exercises Grouped by Muscle Group -->
@foreach (var group in Model)
{
    <div class="mb-4">
        <h4 class="mb-3" style="border-bottom: 1px solid #3a3a5c; padding-bottom: 8px;">@group.Key</h4>
        <div class="row">
            @foreach (var exercise in group.Value)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 p-3">
                        <div>
                            <h6 class="fw-bold mb-1">@exercise.Name</h6>
                            <span class="badge @(exercise.Category == "Strength" ? "bg-success" : exercise.Category == "Hypertrophy" ? "bg-info" : "bg-warning text-dark") mb-2">
                                @exercise.Category
                            </span>
                            <p class="text-muted small mb-0">@exercise.Equipment</p>
                            @if (!string.IsNullOrEmpty(exercise.Description))
                            {
                                <p class="text-muted small mt-1 mb-0" style="font-size:0.8rem;">
                                    @(exercise.Description.Length > 80 ? exercise.Description.Substring(0, 80) + "..." : exercise.Description)
                                </p>
                            }
                        </div>
                        <div class="mt-2">
                            <a asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-secondary ms-1">Edit</a>
                                <form method="post" asp-action="Delete" asp-route-id="@exercise.Id" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1"
                                            onclick="return confirm('Delete this exercise?')">
                                        Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted">No exercises found. Try adjusting your search or filters.</p>
    </div>
}

@section Scripts {
    <script>
        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => { document.getElementById('filterForm').submit(); }, 400);
        });
        document.getElementById('muscleGroupSelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });
        document.getElementById('categorySelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });
    </script>
}