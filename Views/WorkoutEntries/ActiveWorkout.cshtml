@model FitLog.Models.WorkoutSession
@{
    ViewData["Title"] = "Active Workout";
    Layout = null;
    var exerciseList = ViewBag.ExerciseList as List<FitLog.Models.Exercise> ?? new List<FitLog.Models.Exercise>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>@Model.SessionName - FitLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/darkly/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #1a1a2e;
        }

        .sticky-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background-color: #1a1a2e;
            border-bottom: 1px solid #3a3a5c;
            padding: 10px 16px;
        }

        .exercise-block {
            background-color: #2d2d44;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #3a3a5c;
        }

        .set-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

            .set-row input {
                background-color: #1a1a2e;
                border: 1px solid #3a3a5c;
                color: #e0e0e0;
                border-radius: 6px;
                padding: 8px;
                text-align: center;
                font-size: 1rem;
                width: 75px;
            }

                .set-row input:focus {
                    outline: none;
                    border-color: var(--fitlog-green);
                }

        .set-label {
            color: #888;
            font-size: 0.8rem;
            min-width: 40px;
        }

        .add-set-btn {
            background: none;
            border: 1px dashed #3a3a5c;
            color: var(--fitlog-green, #28a745);
            border-radius: 6px;
            padding: 4px 12px;
            font-size: 0.85rem;
            cursor: pointer;
            width: 100%;
            margin-top: 4px;
        }

            .add-set-btn:hover {
                background-color: #1f1f38;
            }

        .exercise-tip {
            background-color: #1a1a2e;
            border-left: 3px solid var(--fitlog-green, #28a745);
            padding: 8px 12px;
            border-radius: 0 6px 6px 0;
            margin-top: 8px;
            font-size: 0.8rem;
            color: #adb5bd;
            display: none;
            white-space: pre-line;
        }

        .add-exercise-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 16px 0;
            color: #888;
            font-size: 0.85rem;
        }

            .add-exercise-divider::before,
            .add-exercise-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background-color: #3a3a5c;
            }

        /* Rest timer panel — right side slide */
        .timer-tab {
            position: fixed;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            z-index: 500;
            display: flex;
            align-items: center;
        }

        .timer-toggle-btn {
            background-color: #1f1f38;
            border: 1px solid var(--fitlog-green, #28a745);
            border-right: none;
            border-radius: 8px 0 0 8px;
            color: var(--fitlog-green, #28a745);
            padding: 12px 6px;
            cursor: pointer;
            font-size: 1rem;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .timer-panel {
            background-color: #1f1f38;
            border: 1px solid var(--fitlog-green, #28a745);
            border-radius: 12px 0 0 12px;
            padding: 16px;
            min-width: 180px;
            display: none;
        }

            .timer-panel.open {
                display: block;
            }

        .end-btn {
            position: fixed;
            bottom: 20px;
            right: 16px;
            z-index: 200;
        }

        .floating-ai-btn {
            position: fixed;
            bottom: 80px;
            right: 16px;
            z-index: 200;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-color: var(--fitlog-green, #28a745);
            border: none;
            color: white;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(40,167,69,0.4);
        }
    </style>
</head>
<body>
    <div class="sticky-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0" style="color: var(--fitlog-green);">@Model.SessionName</h5>
                <span id="workoutElapsed" class="text-muted small">0:00</span>
            </div>
            <a asp-controller="Dashboard" asp-action="Index" class="text-muted small">Exit</a>
        </div>
    </div>

    <div class="container" style="max-width: 600px; padding-bottom: 100px; padding-top: 16px;">

        <!-- Logged exercises -->
        <div id="exerciseList">
            @foreach (var entry in Model.Entries)
            {
                var tip = exerciseList.FirstOrDefault(e => e.Name == entry.ExerciseName);
                <div class="exercise-block" id="block-@entry.Id" data-entry-id="@entry.Id">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold">@entry.ExerciseName</span>
                        <div class="d-flex gap-2 align-items-center">
                            @if (tip != null)
                            {
                                <button class="btn btn-sm btn-outline-secondary"
                                        style="font-size:0.7rem; padding:2px 8px;"
                                        onclick="toggleTips(this)">
                                    Tips
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger"
                                    style="font-size:0.7rem; padding:2px 8px;"
                                    onclick="deleteEntry(@entry.Id, this)">
                                &#x2715;
                            </button>
                        </div>
                    </div>
                    @if (tip != null)
                    {
                        <div class="exercise-tip" id="tip-@entry.Id">
                            <strong>How to perform:</strong>
                            @tip.Description

                            <strong style="display:block; margin-top:6px;">Form tips:</strong>
                            @tip.Tips
                        </div>
                    }
                    <div class="set-rows" id="sets-@entry.Id">
                        <div class="set-row" data-entry-id="@entry.Id">
                            <span class="set-label">Set 1</span>
                            <input type="number" placeholder="Reps" value="@entry.Reps"
                                   onblur="updateSet(this, @entry.Id)" />
                            <input type="number" placeholder="lbs" step="0.5" value="@entry.WeightLbs"
                                   onblur="updateSet(this, @entry.Id)" />
                            <span class="text-muted small">lbs</span>
                        </div>
                    </div>
                    <button class="add-set-btn"
                            onclick="addSetRow('@entry.ExerciseName', 'sets-@entry.Id', @entry.SessionId)">
                        + Add Set
                    </button>
                </div>
            }
        </div>

        <!-- Add Exercise Divider -->
        <div class="add-exercise-divider">
            <span>+ Add Exercise</span>
        </div>

        <!-- Add Exercise Block -->
        <div class="exercise-block" id="addExerciseBlock">
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-sm btn-success" id="chooseBtn" onclick="showChoose()">Choose</button>
                <button class="btn btn-sm btn-outline-secondary" id="typeBtn" onclick="showType()">Type Name</button>
            </div>

            <div id="chooseSection">
                <select id="chooseExercise" class="form-select mb-2"
                        style="background-color:#1a1a2e; border-color:#3a3a5c; color:#e0e0e0;"
                        onchange="selectFromLibrary()">
                    <option value="">— Select an exercise —</option>
                    @foreach (var ex in exerciseList.OrderBy(e => e.MuscleGroup).ThenBy(e => e.Name))
                    {
                        <option value="@ex.Name"
                                data-muscle="@ex.MuscleGroup"
                                data-tips="@ex.Tips"
                                data-description="@ex.Description">
                            @ex.MuscleGroup — @ex.Name
                        </option>
                    }
                </select>
            </div>

            <div id="typeSection" style="display:none;">
                <input type="text" id="customExerciseName" class="form-control mb-2"
                       placeholder="Exercise name"
                       style="background-color:#1a1a2e; border-color:#3a3a5c; color:#e0e0e0;" />
            </div>

            <div id="exerciseTipPreview" class="exercise-tip mb-2" style="display:none;"></div>

            <div class="set-row mb-3">
                <span class="set-label">Set 1</span>
                <input type="number" id="newReps" placeholder="Reps" />
                <input type="number" id="newWeight" placeholder="lbs" step="0.5" />
                <span class="text-muted small">lbs</span>
            </div>

            <button class="btn btn-success w-100" onclick="addExercise()">Add Exercise</button>
        </div>
    </div>

    <!-- Rest Timer — right side slide panel -->
    <div class="timer-tab" id="timerTab">
        <button class="timer-toggle-btn" onclick="toggleTimer()" id="timerToggleBtn">
            &#9664; Rest
        </button>
        <div class="timer-panel" id="timerPanel">
            <div class="text-center mb-2">
                <span id="restDisplay"
                      style="color: var(--fitlog-green); font-size: 1.8rem; font-weight: 700;">1:30</span>
                <p class="text-muted small mb-0">Rest Timer</p>
            </div>
            <div class="d-flex flex-wrap gap-1 mb-2 justify-content-center">
                <button class="btn btn-sm btn-outline-secondary px-2 py-1"
                        style="font-size:0.7rem;" onclick="setRest(60)">
                    1:00
                </button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1"
                        style="font-size:0.7rem;" onclick="setRest(90)">
                    1:30
                </button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1"
                        style="font-size:0.7rem;" onclick="setRest(120)">
                    2:00
                </button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1"
                        style="font-size:0.7rem;" onclick="setRest(180)">
                    3:00
                </button>
            </div>
            <input type="number" id="customRest" class="form-control form-control-sm mb-2"
                   style="background-color:#1a1a2e; border-color:#3a3a5c; color:#e0e0e0; font-size:0.75rem;"
                   placeholder="Custom (sec)" onchange="setRest(parseInt(this.value))" />
            <div class="d-flex gap-2">
                <button id="restStartBtn" class="btn btn-success btn-sm flex-grow-1"
                        onclick="toggleRest()">
                    Start
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="resetRest()">Reset</button>
            </div>
        </div>
    </div>

    <!-- Floating AI button -->
    <button class="floating-ai-btn" onclick="toggleAIChat()" title="AI Coach">AI</button>

    <!-- End Workout Button -->
    <button class="btn btn-danger btn-lg end-btn" onclick="showEndModal()">End Workout</button>

    <!-- AI Chat Modal -->
    <div class="modal fade" id="aiModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: #2d2d44;">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" style="color: var(--fitlog-green);">AI Coach</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="aiMessages"
                         style="height:300px; overflow-y:auto; padding:16px; background-color:#1f1f38;">
                        <div class="chat-bubble-ai">
                            Hey! I'm your AI Coach. Ask me about your workout or what to do next.
                        </div>
                    </div>
                    <div class="p-3 d-flex gap-2">
                        <input type="text" id="aiInput" class="form-control form-control-sm"
                               placeholder="Ask your coach..."
                               onkeypress="if(event.key==='Enter') sendAI()" />
                        <button class="btn btn-success btn-sm px-3" onclick="sendAI()"
                                id="aiSendBtn">
                            Send
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- End Workout Modal -->
    <div class="modal fade" id="endModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background-color: #2d2d44;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Finish Workout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Workout Name</label>
                        <input type="text" id="finalName" class="form-control" value="@Model.SessionName" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Date</label>
                        <input type="datetime-local" id="finalDate" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Notes <span class="text-muted small">(optional)</span></label>
                        <textarea id="finalNotes" class="form-control" rows="2"
                                  placeholder="How did it go?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" onclick="endWorkout()">
                        Finish & Get AI Summary
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Modal -->
    <div class="modal fade" id="summaryModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background-color: #2d2d44;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: var(--fitlog-green);">Workout Summary</h5>
                </div>
                <div class="modal-body">
                    <div id="summaryLoading" class="text-center py-3">
                        <div class="spinner-border text-success" role="status"></div>
                        <p class="text-muted mt-2">Analyzing your workout...</p>
                    </div>
                    <div id="summaryContent"
                         style="display:none; white-space:pre-wrap; line-height:1.9;
                                color:#e0e0e0; font-size:0.95rem;"></div>
                </div>
                <div class="modal-footer d-flex gap-2">
                    <a href="/Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
                    <a id="viewWorkoutBtn" href="#" class="btn btn-success flex-grow-1">View Full Workout</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sessionId = @Model.Id;
        let workoutStart = Date.now();
        let restSeconds = 90;
        let restCurrent = 90;
        let restRunning = false;
        let restInterval = null;
        let aiHistory = [];
        let timerOpen = false;

        // Workout elapsed timer
        setInterval(() => {
            const elapsed = Math.floor((Date.now() - workoutStart) / 1000);
            const mins = Math.floor(elapsed / 60);
            const secs = elapsed % 60;
            document.getElementById('workoutElapsed').textContent =
                mins + ':' + (secs < 10 ? '0' : '') + secs;
        }, 1000);

        // Timer toggle
        function toggleTimer() {
            timerOpen = !timerOpen;
            const panel = document.getElementById('timerPanel');
            const btn = document.getElementById('timerToggleBtn');
            panel.classList.toggle('open', timerOpen);
            btn.innerHTML = timerOpen ? '&#9654; Rest' : '&#9664; Rest';
        }

        // Rest timer
        function setRest(seconds) {
            if (isNaN(seconds) || seconds <= 0) return;
            resetRest();
            restSeconds = seconds;
            restCurrent = seconds;
            updateRestDisplay();
        }

        function toggleRest() {
            if (restRunning) {
                clearInterval(restInterval);
                restRunning = false;
                document.getElementById('restStartBtn').textContent = 'Resume';
            } else {
                restRunning = true;
                document.getElementById('restStartBtn').textContent = 'Pause';
                restInterval = setInterval(() => {
                    restCurrent--;
                    updateRestDisplay();
                    if (restCurrent <= 0) {
                        clearInterval(restInterval);
                        restRunning = false;
                        document.getElementById('restStartBtn').textContent = 'Start';
                        document.getElementById('restDisplay').style.color = '#dc3545';
                        setTimeout(() => {
                            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
                            resetRest();
                        }, 3000);
                    }
                }, 1000);
            }
        }

        function resetRest() {
            clearInterval(restInterval);
            restRunning = false;
            restCurrent = restSeconds;
            document.getElementById('restStartBtn').textContent = 'Start';
            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
            updateRestDisplay();
        }

        function updateRestDisplay() {
            const mins = Math.floor(restCurrent / 60);
            const secs = restCurrent % 60;
            document.getElementById('restDisplay').textContent =
                mins + ':' + (secs < 10 ? '0' : '') + secs;
        }

        // Exercise selection
        function showChoose() {
            document.getElementById('chooseSection').style.display = 'block';
            document.getElementById('typeSection').style.display = 'none';
            document.getElementById('chooseBtn').className = 'btn btn-sm btn-success';
            document.getElementById('typeBtn').className = 'btn btn-sm btn-outline-secondary';
        }

        function showType() {
            document.getElementById('chooseSection').style.display = 'none';
            document.getElementById('typeSection').style.display = 'block';
            document.getElementById('typeBtn').className = 'btn btn-sm btn-success';
            document.getElementById('chooseBtn').className = 'btn btn-sm btn-outline-secondary';
        }

        function selectFromLibrary() {
            const sel = document.getElementById('chooseExercise');
            const opt = sel.options[sel.selectedIndex];
            const desc = opt.dataset.description || '';
            const tips = opt.dataset.tips || '';
            const tipEl = document.getElementById('exerciseTipPreview');
            if (desc || tips) {
                tipEl.innerHTML = (desc ? '<strong>How to perform:</strong>\n' + desc + '\n\n' : '') +
                                  (tips ? '<strong>Form tips:</strong>\n' + tips : '');
                tipEl.style.display = 'block';
            } else {
                tipEl.style.display = 'none';
            }
        }

        function getExerciseName() {
            const chooseVisible = document.getElementById('chooseSection').style.display !== 'none';
            if (chooseVisible) return document.getElementById('chooseExercise').value;
            return document.getElementById('customExerciseName').value.trim();
        }

        function getMuscleGroup() {
            const sel = document.getElementById('chooseExercise');
            const opt = sel.options[sel.selectedIndex];
            return opt?.dataset?.muscle || 'General';
        }

        function getTips() {
            const sel = document.getElementById('chooseExercise');
            const opt = sel.options[sel.selectedIndex];
            const desc = opt?.dataset?.description || '';
            const tips = opt?.dataset?.tips || '';
            return { desc, tips };
        }

        // Add exercise — saves to DB and adds block to DOM
        async function addExercise() {
            const name = getExerciseName();
            const reps = parseInt(document.getElementById('newReps').value);
            const weight = parseFloat(document.getElementById('newWeight').value) || 0;
            const muscleGroup = getMuscleGroup();

            if (!name) { alert('Please select or enter an exercise.'); return; }
            if (!reps) { alert('Please enter reps for Set 1.'); return; }

            const response = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup, reps, weight })
            });

            const data = await response.json();
            if (!data.success) { alert('Failed to save. Try again.'); return; }

            const { desc, tips } = getTips();
            insertExerciseBlock(data.entryId, name, reps, weight, desc, tips);

            // Reset inputs
            document.getElementById('newReps').value = '';
            document.getElementById('newWeight').value = '';
            document.getElementById('chooseExercise').value = '';
            document.getElementById('customExerciseName').value = '';
            document.getElementById('exerciseTipPreview').style.display = 'none';
            resetRest();
        }

        function insertExerciseBlock(entryId, name, reps, weight, desc, tips) {
            const divider = document.querySelector('.add-exercise-divider');
            const block = document.createElement('div');
            block.className = 'exercise-block';
            block.id = 'block-' + entryId;
            block.dataset.entryId = entryId;

            const hasTips = desc || tips;
            const tipContent = (desc ? 'How to perform:\n' + desc + '\n\n' : '') +
                               (tips ? 'Form tips:\n' + tips : '');

            block.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">${name}</span>
                    <div class="d-flex gap-2 align-items-center">
                        ${hasTips ? `<button class="btn btn-sm btn-outline-secondary" style="font-size:0.7rem;padding:2px 8px;" onclick="toggleTips(this)">Tips</button>` : ''}
                        <button class="btn btn-sm btn-outline-danger" style="font-size:0.7rem;padding:2px 8px;" onclick="deleteEntry(${entryId}, this)">&#x2715;</button>
                    </div>
                </div>
                ${hasTips ? `<div class="exercise-tip" id="tip-${entryId}" style="white-space:pre-line;">${tipContent}</div>` : ''}
                <div class="set-rows" id="sets-${entryId}">
                    <div class="set-row" data-entry-id="${entryId}">
                        <span class="set-label">Set 1</span>
                        <input type="number" placeholder="Reps" value="${reps}" style="width:75px;" onblur="updateSet(this, ${entryId})" />
                        <input type="number" placeholder="lbs" value="${weight}" step="0.5" style="width:75px;" onblur="updateSet(this, ${entryId})" />
                        <span class="text-muted small">lbs</span>
                    </div>
                </div>
                <button class="add-set-btn" onclick="addSetRow('${name}', 'sets-${entryId}', ${sessionId})">+ Add Set</button>`;

            document.getElementById('exerciseList').insertBefore(block, divider);
        }

        function toggleTips(btn) {
            const block = btn.closest('.exercise-block');
            const tipEl = block.querySelector('.exercise-tip');
            if (!tipEl) return;
            const visible = tipEl.style.display !== 'none';
            tipEl.style.display = visible ? 'none' : 'block';
            btn.textContent = visible ? 'Tips' : 'Hide';
        }

        async function addSetRow(exerciseName, setsContainerId, sid) {
            const container = document.getElementById(setsContainerId);
            const existingSets = container.querySelectorAll('.set-row');
            const setNum = existingSets.length + 1;

            const lastInputs = existingSets[existingSets.length - 1]?.querySelectorAll('input');
            const lastReps = lastInputs?.[0]?.value || '';
            const lastWeight = lastInputs?.[1]?.value || '';

            const row = document.createElement('div');
            row.className = 'set-row';
            row.innerHTML = `
                <span class="set-label">Set ${setNum}</span>
                <input type="number" placeholder="Reps" value="${lastReps}" style="width:75px;" />
                <input type="number" placeholder="lbs" value="${lastWeight}" step="0.5" style="width:75px;" />
                <span class="text-muted small">lbs</span>
                <button onclick="removeSetRow(this, '${exerciseName}', ${sid})"
                        style="background:none;border:none;color:#888;font-size:0.8rem;">&#x2715;</button>`;

            // Save on blur
            row.querySelectorAll('input').forEach(inp => {
                inp.addEventListener('blur', () => saveNewSet(row, exerciseName, sid));
            });

            container.appendChild(row);
        }

        async function saveNewSet(row, exerciseName, sid) {
            const inputs = row.querySelectorAll('input');
            const reps = parseInt(inputs[0].value);
            const weight = parseFloat(inputs[1].value) || 0;
            if (!reps || row.dataset.saved) return;

            const response = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: sid, exerciseName, muscleGroup: 'General', reps, weight })
            });
            const data = await response.json();
            if (data.success) {
                row.dataset.saved = '1';
                row.dataset.entryId = data.entryId;
            }
        }

        async function updateSet(input, entryId) {
            // For existing entries we just let the end workout summary pick up the values
        }

        async function removeSetRow(btn, exerciseName, sid) {
            const row = btn.closest('.set-row');
            const entryId = row.dataset?.entryId;
            if (entryId) {
                await fetch('/WorkoutEntries/DeleteActiveSet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entryId: parseInt(entryId) })
                });
            }
            row.remove();
        }

        async function deleteEntry(entryId, btn) {
            const response = await fetch('/WorkoutEntries/DeleteActiveSet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entryId })
            });
            const data = await response.json();
            if (data.success) document.getElementById('block-' + entryId)?.remove();
        }

        // AI Chat
        function toggleAIChat() {
            new bootstrap.Modal(document.getElementById('aiModal')).show();
        }

        async function sendAI() {
            const input = document.getElementById('aiInput');
            const message = input.value.trim();
            if (!message) return;
            input.value = '';

            const container = document.getElementById('aiMessages');
            const userDiv = document.createElement('div');
            userDiv.className = 'chat-bubble-user';
            userDiv.textContent = message;
            container.appendChild(userDiv);
            container.scrollTop = container.scrollHeight;

            const btn = document.getElementById('aiSendBtn');
            btn.disabled = true;
            btn.textContent = '...';

            try {
                const response = await fetch('/AICoach/Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, history: aiHistory })
                });
                const data = await response.json();
                const aiResponse = data.response;
                aiHistory.push({ role: 'user', content: message });
                aiHistory.push({ role: 'assistant', content: aiResponse });

                const aiDiv = document.createElement('div');
                aiDiv.className = 'chat-bubble-ai';
                aiDiv.textContent = aiResponse.replace(/```json[\s\S]*?```/g, '').trim();
                container.appendChild(aiDiv);
                container.scrollTop = container.scrollHeight;
            } catch (e) {
                const errDiv = document.createElement('div');
                errDiv.className = 'chat-bubble-ai';
                errDiv.textContent = 'Sorry, something went wrong.';
                container.appendChild(errDiv);
            }

            btn.disabled = false;
            btn.textContent = 'Send';
        }

        function showEndModal() {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('finalDate').value = now.toISOString().slice(0, 16);
            new bootstrap.Modal(document.getElementById('endModal')).show();
        }

        async function endWorkout() {
            const name = document.getElementById('finalName').value.trim();
            const dateVal = document.getElementById('finalDate').value;
            const notes = document.getElementById('finalNotes').value.trim();
            if (!name || !dateVal) { alert('Please fill in all required fields.'); return; }

            bootstrap.Modal.getInstance(document.getElementById('endModal')).hide();
            const summaryModal = new bootstrap.Modal(document.getElementById('summaryModal'));
            summaryModal.show();

            const response = await fetch('/WorkoutEntries/EndWorkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId,
                    sessionName: name,
                    sessionDate: new Date(dateVal).toISOString(),
                    notes
                })
            });

            const data = await response.json();
            document.getElementById('summaryLoading').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';
            document.getElementById('summaryContent').textContent = data.summary;
            document.getElementById('viewWorkoutBtn').href = '/WorkoutEntries/SessionDetail/' + sessionId;
        }
    </script>
</body>
</html>