@using System.Text.Json
@using FitLog.Helpers
@model FitLog.Models.WorkoutSession
@{
    ViewData["Title"] = "Active Workout";
    Layout = null;
    var exerciseList = ViewBag.ExerciseList as List<FitLog.Models.Exercise> ?? new();
    var sessionNameJson = JsonSerializer.Serialize(Model.SessionName ?? "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>@Model.SessionName - FitLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/slate/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #1c1e22;
        }

        .sticky-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #1c1e22;
            border-bottom: 1px solid #32383e;
            padding: 10px 16px;
        }

        .exercise-block {
            background: #272b30;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #32383e;
        }

        .exercise-remove-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid #3d444c;
            background: #1c1e22;
            color: #c98d91;
            font-size: 1.15rem;
            line-height: 1;
            padding: 0;
            cursor: pointer;
            flex-shrink: 0;
        }

            .exercise-remove-btn:hover {
                border-color: #dc3545;
                color: #f5c6c9;
                background: #2a2223;
            }

        .set-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

            .set-row input {
                background: #1c1e22;
                border: 1px solid #32383e;
                color: #e0e0e0;
                border-radius: 6px;
                padding: 8px;
                text-align: center;
                font-size: 1rem;
                width: 75px;
            }

                .set-row input:focus {
                    outline: none;
                    border-color: var(--fitlog-green);
                }

        .set-label {
            color: #888;
            font-size: 0.8rem;
            min-width: 40px;
        }

        .action-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 8px 0;
            color: var(--fitlog-green,#28a745);
            font-size: 0.85rem;
            cursor: pointer;
        }

            .action-divider::before, .action-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #32383e;
            }

            .action-divider:hover span {
                text-decoration: underline;
            }

        .exercise-tip {
            background: #1c1e22;
            border-left: 3px solid var(--fitlog-green,#28a745);
            padding: 8px 12px;
            border-radius: 0 6px 6px 0;
            margin-top: 8px;
            font-size: 0.8rem;
            color: #adb5bd;
            white-space: pre-line;
            display: none;
        }

        .timer-dock {
            position: fixed;
            z-index: 500;
            transform: translateY(-50%);
            display: flex;
            align-items: flex-start;
            user-select: none;
        }

        .timer-dock-right {
            right: 0;
            left: auto;
            flex-direction: row-reverse;
        }

        .timer-dock-left {
            left: 0;
            right: auto;
            flex-direction: row;
        }

        .timer-dock-stack {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .timer-pill {
            background: #1f3a1f;
            border: 2px solid var(--fitlog-green,#28a745);
            border-radius: 999px;
            padding: 10px 13px;
            font-size: 1.3rem;
            color: var(--fitlog-green);
            white-space: nowrap;
            cursor: grab;
            touch-action: none;
            box-shadow: 0 2px 10px rgba(40,167,69,0.2);
            line-height: 1;
        }

            .timer-pill:active {
                cursor: grabbing;
            }

        .timer-dropdown {
            background: #1f3a1f;
            border: 2px solid var(--fitlog-green,#28a745);
            border-radius: 12px;
            padding: 10px 12px;
            min-width: 188px;
            box-shadow: 0 4px 15px rgba(40,167,69,0.3);
        }

        .timer-collapse-btn {
            background: #1c1e22;
            border: 1px solid #3d444c;
            border-radius: 6px;
            color: #adb5bd;
            font-size: 1.1rem;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            flex-shrink: 0;
        }

            .timer-collapse-btn:hover {
                border-color: #888;
                color: #e0e0e0;
            }

        .floating-ai-btn {
            position: fixed;
            bottom: 20px;
            right: 16px;
            z-index: 200;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--fitlog-green,#28a745);
            border: none;
            color: white;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(40,167,69,0.4);
        }

        .ai-rec-card {
            background: #272b30;
            border: 1px solid var(--fitlog-green);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
        }

        .exercise-block .btn-ex-tip {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .exercise-block .exercise-name-select {
            min-width: 0;
            max-width: 100%;
            background: #1c1e22;
            border-color: #32383e;
            color: #e0e0e0;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="sticky-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" style="color:var(--fitlog-green);">@Model.SessionName</h5>
            <button class="btn btn-danger btn-sm" onclick="showEndModal()">End Workout</button>
        </div>
    </div>

    <div class="container" style="max-width:600px; padding-bottom:120px; padding-top:16px;">
        <div id="exerciseList">
            <div id="exerciseBlocksMount">
                @foreach (var entry in Model.Entries)
                {
                    var tip = exerciseList.FirstOrDefault(e => e.Name == entry.ExerciseName);
                    var tipFromLib = tip != null
                    ? (tip.Description != null ? "How to perform:\n" + tip.Description + "\n\n" : "") + (tip.Tips != null ? "Form tips:\n" + tip.Tips : "")
                    : "";
                    var tipBody = string.IsNullOrWhiteSpace(tipFromLib) ? "No library tips for this exercise." : tipFromLib;
                    <div class="exercise-block" id="block-@entry.Id" data-exercise-name="@entry.ExerciseName">
                        <div class="mb-2">
                            <div class="exercise-name-slot mb-2">
                                <select class="form-select form-select-sm exercise-name-select w-100" data-entry-id="@entry.Id" onchange="onExerciseNameChange(this)">
                                    <option value="__fitlog_custom__">Custom name…</option>
                                    @if (ExerciseDisplay.IsPending(entry.ExerciseName))
                                    {
                                        <option value="@ExerciseDisplay.PendingInternalName" selected>-- Select Exercise --</option>
                                    }
                                    @foreach (var ex in exerciseList.OrderBy(e => e.MuscleGroup).ThenBy(e => e.Name))
                                    {
                                        if (ex.Name == entry.ExerciseName)
                                        {
                                            <option value="@ex.Name" data-muscle="@ex.MuscleGroup" selected>@ex.MuscleGroup — @ex.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@ex.Name" data-muscle="@ex.MuscleGroup">@ex.MuscleGroup — @ex.Name</option>
                                        }
                                    }
                                    @if (!ExerciseDisplay.IsPending(entry.ExerciseName) && !exerciseList.Any(e => e.Name == entry.ExerciseName))
                                    {
                                        <option value="@entry.ExerciseName" selected>@ExerciseDisplay.Format(entry.ExerciseName) (not in library)</option>
                                    }
                                </select>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-ex-tip flex-grow-1" onclick="toggleTips(this)">Tips</button>
                                <button type="button" class="exercise-remove-btn" title="Remove exercise" onclick="deleteEntry(@entry.Id, this)">&#x2715;</button>
                            </div>
                        </div>
                        <div class="exercise-tip" id="tip-@entry.Id" style="display:none;white-space:pre-line;">@tipBody</div>
                        <div class="set-rows" id="sets-@entry.Id">
                            <div class="set-row" data-entry-id="@entry.Id" data-saved="1">
                                <span class="set-label">Set 1</span>
                                <input type="number" placeholder="Reps" value="@entry.Reps" />
                                <input type="number" placeholder="lbs" step="0.5" value="@entry.WeightLbs" />
                                <span class="text-muted small">lbs</span>
                            </div>
                        </div>
                        <div class="action-divider mt-2" onclick="addSetRowFromDivider(this)">
                            <span>+ Add Set</span>
                        </div>
                    </div>
                }
            </div>
            <div class="action-divider" id="addExerciseTrigger" onclick="addQuickExercise()">
                <span>+ Add Exercise</span>
            </div>
            <div id="aiRecCard" class="ai-rec-card" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-bold" style="color:var(--fitlog-green);">AI Recommends</span>
                    <button type="button" onclick="dismissAIRecCard()" style="background:none;border:none;color:#888;font-size:0.8rem;">Dismiss</button>
                </div>
                <div id="aiRecSuggestionBody">
                    <p id="aiRecName" class="fw-bold mb-1"></p>
                    <p id="aiRecReason" class="text-muted small mb-2"></p>
                    <button type="button" class="btn btn-success btn-sm" onclick="acceptAIRec()">Add This Exercise</button>
                </div>
                <p id="aiRecEmpty" class="text-muted small mb-0" style="display:none;line-height:1.45;"></p>
            </div>
        </div>
    </div>

    <!-- Rest Timer Dock -->
    <div id="timerDock" class="timer-dock timer-dock-right" style="top:38%;">
        <div class="timer-dock-stack">
            <div class="timer-pill" id="timerPill" title="Tap to open · drag to move · double-tap to switch side">
                &#9201;
            </div>
            <div class="timer-dropdown" id="timerExpanded" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Rest Timer</span>
                    <button type="button" id="collapseBtn" class="timer-collapse-btn" title="Close">&#x2715;</button>
                </div>
                <div class="text-center mb-2">
                    <span id="restDisplay" style="color:var(--fitlog-green);font-size:1.8rem;font-weight:700;">1:30</span>
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2 justify-content-center">
                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(60)">1:00</button>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(90)">1:30</button>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(120)">2:00</button>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(180)">3:00</button>
                </div>
                <input type="number" id="customRest" class="form-control form-control-sm mb-2" style="background:#1c1e22;border-color:#32383e;color:#e0e0e0;font-size:0.75rem;" placeholder="Custom (sec)" onchange="setRest(parseInt(this.value))" />
                <div class="d-flex gap-2">
                    <button id="restStartBtn" class="btn btn-success btn-sm flex-grow-1" onclick="toggleRest()">Start</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetRest()">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <button class="floating-ai-btn" onclick="toggleAIChat()" title="AI Coach">AI</button>

    <!-- AI Modal -->
    <div class="modal fade" id="aiModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" style="color:var(--fitlog-green);">AI Coach</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="aiMessages" style="height:300px;overflow-y:auto;padding:16px;background:#1f1f38;">
                        <div class="chat-bubble-ai">Hey! Ask me about your workout or what to do next.</div>
                    </div>
                    <div class="p-3 d-flex gap-2">
                        <input type="text" id="aiInput" class="form-control form-control-sm" placeholder="Ask your coach..." onkeypress="if(event.key==='Enter') sendAI()" />
                        <button class="btn btn-success btn-sm px-3" onclick="sendAI()" id="aiSendBtn">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- End Modal -->
    <div class="modal fade" id="endModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Finish Workout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Workout Name</label><input type="text" id="finalName" class="form-control" value="@Model.SessionName" required /></div>
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Date</label><input type="datetime-local" id="finalDate" class="form-control" required /></div>
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Notes <span class="text-muted small">(optional)</span></label><textarea id="finalNotes" class="form-control" rows="2" placeholder="How did it go?"></textarea></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" onclick="endWorkout()">Finish & Get AI Summary</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Modal -->
    <div class="modal fade" id="summaryModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color:var(--fitlog-green);">Workout Summary</h5>
                </div>
                <div class="modal-body">
                    <div id="summaryLoading" class="text-center py-3"><div class="spinner-border text-success" role="status"></div><p class="text-muted mt-2">Analyzing your workout...</p></div>
                    <div id="summaryContent" style="display:none;white-space:pre-wrap;line-height:1.9;color:#e0e0e0;font-size:0.95rem;"></div>
                </div>
                <div class="modal-footer d-flex gap-2">
                    <a href="/Dashboard" class="btn btn-outline-secondary flex-grow-1 text-center">Back to Dashboard</a>
                    <a id="viewWorkoutBtn" href="#" class="btn btn-success flex-grow-1 text-center">View Full Workout</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const sessionId = @Model.Id;
        const sessionName = @Html.Raw(sessionNameJson);
        const musclesHitTodayServer = @Html.Raw(ViewBag.MusclesHitTodayJson ?? "[]");
        const exerciseLibrary = @Html.Raw(ViewBag.ExerciseLibraryJson ?? "[]");
        let restSeconds = 90, restCurrent = 90, restRunning = false, restInterval = null;
        let aiHistory = [];
        let pendingAIRec = null;
        let recentAISuggestionKeys = [];

        function escapeHtml(s) {
            if (s == null) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function lookupExerciseMeta(name) {
            const n = (name || '').trim().toLowerCase();
            if (!Array.isArray(exerciseLibrary)) return { muscleGroup: 'General', description: '', tips: '' };
            const ex = exerciseLibrary.find(e => (e.name || '').toLowerCase() === n);
            if (!ex) return { muscleGroup: 'General', description: '', tips: '' };
            return { muscleGroup: ex.muscleGroup || 'General', description: ex.description || '', tips: ex.tips || '' };
        }

        const CUSTOM_EXERCISE_VALUE = '__fitlog_custom__';
        const PENDING_EXERCISE_VALUE = '__fitlog_pending_exercise__';

        function isPendingExerciseName(name) {
            return (name || '').trim() === PENDING_EXERCISE_VALUE;
        }

        function renderExerciseNameSlotHtml(entryId, selectedName) {
            const lib = [...(Array.isArray(exerciseLibrary) ? exerciseLibrary : [])].sort((a, b) => {
                const g = (a.muscleGroup || '').localeCompare(b.muscleGroup || '');
                if (g !== 0) return g;
                return (a.name || '').localeCompare(b.name || '');
            });
            const pendingSel = !selectedName || isPendingExerciseName(selectedName) ? ' selected' : '';
            let opts = `<option value="${PENDING_EXERCISE_VALUE}"${pendingSel}>-- Select Exercise --</option>`;
            opts += `<option value="${CUSTOM_EXERCISE_VALUE}">Custom name…</option>`;
            let matched = false;
            for (const ex of lib) {
                const nm = ex.name || '';
                const sel = nm === selectedName ? ' selected' : '';
                if (nm === selectedName) matched = true;
                opts += `<option value="${escapeHtml(nm)}" data-muscle="${escapeHtml(ex.muscleGroup || '')}"${sel}>${escapeHtml((ex.muscleGroup || '') + ' — ' + nm)}</option>`;
            }
            if (selectedName && !matched && !isPendingExerciseName(selectedName)) {
                opts += `<option value="${escapeHtml(selectedName)}" selected>${escapeHtml(selectedName)} (not in library)</option>`;
            }
            return `<div class="exercise-name-slot mb-2"><select class="form-select form-select-sm exercise-name-select w-100" data-entry-id="${entryId}" onchange="onExerciseNameChange(this)">${opts}</select></div>`;
        }

        function beginCustomExerciseSlot(sel) {
            const slot = sel.closest('.exercise-name-slot');
            const block = sel.closest('.exercise-block');
            if (!slot || !block) return;
            const entryId = sel.getAttribute('data-entry-id') || '';
            const rawName = (block.getAttribute('data-exercise-name') || '').trim();
            const initial = isPendingExerciseName(rawName) ? '' : rawName;
            slot.innerHTML = `<div class="d-flex flex-column gap-1">
                <input type="text" class="form-control form-control-sm exercise-custom-input" maxlength="120" placeholder="Exercise name" value="${escapeHtml(initial)}" data-entry-id="${entryId}" />
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" onclick="submitCustomExerciseSlot(this)">Save</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cancelCustomExerciseSlot(this)">Cancel</button>
                </div>
            </div>`;
            const inp = slot.querySelector('.exercise-custom-input');
            if (inp) {
                inp.focus(); inp.select();
                inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); submitCustomExerciseSlot(inp); } });
            }
        }

        function cancelCustomExerciseSlot(btn) {
            const slot = btn.closest('.exercise-name-slot');
            const block = btn.closest('.exercise-block');
            if (!slot || !block) return;
            const idm = /^block-(\d+)$/.exec(block.id);
            const entryId = idm ? parseInt(idm[1], 10) : 0;
            const name = block.getAttribute('data-exercise-name') || '';
            slot.outerHTML = renderExerciseNameSlotHtml(entryId, name);
        }

        async function submitCustomExerciseSlot(el) {
            const slot = el.closest('.exercise-name-slot');
            const input = slot?.querySelector('.exercise-custom-input');
            await saveCustomExerciseName(input);
        }

        async function saveCustomExerciseName(input) {
            if (!input) return;
            const name = input.value.trim();
            if (!name) { alert('Enter an exercise name.'); return; }
            const entryId = parseInt(input.getAttribute('data-entry-id'), 10);
            if (!entryId) return;
            const meta = lookupExerciseMeta(name);
            const muscle = (meta.muscleGroup || 'General').trim() || 'General';
            const res = await fetch('/WorkoutEntries/UpdateActiveEntryExercise', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entryId, exerciseName: name, muscleGroup: muscle })
            });
            const data = await res.json();
            if (!data.success) { alert('Could not update exercise.'); return; }
            const slot = input.closest('.exercise-name-slot');
            const block = input.closest('.exercise-block');
            if (block) block.setAttribute('data-exercise-name', name);
            if (slot) slot.outerHTML = renderExerciseNameSlotHtml(entryId, name);
            const tipEl = document.getElementById('tip-' + entryId);
            const tipText = (meta.description ? 'How to perform:\n' + meta.description + '\n\n' : '') + (meta.tips ? 'Form tips:\n' + meta.tips : '');
            tipEl.textContent = tipText.trim() ? tipText.trim() : 'No library tips for this exercise.';
            tipEl.style.display = 'none';
            const tipsBtn = block?.querySelector('.btn-ex-tip');
            if (tipsBtn) tipsBtn.textContent = 'Tips';
            fetchAIRecommendation(name);
        }

        async function onExerciseNameChange(sel) {
            const entryId = parseInt(sel.getAttribute('data-entry-id'), 10);
            const name = sel.value;
            if (!entryId) return;
            if (name === CUSTOM_EXERCISE_VALUE) { beginCustomExerciseSlot(sel); return; }
            if (!name || isPendingExerciseName(name)) return;
            const opt = sel.options[sel.selectedIndex];
            const muscle = (opt?.dataset?.muscle || lookupExerciseMeta(name).muscleGroup || 'General').trim() || 'General';
            const res = await fetch('/WorkoutEntries/UpdateActiveEntryExercise', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entryId, exerciseName: name, muscleGroup: muscle })
            });
            const data = await res.json();
            if (!data.success) { alert('Could not update exercise.'); return; }
            const block = sel.closest('.exercise-block');
            if (block) block.setAttribute('data-exercise-name', name);
            const meta = lookupExerciseMeta(name);
            const tipEl = document.getElementById('tip-' + entryId);
            const tipText = (meta.description ? 'How to perform:\n' + meta.description + '\n\n' : '') + (meta.tips ? 'Form tips:\n' + meta.tips : '');
            tipEl.textContent = tipText.trim() ? tipText.trim() : 'No library tips for this exercise.';
            tipEl.style.display = 'none';
            const tipsBtn = block?.querySelector('.btn-ex-tip');
            if (tipsBtn) tipsBtn.textContent = 'Tips';
            fetchAIRecommendation(name);
        }

        function openExerciseSelectForBlock(entryId) {
            const block = document.getElementById('block-' + entryId);
            const sel = block?.querySelector('.exercise-name-select');
            if (!sel) return;
            block.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            requestAnimationFrame(() => {
                sel.focus();
                if (typeof sel.showPicker === 'function') { try { sel.showPicker(); } catch (_) {} }
            });
        }

        function lastResolvedExerciseForRec() {
            let last = '';
            for (const b of document.querySelectorAll('#exerciseBlocksMount .exercise-block')) {
                const v = (b.querySelector('.exercise-name-select')?.value || b.getAttribute('data-exercise-name') || '').trim();
                if (v && !isPendingExerciseName(v) && v !== CUSTOM_EXERCISE_VALUE) last = v;
            }
            return last;
        }

        async function addQuickExercise() {
            if (!Array.isArray(exerciseLibrary) || exerciseLibrary.length === 0) {
                alert('Add exercises to your library first (Exercise Library).');
                return;
            }
            const name = PENDING_EXERCISE_VALUE;
            const res = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: 'General', reps: 1, weight: 0 })
            });
            const data = await res.json();
            if (!data.success) { alert('Failed to add exercise.'); return; }
            insertBlock(data.entryId, name, 1, 0, '', '');
            resetRest();
            fetchAIRecommendation(lastResolvedExerciseForRec());
            openExerciseSelectForBlock(data.entryId);
        }

        // ── Timer dock drag ──
        const timerDock = document.getElementById('timerDock');
        const timerPill = document.getElementById('timerPill');
        let dockDragging = false, dockStartY = 0, dockStartPct = 38, dockMoved = false;

        function parseDockTopPct() {
            const t = timerDock.style.top || '';
            if (t.endsWith('%')) return parseFloat(t);
            return 38;
        }

        function moveDockByClientY(clientY) {
            const dy = clientY - dockStartY;
            const dPct = (dy / window.innerHeight) * 100;
            const next = Math.min(92, Math.max(8, dockStartPct + dPct));
            timerDock.style.top = next + '%';
        }

        function updateTimerArrow() {
            // No arrow anymore — pill shows clock icon only
        }

        timerPill.addEventListener('pointerdown', e => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            dockDragging = true; dockMoved = false;
            dockStartY = e.clientY;
            dockStartPct = parseDockTopPct();
            timerPill.setPointerCapture(e.pointerId);
        });
        timerPill.addEventListener('pointermove', e => {
            if (!dockDragging) return;
            const dy = Math.abs(e.clientY - dockStartY);
            if (dy > 6) dockMoved = true;
            if (dockMoved) moveDockByClientY(e.clientY);
        });
        timerPill.addEventListener('pointerup', e => {
            if (!dockDragging) return;
            dockDragging = false;
            try { timerPill.releasePointerCapture(e.pointerId); } catch (_) {}
            if (!dockMoved) expandTimer();
        });
        timerPill.addEventListener('pointercancel', e => {
            dockDragging = false;
            try { timerPill.releasePointerCapture(e.pointerId); } catch (_) {}
        });
        timerPill.addEventListener('dblclick', () => {
            timerDock.classList.toggle('timer-dock-right');
            timerDock.classList.toggle('timer-dock-left');
        });

        document.getElementById('collapseBtn').addEventListener('click', e => {
            e.stopPropagation();
            collapseTimer();
        });

        function expandTimer() {
            document.getElementById('timerPill').style.display = 'none';
            document.getElementById('timerExpanded').style.display = 'block';
        }

        function collapseTimer() {
            document.getElementById('timerExpanded').style.display = 'none';
            document.getElementById('timerPill').style.display = '';
        }

        // ── Rest timer ──
        function setRest(s) {
            if (isNaN(s) || s <= 0) return;
            resetRest(); restSeconds = s; restCurrent = s; updateRestDisplay();
        }

        function toggleRest() {
            if (restRunning) {
                clearInterval(restInterval); restRunning = false;
                document.getElementById('restStartBtn').textContent = 'Resume';
            } else {
                restRunning = true;
                document.getElementById('restStartBtn').textContent = 'Pause';
                restInterval = setInterval(() => {
                    restCurrent--;
                    updateRestDisplay();
                    if (restCurrent <= 0) {
                        clearInterval(restInterval); restRunning = false;
                        document.getElementById('restStartBtn').textContent = 'Start';
                        document.getElementById('restDisplay').style.color = '#dc3545';
                        setTimeout(() => {
                            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
                            resetRest();
                        }, 3000);
                    }
                }, 1000);
            }
        }

        function resetRest() {
            clearInterval(restInterval); restRunning = false; restCurrent = restSeconds;
            document.getElementById('restStartBtn').textContent = 'Start';
            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
            updateRestDisplay();
        }

        function updateRestDisplay() {
            const m = Math.floor(restCurrent/60), s = restCurrent%60;
            document.getElementById('restDisplay').textContent = m + ':' + (s < 10 ? '0' : '') + s;
        }

        function makeSavedSetRow(setNum, exerciseName, reps, weight, entryId) {
            const row = document.createElement('div');
            row.className = 'set-row';
            row.dataset.saved = '1';
            row.dataset.entryId = String(entryId);
            row.innerHTML = `
                <span class="set-label">Set ${setNum}</span>
                <input type="number" placeholder="Reps" value="${reps}" style="width:75px;" />
                <input type="number" placeholder="lbs" value="${weight}" step="0.5" style="width:75px;" />
                <span class="text-muted small">lbs</span>
                <button type="button" onclick="removeSetRow(this,${sessionId})" style="background:none;border:none;color:#888;font-size:0.8rem;">&#x2715;</button>`;
            return row;
        }

        async function addExerciseFromAIAction(action) {
            const name = (action?.name || '').trim();
            if (!name) return null;
            const reps = parseInt(action?.reps, 10) || 0;
            const weight = parseFloat(action?.weight) || 0;
            const sets = Math.max(1, parseInt(action?.sets, 10) || 1);
            const meta = lookupExerciseMeta(name);
            const firstRes = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: meta.muscleGroup || 'General', reps, weight })
            });
            const firstData = await firstRes.json();
            if (!firstData.success) return null;
            insertBlock(firstData.entryId, name, reps, weight, meta.description || '', meta.tips || '');
            const setContainer = document.getElementById(`sets-${firstData.entryId}`);
            for (let i = 2; i <= sets; i++) {
                const extraRes = await fetch('/WorkoutEntries/AddActiveSet', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: meta.muscleGroup || 'General', reps, weight })
                });
                const extraData = await extraRes.json();
                if (!extraData.success) continue;
                const extraRow = makeSavedSetRow(i, name, reps, weight, extraData.entryId);
                bindSetRowPersistence(extraRow);
                setContainer.appendChild(extraRow);
            }
            resetRest();
            fetchAIRecommendation(name);
            return document.getElementById(`block-${firstData.entryId}`) || document.getElementById('addExerciseTrigger');
        }

        function insertBlock(entryId, name, reps, weight, desc, tips) {
            const mount = document.getElementById('exerciseBlocksMount');
            const block = document.createElement('div');
            block.className = 'exercise-block';
            block.id = 'block-' + entryId;
            block.setAttribute('data-exercise-name', name);
            const tipContent = isPendingExerciseName(name)
                ? 'Choose an exercise from the list (or Custom name…).'
                : (desc || tips)
                    ? ((desc ? 'How to perform:\n' + desc + '\n\n' : '') + (tips ? 'Form tips:\n' + tips : ''))
                    : 'No library tips for this exercise.';
            const tipHtml = escapeHtml(tipContent);
            const slotHtml = renderExerciseNameSlotHtml(entryId, name);
            block.innerHTML = `
                <div class="mb-2">
                    <div class="exercise-name-slot mb-2">${slotHtml}</div>
                    <div class="d-flex gap-2 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-ex-tip flex-grow-1" onclick="toggleTips(this)">Tips</button>
                        <button type="button" class="exercise-remove-btn" title="Remove exercise" onclick="deleteEntry(${entryId},this)">&#x2715;</button>
                    </div>
                </div>
                <div class="exercise-tip" id="tip-${entryId}" style="display:none;white-space:pre-line;">${tipHtml}</div>
                <div class="set-rows" id="sets-${entryId}">
                    <div class="set-row" data-entry-id="${entryId}" data-saved="1">
                        <span class="set-label">Set 1</span>
                        <input type="number" placeholder="Reps" value="${reps}" style="width:75px;" />
                        <input type="number" placeholder="lbs" value="${weight}" step="0.5" style="width:75px;" />
                        <span class="text-muted small">lbs</span>
                    </div>
                </div>
                <div class="action-divider mt-2" onclick="addSetRowFromDivider(this)"><span>+ Add Set</span></div>`;
            mount.appendChild(block);
            block.querySelectorAll('.set-row').forEach(bindSetRowPersistence);
        }

        function toggleTips(btn) {
            const tip = btn.closest('.exercise-block').querySelector('.exercise-tip');
            if (!tip) return;
            const vis = tip.style.display !== 'none';
            tip.style.display = vis ? 'none' : 'block';
            btn.textContent = vis ? 'Tips' : 'Hide';
        }

        async function addSetRowFromDivider(div) {
            const block = div.closest('.exercise-block');
            const sel = block?.querySelector('.exercise-name-select');
            const exerciseName = sel?.value;
            if (!exerciseName || isPendingExerciseName(exerciseName) || exerciseName === CUSTOM_EXERCISE_VALUE) {
                alert('Choose an exercise first.');
                return;
            }
            const container = block?.querySelector('.set-rows');
            if (!container) return;
            const sets = container.querySelectorAll('.set-row');
            const setNum = sets.length + 1;
            const lastInputs = sets[sets.length - 1]?.querySelectorAll('input');
            const row = document.createElement('div');
            row.className = 'set-row';
            row.innerHTML = `
                <span class="set-label">Set ${setNum}</span>
                <input type="number" placeholder="Reps" value="${lastInputs?.[0]?.value||''}" style="width:75px;" />
                <input type="number" placeholder="lbs" value="${lastInputs?.[1]?.value||''}" step="0.5" style="width:75px;" />
                <span class="text-muted small">lbs</span>
                <button type="button" onclick="removeSetRow(this,${sessionId})" style="background:none;border:none;color:#888;font-size:0.8rem;">&#x2715;</button>`;
            bindSetRowPersistence(row);
            container.appendChild(row);
        }

        async function saveNewSet(row, sid) {
            const block = row.closest('.exercise-block');
            const sel = block?.querySelector('.exercise-name-select');
            const exerciseName = sel?.value;
            if (!exerciseName || isPendingExerciseName(exerciseName) || exerciseName === CUSTOM_EXERCISE_VALUE) return;
            const inputs = row.querySelectorAll('input');
            const reps = parseInt(inputs[0].value), weight = parseFloat(inputs[1].value) || 0;
            if (!reps || row.dataset.saved) return;
            const mg = lookupExerciseMeta(exerciseName).muscleGroup || 'General';
            const res = await fetch('/WorkoutEntries/AddActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ sessionId: sid, exerciseName, muscleGroup: mg, reps, weight }) });
            const data = await res.json();
            if (data.success) { row.dataset.saved = '1'; row.dataset.entryId = data.entryId; }
        }

        async function updateActiveEntryValues(row) {
            const entryId = row.dataset?.entryId;
            if (!entryId) return;
            const inputs = row.querySelectorAll('input');
            const reps = parseInt(inputs[0]?.value, 10);
            const weight = parseFloat(inputs[1]?.value) || 0;
            if (!reps) return;
            await fetch('/WorkoutEntries/UpdateActiveEntryValues', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ entryId: parseInt(entryId, 10), reps, weight })
            });
        }

        function bindSetRowPersistence(row) {
            row.querySelectorAll('input').forEach(inp => {
                inp.addEventListener('blur', () => {
                    if (row.dataset.entryId) void updateActiveEntryValues(row);
                    else void saveNewSet(row, sessionId);
                });
            });
        }

        async function syncAllActiveEntriesBeforeEnd() {
            const rows = document.querySelectorAll('#exerciseBlocksMount .set-row[data-entry-id]');
            for (const row of rows) {
                await updateActiveEntryValues(row);
            }
        }

        async function removeSetRow(btn, sid) {
            const row = btn.closest('.set-row');
            const entryId = row.dataset?.entryId;
            if (entryId) await fetch('/WorkoutEntries/DeleteActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ entryId: parseInt(entryId) }) });
            row.remove();
        }

        async function deleteEntry(entryId, btn) {
            const res = await fetch('/WorkoutEntries/DeleteActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ entryId }) });
            const data = await res.json();
            if (data.success) document.getElementById('block-'+entryId)?.remove();
        }

        function shuffleInPlace(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        const muscleAliases = {
            chest: ['chest', 'pec'],
            back: ['back', 'lats', 'rhomb', 'trap '],
            shoulders: ['shoulder', 'delts', 'delt'],
            quads: ['quad', 'quadriceps'],
            hamstrings: ['hamstring'],
            glutes: ['glute'],
            biceps: ['bicep'],
            triceps: ['tricep'],
            calves: ['calf'],
            core: ['core', 'abs', 'ab', 'oblique']
        };

        function canonicalMuscle(m) {
            const val = (m || '').toLowerCase();
            for (const [k, arr] of Object.entries(muscleAliases)) {
                if (arr.some(t => val.includes(t))) return k;
            }
            return '';
        }

        function inferSessionFocusMode() {
            const raw = sessionName || '';
            const sn = raw.toLowerCase();
            const st = sn.trim();
            if (st === 'chest' || st === 'pec' || st === 'pecs') return 'chest';
            if (st === 'back' || st === 'pull') return 'back';
            if (st === 'legs' || st === 'leg') return 'legs';
            if (st === 'shoulders' || st === 'shoulder' || st === 'delts') return 'shoulders';
            if (st === 'arms') return 'arms';
            if (st === 'core' || st === 'abs') return 'core';
            try {
                if (/\bchest\b|\bpecs?\b/i.test(raw)) return 'chest';
                if (/\bshoulders?\b|\bdelts?\b/i.test(raw)) return 'shoulders';
                if (/\barms?\b|\bbiceps?\b|\btriceps?\b/i.test(raw)) return 'arms';
                if (/\blegs?\b|\bquad\b|\bglutes?\b|\bhamstrings?\b/i.test(raw)) return 'legs';
                if (/\bback\b|\blats?\b/i.test(raw)) return 'back';
                if (/\bpull\s*day\b/i.test(raw)) return 'back';
                if (/\bcore\b|\babs\b/i.test(raw)) return 'core';
                if (/\bcardio\b|\bhiit\b|\bconditioning\b/i.test(raw)) return 'cardio';
            } catch (_) {}
            const rules = [
                { mode: 'chest', keys: ['chest day', 'chest &', 'chest,', 'chest -', 'pec day', 'pec ', ' pec', 'upper chest', 'lower chest'] },
                { mode: 'back', keys: ['back day', 'back ', 'pull day', 'pull ', 'lat day', 'lat ', 'row day'] },
                { mode: 'legs', keys: ['leg day', 'leg ', 'legs', 'quad day', 'squat day', 'lower body', 'glute day', 'hamstring'] },
                { mode: 'shoulders', keys: ['shoulder day', 'shoulder ', 'delt day', ' delt', 'ohp', 'overhead'] },
                { mode: 'arms', keys: ['arm day', 'arms', 'bicep', 'tricep', 'bi/tri', 'bis and tris'] },
                { mode: 'core', keys: ['core day', 'core ', 'ab day', 'abs day', ' ab '] },
                { mode: 'cardio', keys: ['cardio', 'hiit', 'conditioning', 'endurance'] }
            ];
            for (const { mode, keys } of rules) {
                if (keys.some(k => sn.includes(k))) return mode;
            }
            return '';
        }

        function voteFocusModeFromLogged(loggedNames) {
            const counts = {};
            for (const raw of loggedNames) {
                const n = (raw || '').trim();
                if (!n || n === CUSTOM_EXERCISE_VALUE || isPendingExerciseName(n)) continue;
                const mg = lookupExerciseMeta(n).muscleGroup || '';
                let c = canonicalMuscle(mg);
                if (['quads', 'hamstrings', 'glutes', 'calves'].includes(c)) c = 'legs';
                if (c) counts[c] = (counts[c] || 0) + 1;
            }
            const top = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];
            return top ? top[0] : '';
        }

        function exerciseMatchesFocusMode(ex, mode) {
            if (!mode || mode === 'cardio') return true;
            const c = canonicalMuscle(ex.muscleGroup || '');
            if (mode === 'legs') return ['quads', 'hamstrings', 'glutes', 'calves'].includes(c);
            if (mode === 'arms') return c === 'biceps' || c === 'triceps';
            return c === mode;
        }

        function focusModeLabel(mode) {
            const map = { chest: 'chest / pectorals', back: 'back (lats, mid-back, traps as applicable)', legs: 'legs (quads, hamstrings, glutes, calves)', shoulders: 'shoulders / deltoids', arms: 'arms (biceps and/or triceps)', core: 'core / trunk', cardio: 'conditioning' };
            return map[mode] || mode || 'balanced';
        }

        function buildReasonFallback(ex, focusMode) {
            const mg = ex.muscleGroup || '';
            if (focusMode === 'chest') return `Hits ${mg || 'chest'} pressing or fly work.`;
            if (focusMode === 'back') return `Pulling pattern for ${mg || 'back'}.`;
            if (focusMode === 'legs') return `Lower-body emphasis through ${mg || 'legs'}.`;
            if (focusMode === 'shoulders') return `Shoulder-focused (${mg || 'delts'}).`;
            if (focusMode === 'arms') return `Arm isolation for ${mg || 'biceps/triceps'}.`;
            if (focusMode === 'core') return `Trunk / core work via ${mg || 'core'}.`;
            return `Primary stimulus: ${mg || canonicalMuscle(mg) || 'target muscle'}.`;
        }

        function hideAIRecCardFully() {
            const card = document.getElementById('aiRecCard');
            const body = document.getElementById('aiRecSuggestionBody');
            const empty = document.getElementById('aiRecEmpty');
            card.style.display = 'none';
            body.style.display = 'none';
            empty.style.display = 'none';
            empty.textContent = '';
            pendingAIRec = null;
        }

        function showAIRecEmptyMessage(message) {
            pendingAIRec = null;
            const card = document.getElementById('aiRecCard');
            const body = document.getElementById('aiRecSuggestionBody');
            const empty = document.getElementById('aiRecEmpty');
            body.style.display = 'none';
            empty.textContent = message;
            empty.style.display = 'block';
            card.style.display = 'block';
        }

        function showAIRecSuggestionUI() {
            const card = document.getElementById('aiRecCard');
            const body = document.getElementById('aiRecSuggestionBody');
            const empty = document.getElementById('aiRecEmpty');
            empty.style.display = 'none';
            empty.textContent = '';
            body.style.display = 'block';
            card.style.display = 'block';
        }

        async function fetchAIRecommendation(lastExercise) {
            try {
                const logged = Array.from(document.querySelectorAll('#exerciseBlocksMount .exercise-block'))
                    .map(b => b.querySelector('.exercise-name-select')?.value?.trim())
                    .filter(n => n && !isPendingExerciseName(n) && n !== CUSTOM_EXERCISE_VALUE);
                const fromServer = Array.isArray(musclesHitTodayServer) ? musclesHitTodayServer : [];
                const loggedSet = new Set(logged.map(v => (v || '').trim().toLowerCase()));
                const hitsNormalized = [...new Set(fromServer.map(m => (m || '').trim().toLowerCase()).filter(Boolean))];
                const lastLower = (lastExercise || '').trim().toLowerCase();
                const pendingLower = (pendingAIRec?.name || '').trim().toLowerCase();
                const recentSet = new Set(recentAISuggestionKeys);
                const hitCanon = new Set(hitsNormalized.map(canonicalMuscle).filter(Boolean));

                const buildPool = (excludeRecent) => {
                    let pool = (Array.isArray(exerciseLibrary) ? exerciseLibrary : []).filter(ex => {
                        const n = (ex.name || '').trim().toLowerCase();
                        if (!n || loggedSet.has(n)) return false;
                        if (lastLower && n === lastLower) return false;
                        if (pendingLower && n === pendingLower) return false;
                        return true;
                    });
                    if (excludeRecent && pool.length > 1) {
                        const narrowed = pool.filter(ex => !recentSet.has((ex.name || '').trim().toLowerCase()));
                        if (narrowed.length) pool = narrowed;
                    }
                    return pool;
                };

                let basePool = buildPool(true);
                if (!basePool.length) basePool = buildPool(false);
                if (!basePool.length) { showAIRecEmptyMessage('No more suggestions — every exercise in your library is already in this workout.'); return; }

                const focusMode = inferSessionFocusMode() || voteFocusModeFromLogged(logged);
                const strictFocus = !!(focusMode && focusMode !== 'cardio');
                let focusPool = focusMode ? basePool.filter(ex => exerciseMatchesFocusMode(ex, focusMode)) : basePool;

                if (strictFocus && !focusPool.length) { showAIRecEmptyMessage('No more suggestions for this workout focus — everything that matches is already logged.'); return; }

                let preferred = focusPool.filter(ex => !hitCanon.has(canonicalMuscle(ex.muscleGroup || '')));
                if (!preferred.length) preferred = focusPool;

                let options = preferred.slice(0, 48);
                if (!options.length) options = focusPool.slice(0, 48);
                shuffleInPlace(options);
                const optionNames = options.map(o => o.name).filter(Boolean);
                if (!optionNames.length) { showAIRecEmptyMessage('No more suggestions right now.'); return; }

                const focusLabel = focusModeLabel(focusMode);
                let chosen = options[0];
                let reasonText = buildReasonFallback(chosen, focusMode);
                let aiPicked = false;

                try {
                    const strict = strictFocus
                        ? `STRICT: This workout's focus is **${focusLabel}**. ONLY pick an exercise whose PRIMARY muscle group matches that focus. Your Reason must describe the PRIMARY muscles worked.`
                        : `Pick a sensible next exercise. Reason must match the lift's PRIMARY muscles.`;
                    const res = await fetch('/AICoach/Chat', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            message: `${strict} Session name: "${sessionName || 'Workout'}". Already logged: ${logged.join(', ') || 'none'}. Muscles trained earlier today: ${fromServer.join(', ') || 'none'}. Allowed exercises (choose EXACTLY one): ${optionNames.join(', ')}. Reply ONLY as: Name: [exact name from list] | Reason: [one accurate sentence] | Muscle: [primary muscle group]`,
                            history: []
                        })
                    });
                    if (!res.ok) throw new Error('Chat HTTP ' + res.status);
                    const data = await res.json();
                    const text = typeof data?.response === 'string' ? data.response.trim() : '';
                    const nameMatch = text.match(/Name:\s*([^|]+)/i);
                    const reasonMatch = text.match(/Reason:\s*([^|]+)/i);
                    const aiNameLower = (nameMatch?.[1] || '').replace(/\*+/g, '').replace(/[`"'[\]]/g, '').trim().replace(/^the\s+/i, '').replace(/\.+$/g, '').trim().toLowerCase();
                    let fromAi = options.find(o => (o.name || '').toLowerCase() === aiNameLower);
                    if (fromAi && strictFocus && !exerciseMatchesFocusMode(fromAi, focusMode)) fromAi = null;
                    if (fromAi) {
                        chosen = fromAi;
                        const r = reasonMatch?.[1]?.trim();
                        reasonText = r && r.length > 12 ? r : buildReasonFallback(chosen, focusMode);
                        aiPicked = true;
                    }
                } catch (_) {}

                if (strictFocus && !aiPicked) { showAIRecEmptyMessage('No AI suggestion available — try again in a moment or pick manually.'); return; }

                const lastSuggested = recentAISuggestionKeys.length ? recentAISuggestionKeys[recentAISuggestionKeys.length - 1] : '';
                if (options.length > 1 && lastSuggested && (chosen.name || '').trim().toLowerCase() === lastSuggested) {
                    const alt = options.find(o => (o.name || '').trim().toLowerCase() !== lastSuggested);
                    if (alt) chosen = alt;
                }

                if (strictFocus && !exerciseMatchesFocusMode(chosen, focusMode)) { showAIRecEmptyMessage('No more suggestions matching this workout focus. Choose your next exercise manually.'); return; }

                recentAISuggestionKeys.push((chosen.name || '').trim().toLowerCase());
                if (recentAISuggestionKeys.length > 12) recentAISuggestionKeys.shift();

                pendingAIRec = { name: chosen.name, reason: reasonText };
                document.getElementById('aiRecName').textContent = pendingAIRec.name;
                document.getElementById('aiRecReason').textContent = pendingAIRec.reason;
                showAIRecSuggestionUI();
            } catch (e) { hideAIRecCardFully(); }
        }

        function dismissAIRecCard() { hideAIRecCardFully(); }

        async function acceptAIRec() {
            if (!pendingAIRec) return;
            const name = pendingAIRec.name;
            const meta = lookupExerciseMeta(name);
            const res = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: meta.muscleGroup || 'General', reps: 10, weight: 0 })
            });
            const data = await res.json();
            if (!data.success) { alert('Failed to add exercise.'); return; }
            insertBlock(data.entryId, name, 10, 0, meta.description || '', meta.tips || '');
            dismissAIRecCard();
            resetRest();
            fetchAIRecommendation(name);
        }

        function toggleAIChat() { new bootstrap.Modal(document.getElementById('aiModal')).show(); }

        async function sendAI() {
            const input = document.getElementById('aiInput');
            const message = input.value.trim();
            if (!message) return;
            input.value = '';
            const c = document.getElementById('aiMessages');
            const ud = document.createElement('div'); ud.className = 'chat-bubble-user'; ud.textContent = message; c.appendChild(ud); c.scrollTop = c.scrollHeight;
            const btn = document.getElementById('aiSendBtn'); btn.disabled = true; btn.textContent = '...';
            try {
                const res = await fetch('/AICoach/Chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message, history: aiHistory }) });
                const data = await res.json();
                aiHistory.push({ role:'user', content:message });
                aiHistory.push({ role:'assistant', content:data.response });
                const parsed = window.fitlogAI
                    ? window.fitlogAI.parseActionEnvelope(data.response)
                    : { displayText: data.response.replace(/```json[\s\S]*?```/g,'').trim(), envelope: null };
                if (window.fitlogAI) {
                    window.fitlogAI.appendAiMessage(c, parsed.displayText.replace(/```json[\s\S]*?```/g,''), parsed.envelope);
                } else {
                    const ad = document.createElement('div'); ad.className = 'chat-bubble-ai'; ad.textContent = parsed.displayText.replace(/```json[\s\S]*?```/g,'').trim(); c.appendChild(ad); c.scrollTop = c.scrollHeight;
                }
            } catch { const ed = document.createElement('div'); ed.className = 'chat-bubble-ai'; ed.textContent = 'Sorry, something went wrong.'; c.appendChild(ed); }
            btn.disabled = false; btn.textContent = 'Send';
        }

        function showEndModal() {
            const now = new Date(); now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('finalDate').value = now.toISOString().slice(0, 16);
            new bootstrap.Modal(document.getElementById('endModal')).show();
        }

        async function endWorkout() {
            const name = document.getElementById('finalName').value.trim();
            const dateVal = document.getElementById('finalDate').value;
            const notes = document.getElementById('finalNotes').value.trim();
            if (!name || !dateVal) { alert('Please fill in all required fields.'); return; }
            await syncAllActiveEntriesBeforeEnd();
            bootstrap.Modal.getInstance(document.getElementById('endModal')).hide();
            new bootstrap.Modal(document.getElementById('summaryModal')).show();
            const res = await fetch('/WorkoutEntries/EndWorkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ sessionId, sessionName:name, sessionDate:new Date(dateVal).toISOString(), notes }) });
            const data = await res.json();
            document.getElementById('summaryLoading').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';
            document.getElementById('summaryContent').textContent = data.summary;
            document.getElementById('viewWorkoutBtn').href = '/WorkoutEntries/SessionDetail/' + sessionId;
        }

        document.addEventListener('DOMContentLoaded', function() {
            window.fitlogAiHandlers = window.fitlogAiHandlers || {};
            window.fitlogAiHandlers.addExercise = addExerciseFromAIAction;
            document.querySelectorAll('#exerciseBlocksMount .set-row').forEach(bindSetRowPersistence);
            fetchAIRecommendation('');
        });
    </script>
</body>
</html>