@model FitLog.Models.WorkoutSession
@{
    ViewData["Title"] = "Active Workout";
    Layout = null;
    var exerciseList = ViewBag.ExerciseList as List<FitLog.Models.Exercise> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>@Model.SessionName - FitLog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/slate/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #1c1e22;
        }

        .sticky-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #1c1e22;
            border-bottom: 1px solid #32383e;
            padding: 10px 16px;
        }

        .exercise-block {
            background: #272b30;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #32383e;
        }

        .set-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

            .set-row input {
                background: #1c1e22;
                border: 1px solid #32383e;
                color: #e0e0e0;
                border-radius: 6px;
                padding: 8px;
                text-align: center;
                font-size: 1rem;
                width: 75px;
            }

                .set-row input:focus {
                    outline: none;
                    border-color: var(--fitlog-green);
                }

        .set-label {
            color: #888;
            font-size: 0.8rem;
            min-width: 40px;
        }

        .action-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 8px 0;
            color: var(--fitlog-green,#28a745);
            font-size: 0.85rem;
            cursor: pointer;
        }

            .action-divider::before, .action-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #32383e;
            }

            .action-divider:hover span {
                text-decoration: underline;
            }

        .exercise-tip {
            background: #1c1e22;
            border-left: 3px solid var(--fitlog-green,#28a745);
            padding: 8px 12px;
            border-radius: 0 6px 6px 0;
            margin-top: 8px;
            font-size: 0.8rem;
            color: #adb5bd;
            white-space: pre-line;
            display: none;
        }

        .add-exercise-panel {
            background: #272b30;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid #32383e;
            display: none;
        }

            .add-exercise-panel.open {
                display: block;
            }

        .timer-dock {
            position: fixed;
            z-index: 500;
            transform: translateY(-50%);
            display: flex;
            align-items: flex-start;
            gap: 6px;
            user-select: none;
        }

        .timer-dock-right {
            right: 0;
            left: auto;
            flex-direction: row-reverse;
        }

        .timer-dock-left {
            left: 0;
            right: auto;
            flex-direction: row;
        }

        .timer-flip-btn {
            background: #1c1e22;
            border: 1px solid #32383e;
            color: #adb5bd;
            border-radius: 8px;
            padding: 6px 8px;
            font-size: 0.75rem;
            cursor: pointer;
            margin-top: 6px;
            flex-shrink: 0;
        }

        .timer-dock-stack {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: stretch;
        }

        .timer-pill {
            background: #1f3a1f;
            border: 2px solid var(--fitlog-green,#28a745);
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--fitlog-green);
            white-space: nowrap;
            cursor: grab;
            touch-action: none;
            box-shadow: 0 2px 10px rgba(40,167,69,0.2);
        }

        .timer-pill:active {
            cursor: grabbing;
        }

        .timer-dropdown {
            background: #1f3a1f;
            border: 2px solid var(--fitlog-green,#28a745);
            border-radius: 12px;
            padding: 10px 12px;
            min-width: 188px;
            box-shadow: 0 4px 15px rgba(40,167,69,0.3);
        }

        .floating-ai-btn {
            position: fixed;
            bottom: 20px;
            right: 16px;
            z-index: 200;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--fitlog-green,#28a745);
            border: none;
            color: white;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(40,167,69,0.4);
        }

        .ai-rec-card {
            background: #272b30;
            border: 1px solid var(--fitlog-green);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>
    <div class="sticky-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0" style="color:var(--fitlog-green);">@Model.SessionName</h5>
            <button class="btn btn-danger btn-sm" onclick="showEndModal()">End Workout</button>
        </div>
    </div>

    <div class="container" style="max-width:600px; padding-bottom:120px; padding-top:16px;">
        <div id="exerciseList">
            @foreach (var entry in Model.Entries)
            {
                var tip = exerciseList.FirstOrDefault(e => e.Name == entry.ExerciseName);
                <div class="exercise-block" id="block-@entry.Id">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold">@entry.ExerciseName</span>
                        <div class="d-flex gap-2 align-items-center">
                            @if (tip != null)
                            {
                                <button class="btn btn-sm btn-outline-secondary" style="font-size:0.7rem;padding:2px 8px;" onclick="toggleTips(this)">Tips</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" style="font-size:0.7rem;padding:2px 8px;" onclick="deleteEntry(@entry.Id, this)">&#x2715;</button>
                        </div>
                    </div>
                    @if (tip != null)
                    {
                        <div class="exercise-tip" id="tip-@entry.Id">@(tip.Description != null ? "How to perform:\n" + tip.Description + "\n\n" : "")@(tip.Tips != null ? "Form tips:\n" + tip.Tips : "")</div>
                    }
                    <div class="set-rows" id="sets-@entry.Id">
                        <div class="set-row">
                            <span class="set-label">Set 1</span>
                            <input type="number" placeholder="Reps" value="@entry.Reps" />
                            <input type="number" placeholder="lbs" step="0.5" value="@entry.WeightLbs" />
                            <span class="text-muted small">lbs</span>
                        </div>
                    </div>
                    <div class="action-divider mt-2" onclick="addSetRow('@entry.ExerciseName', 'sets-@entry.Id', @entry.SessionId)">
                        <span>+ Add Set</span>
                    </div>
                </div>
            }
        </div>

        <div class="action-divider" id="addExerciseTrigger" onclick="toggleAddExercise()">
            <span>+ Add Exercise</span>
        </div>

        <div class="add-exercise-panel" id="addExercisePanel">
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-sm btn-success" id="chooseBtn" onclick="showChoose()">Choose</button>
                <button class="btn btn-sm btn-outline-secondary" id="typeBtn" onclick="showType()">Type Name</button>
            </div>
            <div id="chooseSection">
                <select id="chooseExercise" class="form-select mb-2" style="background:#1c1e22;border-color:#32383e;color:#e0e0e0;" onchange="selectFromLibrary()">
                    <option value="">— Select an exercise —</option>
                    @foreach (var ex in exerciseList.OrderBy(e => e.MuscleGroup).ThenBy(e => e.Name))
                    {
                        <option value="@ex.Name" data-muscle="@ex.MuscleGroup" data-tips="@ex.Tips" data-description="@ex.Description">@ex.MuscleGroup — @ex.Name</option>
                    }
                </select>
            </div>
            <div id="typeSection" style="display:none;">
                <input type="text" id="customExerciseName" class="form-control mb-2" placeholder="Exercise name" style="background:#1c1e22;border-color:#32383e;color:#e0e0e0;" oninput="previewCustomTips()" />
            </div>
            <div id="exerciseTipPreview" class="exercise-tip mb-2" style="display:none;"></div>
            <div class="set-row mb-3">
                <span class="set-label">Set 1</span>
                <input type="number" id="newReps" placeholder="Reps" />
                <input type="number" id="newWeight" placeholder="lbs" step="0.5" />
                <span class="text-muted small">lbs</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="closeAddExercisePanel()">Cancel</button>
            </div>
        </div>

        <div id="aiRecCard" class="ai-rec-card" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold" style="color:var(--fitlog-green);">AI Recommends</span>
                <button type="button" onclick="document.getElementById('aiRecCard').style.display='none'" style="background:none;border:none;color:#888;font-size:0.8rem;">Dismiss</button>
            </div>
            <p id="aiRecName" class="fw-bold mb-1"></p>
            <p id="aiRecReason" class="text-muted small mb-2"></p>
            <button type="button" class="btn btn-success btn-sm" onclick="acceptAIRec()">Add This Exercise</button>
        </div>
    </div>

    <div id="timerDock" class="timer-dock timer-dock-right" style="top:38%;">
        <button type="button" id="timerFlipBtn" class="timer-flip-btn" title="Switch side">⇄</button>
        <div class="timer-dock-stack">
            <div class="timer-pill" id="timerPill">
                &#9203; <span id="restDisplayMini">1:30</span> <span style="opacity:.65;font-size:0.7rem;">▼</span>
            </div>
            <div class="timer-dropdown" id="timerExpanded" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Rest Timer</span>
                <button type="button" id="collapseBtn" style="background:none;border:none;color:#888;font-size:0.85rem;">&#x2715;</button>
            </div>
            <div class="text-center mb-2">
                <span id="restDisplay" style="color:var(--fitlog-green);font-size:1.8rem;font-weight:700;">1:30</span>
            </div>
            <div class="d-flex flex-wrap gap-1 mb-2 justify-content-center">
                <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(60)">1:00</button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(90)">1:30</button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(120)">2:00</button>
                <button class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.7rem;" onclick="setRest(180)">3:00</button>
            </div>
            <input type="number" id="customRest" class="form-control form-control-sm mb-2" style="background:#1c1e22;border-color:#32383e;color:#e0e0e0;font-size:0.75rem;" placeholder="Custom (sec)" onchange="setRest(parseInt(this.value))" />
            <div class="d-flex gap-2">
                <button id="restStartBtn" class="btn btn-success btn-sm flex-grow-1" onclick="toggleRest()">Start</button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetRest()">Reset</button>
            </div>
            </div>
        </div>
    </div>

    <button class="floating-ai-btn" onclick="toggleAIChat()" title="AI Coach">AI</button>

    <div class="modal fade" id="aiModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" style="color:var(--fitlog-green);">AI Coach</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="aiMessages" style="height:300px;overflow-y:auto;padding:16px;background:#1f1f38;">
                        <div class="chat-bubble-ai">Hey! Ask me about your workout or what to do next.</div>
                    </div>
                    <div class="p-3 d-flex gap-2">
                        <input type="text" id="aiInput" class="form-control form-control-sm" placeholder="Ask your coach..." onkeypress="if(event.key==='Enter') sendAI()" />
                        <button class="btn btn-success btn-sm px-3" onclick="sendAI()" id="aiSendBtn">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="endModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Finish Workout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Workout Name</label><input type="text" id="finalName" class="form-control" value="@Model.SessionName" required /></div>
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Date</label><input type="datetime-local" id="finalDate" class="form-control" required /></div>
                    <div class="form-group mb-3"><label class="fw-bold mb-1">Notes <span class="text-muted small">(optional)</span></label><textarea id="finalNotes" class="form-control" rows="2" placeholder="How did it go?"></textarea></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" onclick="endWorkout()">Finish & Get AI Summary</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="summaryModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="background:#272b30;">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color:var(--fitlog-green);">Workout Summary</h5>
                </div>
                <div class="modal-body">
                    <div id="summaryLoading" class="text-center py-3"><div class="spinner-border text-success" role="status"></div><p class="text-muted mt-2">Analyzing your workout...</p></div>
                    <div id="summaryContent" style="display:none;white-space:pre-wrap;line-height:1.9;color:#e0e0e0;font-size:0.95rem;"></div>
                </div>
                <div class="modal-footer d-flex gap-2">
                    <a href="/Dashboard" class="btn btn-outline-secondary flex-grow-1 text-center">Back to Dashboard</a>
                    <a id="viewWorkoutBtn" href="#" class="btn btn-success flex-grow-1 text-center">View Full Workout</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sessionId = @Model.Id;
        const musclesHitTodayServer = @Html.Raw(ViewBag.MusclesHitTodayJson ?? "[]");
        const exerciseLibrary = @Html.Raw(ViewBag.ExerciseLibraryJson ?? "[]");
        let restSeconds = 90, restCurrent = 90, restRunning = false, restInterval = null;
        let aiHistory = [], addExOpen = false;
        let pendingAIRec = null;

        function escapeHtml(s) {
            if (s == null) return '';
            const d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        function lookupExerciseMeta(name) {
            const n = (name || '').trim().toLowerCase();
            if (!Array.isArray(exerciseLibrary)) return { muscleGroup: 'General', description: '', tips: '' };
            const ex = exerciseLibrary.find(e => (e.name || '').toLowerCase() === n);
            if (!ex) return { muscleGroup: 'General', description: '', tips: '' };
            return {
                muscleGroup: ex.muscleGroup || 'General',
                description: ex.description || '',
                tips: ex.tips || ''
            };
        }

        // ── Rest timer dock (left/right edge only, vertical drag) ──
        const timerDock = document.getElementById('timerDock');
        const timerPill = document.getElementById('timerPill');
        let dockDragging = false, dockStartY = 0, dockStartPct = 38, dockMoved = false;

        function parseDockTopPct() {
            const t = timerDock.style.top || '';
            if (t.endsWith('%')) return parseFloat(t);
            return 38;
        }

        function moveDockByClientY(clientY) {
            const dy = clientY - dockStartY;
            const dPct = (dy / window.innerHeight) * 100;
            const next = Math.min(92, Math.max(8, dockStartPct + dPct));
            timerDock.style.top = next + '%';
        }

        timerPill.addEventListener('pointerdown', e => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            dockDragging = true;
            dockMoved = false;
            dockStartY = e.clientY;
            dockStartPct = parseDockTopPct();
            timerPill.setPointerCapture(e.pointerId);
        });
        timerPill.addEventListener('pointermove', e => {
            if (!dockDragging) return;
            const dy = Math.abs(e.clientY - dockStartY);
            if (dy > 6) dockMoved = true;
            if (dockMoved) moveDockByClientY(e.clientY);
        });
        timerPill.addEventListener('pointerup', e => {
            if (!dockDragging) return;
            dockDragging = false;
            try { timerPill.releasePointerCapture(e.pointerId); } catch (_) { }
            if (!dockMoved) expandTimer();
        });
        timerPill.addEventListener('pointercancel', e => { dockDragging = false; try { timerPill.releasePointerCapture(e.pointerId); } catch (_) { } });

        document.getElementById('timerFlipBtn').addEventListener('click', e => {
            e.stopPropagation();
            timerDock.classList.toggle('timer-dock-right');
            timerDock.classList.toggle('timer-dock-left');
        });

        document.getElementById('collapseBtn').addEventListener('click', e => {
            e.stopPropagation();
            collapseTimer();
        });

        function expandTimer() {
            document.getElementById('timerPill').style.display = 'none';
            document.getElementById('timerExpanded').style.display = 'block';
        }

        function collapseTimer() {
            document.getElementById('timerExpanded').style.display = 'none';
            document.getElementById('timerPill').style.display = '';
        }

        // ── Rest timer ──
        function setRest(s) {
            if (isNaN(s) || s <= 0) return;
            resetRest(); restSeconds = s; restCurrent = s; updateRestDisplay();
        }

        function toggleRest() {
            if (restRunning) {
                clearInterval(restInterval); restRunning = false;
                document.getElementById('restStartBtn').textContent = 'Resume';
            } else {
                restRunning = true;
                document.getElementById('restStartBtn').textContent = 'Pause';
                restInterval = setInterval(() => {
                    restCurrent--;
                    updateRestDisplay();
                    if (restCurrent <= 0) {
                        clearInterval(restInterval); restRunning = false;
                        document.getElementById('restStartBtn').textContent = 'Start';
                        document.getElementById('restDisplay').style.color = '#dc3545';
                        setTimeout(() => {
                            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
                            resetRest();
                        }, 3000);
                    }
                }, 1000);
            }
        }

        function resetRest() {
            clearInterval(restInterval); restRunning = false; restCurrent = restSeconds;
            document.getElementById('restStartBtn').textContent = 'Start';
            document.getElementById('restDisplay').style.color = 'var(--fitlog-green)';
            updateRestDisplay();
        }

        function updateRestDisplay() {
            const m = Math.floor(restCurrent/60), s = restCurrent%60;
            const t = m + ':' + (s < 10 ? '0' : '') + s;
            document.getElementById('restDisplay').textContent = t;
            document.getElementById('restDisplayMini').textContent = t;
        }

        // ── Add exercise panel (+ Add Exercise saves when open & valid; Cancel closes) ──
        function closeAddExercisePanel() {
            addExOpen = false;
            document.getElementById('addExercisePanel').classList.remove('open');
        }

        function toggleAddExercise() {
            const panel = document.getElementById('addExercisePanel');
            if (addExOpen) {
                const name = getExName();
                const reps = parseInt(document.getElementById('newReps').value);
                if (name && reps) { addExercise(); return; }
                closeAddExercisePanel();
                return;
            }
            addExOpen = true;
            panel.classList.add('open');
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function previewCustomTips() {
            if (document.getElementById('typeSection').style.display === 'none') return;
            const meta = lookupExerciseMeta(document.getElementById('customExerciseName').value);
            const tipEl = document.getElementById('exerciseTipPreview');
            const desc = meta.description || '', tips = meta.tips || '';
            if (desc || tips) {
                tipEl.textContent = (desc ? 'How to perform:\n' + desc + '\n\n' : '') + (tips ? 'Form tips:\n' + tips : '');
                tipEl.style.display = 'block';
            } else {
                tipEl.style.display = 'none';
            }
        }

        function showChoose() {
            document.getElementById('chooseSection').style.display = 'block';
            document.getElementById('typeSection').style.display = 'none';
            document.getElementById('chooseBtn').className = 'btn btn-sm btn-success';
            document.getElementById('typeBtn').className = 'btn btn-sm btn-outline-secondary';
        }

        function showType() {
            document.getElementById('chooseSection').style.display = 'none';
            document.getElementById('typeSection').style.display = 'block';
            document.getElementById('typeBtn').className = 'btn btn-sm btn-success';
            document.getElementById('chooseBtn').className = 'btn btn-sm btn-outline-secondary';
        }

        function selectFromLibrary() {
            const opt = document.getElementById('chooseExercise').options[document.getElementById('chooseExercise').selectedIndex];
            const desc = opt.dataset.description || '', tips = opt.dataset.tips || '';
            const tipEl = document.getElementById('exerciseTipPreview');
            if (desc || tips) {
                tipEl.textContent = (desc ? 'How to perform:\n'+desc+'\n\n' : '') + (tips ? 'Form tips:\n'+tips : '');
                tipEl.style.display = 'block';
            } else { tipEl.style.display = 'none'; }
        }

        function getExName() {
            return document.getElementById('chooseSection').style.display !== 'none'
                ? document.getElementById('chooseExercise').value
                : document.getElementById('customExerciseName').value.trim();
        }

        function getMuscle() {
            if (document.getElementById('chooseSection').style.display !== 'none') {
                const opt = document.getElementById('chooseExercise').options[document.getElementById('chooseExercise').selectedIndex];
                return opt?.dataset?.muscle || 'General';
            }
            return lookupExerciseMeta(document.getElementById('customExerciseName').value).muscleGroup || 'General';
        }

        function getTipsData() {
            if (document.getElementById('chooseSection').style.display !== 'none') {
                const opt = document.getElementById('chooseExercise').options[document.getElementById('chooseExercise').selectedIndex];
                return { desc: opt?.dataset?.description || '', tips: opt?.dataset?.tips || '' };
            }
            const m = lookupExerciseMeta(document.getElementById('customExerciseName').value);
            return { desc: m.description || '', tips: m.tips || '' };
        }

        async function addExercise() {
            const name = getExName(), reps = parseInt(document.getElementById('newReps').value), weight = parseFloat(document.getElementById('newWeight').value) || 0;
            if (!name) { alert('Please select or enter an exercise.'); return; }
            if (!reps) { alert('Please enter reps for Set 1.'); return; }

            const res = await fetch('/WorkoutEntries/AddActiveSet', {
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: getMuscle(), reps, weight })
            });
            const data = await res.json();
            if (!data.success) { alert('Failed to save.'); return; }

            const { desc, tips } = getTipsData();
            insertBlock(data.entryId, name, reps, weight, desc, tips);

            document.getElementById('newReps').value = '';
            document.getElementById('newWeight').value = '';
            document.getElementById('chooseExercise').value = '';
            document.getElementById('customExerciseName').value = '';
            document.getElementById('exerciseTipPreview').style.display = 'none';
            closeAddExercisePanel();
            resetRest();
            fetchAIRecommendation(name);
        }

        function insertBlock(entryId, name, reps, weight, desc, tips) {
            const list = document.getElementById('exerciseList');
            const block = document.createElement('div');
            block.className = 'exercise-block';
            block.id = 'block-' + entryId;
            const hasTips = desc || tips;
            const tipContent = (desc ? 'How to perform:\n' + desc + '\n\n' : '') + (tips ? 'Form tips:\n' + tips : '');
            const nameEsc = escapeHtml(name);
            const tipHtml = escapeHtml(tipContent);
            const nameJson = JSON.stringify(name);
            block.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">${nameEsc}</span>
                    <div class="d-flex gap-2 align-items-center">
                        ${hasTips ? `<button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:0.7rem;padding:2px 8px;" onclick="toggleTips(this)">Tips</button>` : ''}
                        <button type="button" class="btn btn-sm btn-outline-danger" style="font-size:0.7rem;padding:2px 8px;" onclick="deleteEntry(${entryId},this)">&#x2715;</button>
                    </div>
                </div>
                ${hasTips ? `<div class="exercise-tip" id="tip-${entryId}" style="display:none;white-space:pre-line;">${tipHtml}</div>` : ''}
                <div class="set-rows" id="sets-${entryId}">
                    <div class="set-row">
                        <span class="set-label">Set 1</span>
                        <input type="number" placeholder="Reps" value="${reps}" style="width:75px;" />
                        <input type="number" placeholder="lbs" value="${weight}" step="0.5" style="width:75px;" />
                        <span class="text-muted small">lbs</span>
                    </div>
                </div>
                <div class="action-divider mt-2" onclick="addSetRow(${nameJson},'sets-${entryId}',${sessionId})"><span>+ Add Set</span></div>`;
            list.appendChild(block);
        }

        function toggleTips(btn) {
            const tip = btn.closest('.exercise-block').querySelector('.exercise-tip');
            if (!tip) return;
            const vis = tip.style.display !== 'none';
            tip.style.display = vis ? 'none' : 'block';
            btn.textContent = vis ? 'Tips' : 'Hide';
        }

        async function addSetRow(exerciseName, containerId, sid) {
            const container = document.getElementById(containerId);
            const sets = container.querySelectorAll('.set-row');
            const setNum = sets.length + 1;
            const lastInputs = sets[sets.length - 1]?.querySelectorAll('input');
            const row = document.createElement('div');
            row.className = 'set-row';
            const exJson = JSON.stringify(exerciseName);
            row.innerHTML = `
                <span class="set-label">Set ${setNum}</span>
                <input type="number" placeholder="Reps" value="${lastInputs?.[0]?.value||''}" style="width:75px;" />
                <input type="number" placeholder="lbs" value="${lastInputs?.[1]?.value||''}" step="0.5" style="width:75px;" />
                <span class="text-muted small">lbs</span>
                <button type="button" onclick="removeSetRow(this,${exJson},${sid})" style="background:none;border:none;color:#888;font-size:0.8rem;">&#x2715;</button>`;
            row.querySelectorAll('input').forEach(inp => inp.addEventListener('blur', () => saveNewSet(row, exerciseName, sid)));
            container.appendChild(row);
        }

        async function saveNewSet(row, exerciseName, sid) {
            const inputs = row.querySelectorAll('input');
            const reps = parseInt(inputs[0].value), weight = parseFloat(inputs[1].value) || 0;
            if (!reps || row.dataset.saved) return;
            const mg = lookupExerciseMeta(exerciseName).muscleGroup || 'General';
            const res = await fetch('/WorkoutEntries/AddActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ sessionId: sid, exerciseName, muscleGroup: mg, reps, weight }) });
            const data = await res.json();
            if (data.success) { row.dataset.saved = '1'; row.dataset.entryId = data.entryId; }
        }

        async function removeSetRow(btn, exerciseName, sid) {
            const row = btn.closest('.set-row');
            const entryId = row.dataset?.entryId;
            if (entryId) await fetch('/WorkoutEntries/DeleteActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ entryId: parseInt(entryId) }) });
            row.remove();
        }

        async function deleteEntry(entryId, btn) {
            const res = await fetch('/WorkoutEntries/DeleteActiveSet', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ entryId }) });
            const data = await res.json();
            if (data.success) document.getElementById('block-'+entryId)?.remove();
        }

        async function fetchAIRecommendation(lastExercise) {
            try {
                const logged = Array.from(document.querySelectorAll('.exercise-block')).map(b => b.querySelector('.fw-bold')?.textContent?.trim()).filter(Boolean);
                const fromServer = Array.isArray(musclesHitTodayServer) ? musclesHitTodayServer : [];
                const musclesHitList = [...new Set(fromServer.map(m => (m || '').trim()).filter(Boolean))].join(', ');
                const res = await fetch('/AICoach/Chat', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({
                        message: `Today I have already trained these muscle groups (from all workouts today): ${musclesHitList || 'none logged yet'}. Exercises in THIS session so far: ${logged.join(', ') || 'none'}. Recommend ONE exercise whose primary muscle is NOT already in the trained list. Prefer a muscle that is completely untrained today. Reply ONLY: Name: [exercise name] | Reason: [one sentence] | Muscle: [muscle group]`,
                        history: []
                    })
                });
                const data = await res.json();
                const text = data.response;
                const nameMatch = text.match(/Name:\s*([^|]+)/);
                const reasonMatch = text.match(/Reason:\s*([^|]+)/);
                if (nameMatch) {
                    pendingAIRec = { name: nameMatch[1].trim(), reason: reasonMatch?.[1]?.trim() || '' };
                    document.getElementById('aiRecName').textContent = pendingAIRec.name;
                    document.getElementById('aiRecReason').textContent = pendingAIRec.reason;
                    document.getElementById('aiRecCard').style.display = 'block';
                }
            } catch (e) {}
        }

        async function acceptAIRec() {
            if (!pendingAIRec) return;
            const name = pendingAIRec.name;
            const meta = lookupExerciseMeta(name);
            const reps = 10;
            const weight = 0;
            const res = await fetch('/WorkoutEntries/AddActiveSet', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, exerciseName: name, muscleGroup: meta.muscleGroup || 'General', reps, weight })
            });
            const data = await res.json();
            if (!data.success) { alert('Failed to add exercise.'); return; }
            insertBlock(data.entryId, name, reps, weight, meta.description || '', meta.tips || '');
            document.getElementById('aiRecCard').style.display = 'none';
            pendingAIRec = null;
            resetRest();
            fetchAIRecommendation(name);
        }

        function toggleAIChat() { new bootstrap.Modal(document.getElementById('aiModal')).show(); }

        async function sendAI() {
            const input = document.getElementById('aiInput');
            const message = input.value.trim();
            if (!message) return;
            input.value = '';
            const c = document.getElementById('aiMessages');
            const ud = document.createElement('div'); ud.className = 'chat-bubble-user'; ud.textContent = message; c.appendChild(ud); c.scrollTop = c.scrollHeight;
            const btn = document.getElementById('aiSendBtn'); btn.disabled = true; btn.textContent = '...';
            try {
                const res = await fetch('/AICoach/Chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message, history: aiHistory }) });
                const data = await res.json();
                aiHistory.push({ role:'user', content:message });
                aiHistory.push({ role:'assistant', content:data.response });
                const ad = document.createElement('div'); ad.className = 'chat-bubble-ai'; ad.textContent = data.response.replace(/```json[\s\S]*?```/g,'').trim(); c.appendChild(ad); c.scrollTop = c.scrollHeight;
            } catch { const ed = document.createElement('div'); ed.className = 'chat-bubble-ai'; ed.textContent = 'Sorry, something went wrong.'; c.appendChild(ed); }
            btn.disabled = false; btn.textContent = 'Send';
        }

        function showEndModal() {
            const now = new Date(); now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('finalDate').value = now.toISOString().slice(0, 16);
            new bootstrap.Modal(document.getElementById('endModal')).show();
        }

        async function endWorkout() {
            const name = document.getElementById('finalName').value.trim();
            const dateVal = document.getElementById('finalDate').value;
            const notes = document.getElementById('finalNotes').value.trim();
            if (!name || !dateVal) { alert('Please fill in all required fields.'); return; }
            bootstrap.Modal.getInstance(document.getElementById('endModal')).hide();
            new bootstrap.Modal(document.getElementById('summaryModal')).show();
            const res = await fetch('/WorkoutEntries/EndWorkout', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ sessionId, sessionName:name, sessionDate:new Date(dateVal).toISOString(), notes }) });
            const data = await res.json();
            document.getElementById('summaryLoading').style.display = 'none';
            document.getElementById('summaryContent').style.display = 'block';
            document.getElementById('summaryContent').textContent = data.summary;
            document.getElementById('viewWorkoutBtn').href = '/WorkoutEntries/SessionDetail/' + sessionId;
        }

        document.addEventListener('DOMContentLoaded', function() { fetchAIRecommendation(''); });
    </script>
</body>
</html>