@model FitLog.Models.WorkoutSession
@{
    ViewData["Title"] = @Model.SessionName;
}

<div class="mb-3">
    <a asp-action="Index" class="text-muted" style="font-size: 0.9rem;">Back to My Workouts</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@Model.SessionName</h2>
        <p class="text-muted mb-0">@Model.SessionDate.ToString("MMMM d, yyyy")</p>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p class="text-muted small mt-1">@Model.Notes</p>
        }
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-secondary">@Model.Entries.Count exercises</span>
        <span class="badge bg-dark">@String.Format("{0:N0}", Model.Entries.Sum(e => e.Sets * e.Reps * e.WeightLbs)) lbs volume</span>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card p-4 mb-4">
            <h5 class="fw-bold mb-3">Add Exercise</h5>
            <form asp-action="AddExerciseToSession">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SessionId" value="@Model.Id" />
                <div class="form-group mb-3">
                    <label class="control-label">Choose from Library</label>
                    <select id="exerciseSelect" class="form-select" onchange="updateFromExercise()"
                            style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                        <option value="">— Select an exercise —</option>
                        @foreach (var ex in ViewBag.Exercises)
                        {
                            <option value="@ex.Name" data-muscle="@ex.MuscleGroup">
                                @ex.MuscleGroup — @ex.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label class="control-label">Exercise Name</label>
                    <input name="ExerciseName" id="ExerciseName" class="form-control"
                           placeholder="Or type custom exercise" required />
                </div>
                <div class="form-group mb-3">
                    <label class="control-label">Muscle Group</label>
                    <select name="MuscleGroup" id="muscleGroupSelect" class="form-select"
                            style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;" required>
                        <option value="">— Select muscle group —</option>
                        <option>Chest</option>
                        <option>Back</option>
                        <option>Shoulders</option>
                        <option>Biceps</option>
                        <option>Triceps</option>
                        <option>Legs</option>
                        <option>Core</option>
                        <option>Cardio</option>
                        <option>Full Body</option>
                    </select>
                </div>
                <input type="hidden" name="WorkoutDate" value="@Model.SessionDate.ToString("yyyy-MM-dd")" />
                <div class="row mb-3">
                    <div class="col-4">
                        <label class="control-label">Sets</label>
                        <input name="Sets" type="number" class="form-control" placeholder="3" required />
                    </div>
                    <div class="col-4">
                        <label class="control-label">Reps</label>
                        <input name="Reps" type="number" class="form-control" placeholder="10" required />
                    </div>
                    <div class="col-4">
                        <label class="control-label">Weight</label>
                        <input name="WeightLbs" type="number" step="0.5" class="form-control" placeholder="135" required />
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label class="control-label">Notes</label>
                    <input name="Notes" class="form-control" placeholder="Optional..." />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="IsCompleted" value="true" />
                    <label class="form-check-label">Mark as Completed</label>
                </div>
                <button type="submit" class="btn btn-success w-100">Add Exercise</button>
            </form>
        </div>

        <!-- AI Recommendation -->
        <div class="card p-4" id="aiRecCard">
            <h6 class="fw-bold mb-2" style="color: var(--fitlog-green);">AI Recommended Next Exercise</h6>
            <div id="aiRecLoading" class="text-center py-2">
                <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                <p class="text-muted small mt-1 mb-0">Thinking...</p>
            </div>
            <div id="aiRecContent" style="display:none;">
                <p id="aiRecName" class="fw-bold mb-1"></p>
                <p id="aiRecReason" class="text-muted small mb-2"></p>
                <button class="btn btn-success btn-sm w-100" onclick="applyRecommendation()">Add This Exercise</button>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <strong>Exercises in This Workout</strong>
            </div>
            <div class="card-body p-0">
                @if (Model.Entries.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Exercise</th>
                                <th>Muscle Group</th>
                                <th>Sets</th>
                                <th>Reps</th>
                                <th>Weight</th>
                                <th>Notes</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Entries.OrderBy(e => e.ExerciseName))
                            {
                                var isPR = ViewBag.PersonalRecords != null &&
                                ((Dictionary<string, decimal>)ViewBag.PersonalRecords).ContainsKey(entry.ExerciseName) &&
                                ((Dictionary<string, decimal>)ViewBag.PersonalRecords)[entry.ExerciseName] == entry.WeightLbs &&
                                entry.WeightLbs > 0;
                                <tr>
                                    <td>
                                        @entry.ExerciseName
                                        @if (isPR)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">PR</span>
                                        }
                                    </td>
                                    <td>@entry.MuscleGroup</td>
                                    <td>@entry.Sets</td>
                                    <td>@entry.Reps</td>
                                    <td>@entry.WeightLbs lbs</td>
                                    <td>@entry.Notes</td>
                                    <td>
                                        <a asp-action="ExerciseHistory" asp-route-exerciseName="@entry.ExerciseName"
                                           class="btn btn-sm btn-outline-info">History</a>
                                        <a asp-action="Edit" asp-route-id="@entry.Id"
                                           class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@entry.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-4">
                        <p class="text-muted">No exercises added yet. Add your first exercise on the left.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let aiRec = null;

        function updateFromExercise() {
            const select = document.getElementById('exerciseSelect');
            const option = select.options[select.selectedIndex];
            if (option.value) {
                document.getElementById('ExerciseName').value = option.value;
                document.getElementById('muscleGroupSelect').value = option.dataset.muscle;
            }
        }

        function applyRecommendation() {
            if (!aiRec) return;
            document.getElementById('ExerciseName').value = aiRec.name;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Load AI recommendation on page load
        async function loadAIRecommendation() {
            const exercises = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Entries.Select(e => e.ExerciseName).ToList()));
            if (exercises.length === 0) {
                document.getElementById('aiRecLoading').style.display = 'none';
                document.getElementById('aiRecContent').innerHTML = '<p class="text-muted small mb-0">Add your first exercise to get a recommendation.</p>';
                document.getElementById('aiRecContent').style.display = 'block';
                return;
            }

            try {
                const response = await fetch('/AICoach/Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: `I have already done: ${exercises.join(', ')}. What single exercise should I do next? Reply ONLY: ExerciseName: [name] | Reason: [one sentence] | Tips: [one form tip]`,
                        history: []
                    })
                });
                const data = await response.json();
                const text = data.response;
                const nameMatch = text.match(/ExerciseName:\s*([^|]+)/);
                const reasonMatch = text.match(/Reason:\s*([^|]+)/);
                const tipsMatch = text.match(/Tips:\s*(.+)/);

                if (nameMatch) {
                    aiRec = { name: nameMatch[1].trim() };
                    document.getElementById('aiRecName').textContent = aiRec.name;
                    document.getElementById('aiRecReason').textContent =
                        (reasonMatch?.[1].trim() || '') + (tipsMatch ? ' Tip: ' + tipsMatch[1].trim() : '');
                    document.getElementById('aiRecLoading').style.display = 'none';
                    document.getElementById('aiRecContent').style.display = 'block';
                }
            } catch (e) {
                document.getElementById('aiRecLoading').style.display = 'none';
            }
        }

        loadAIRecommendation();
    </script>
}