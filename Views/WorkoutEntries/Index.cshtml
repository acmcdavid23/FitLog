@model IEnumerable<FitLog.Models.WorkoutSession>
@{
    ViewData["Title"] = "My Workouts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Workouts</h2>
    <a asp-action="CreateSession" class="btn btn-success">New Workout</a>
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search workouts..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Muscle Group</label>
            <select name="muscleGroup" class="form-control">
                <option value="">All Muscle Groups</option>
                @foreach (var mg in ViewBag.MuscleGroups)
                {
                    if (ViewBag.MuscleGroup == mg)
                    {
                        <option value="@mg" selected>@mg</option>
                    }
                    else
                    {
                        <option value="@mg">@mg</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Workout Sessions -->
@if (Model.Any())
{
    @foreach (var session in Model)
    {
        var muscleGroups = session.Entries.Select(e => e.MuscleGroup).Distinct().ToList();
        var totalVolume = session.Entries.Sum(e => e.Sets * e.Reps * e.WeightLbs);

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="cursor: pointer;" onclick="toggleSession('@session.Id')">
                <div>
                    <strong>@session.SessionName</strong>
                    <span class="text-muted ms-2 small">@session.SessionDate.ToString("MMMM d, yyyy")</span>
                    <span class="badge bg-secondary ms-2">@session.Entries.Count exercises</span>
                    <span class="badge bg-dark ms-1">@String.Format("{0:N0}", totalVolume) lbs volume</span>
                    @foreach (var mg in muscleGroups)
                    {
                        <span class="badge bg-success ms-1">@mg</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="SessionDetail" asp-route-id="@session.Id"
                       class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation()">Open</a>
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="event.stopPropagation(); showRename(@session.Id, '@session.SessionName')">
                        Rename
                    </button>
                    <form method="post" asp-action="DeleteSession" asp-route-id="@session.Id"
                          style="display:inline" onclick="event.stopPropagation()">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete this entire workout and all its exercises?')">
                            Delete
                        </button>
                    </form>
                    <span class="text-muted small" id="chevron-@session.Id">▼</span>
                </div>
            </div>
            <div id="session-@session.Id" style="display:none;">
                <div class="card-body p-0">
                    @if (session.Entries.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Exercise</th>
                                    <th>Muscle Group</th>
                                    <th>Sets</th>
                                    <th>Reps</th>
                                    <th>Weight</th>
                                    <th>Notes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in session.Entries.OrderBy(e => e.ExerciseName))
                                {
                                    var isPR = ViewBag.PersonalRecords != null &&
                                    ((Dictionary<string, decimal>)ViewBag.PersonalRecords).ContainsKey(entry.ExerciseName) &&
                                    ((Dictionary<string, decimal>)ViewBag.PersonalRecords)[entry.ExerciseName] == entry.WeightLbs &&
                                    entry.WeightLbs > 0;
                                    <tr>
                                        <td>
                                            @entry.ExerciseName
                                            @if (isPR)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">PR</span>
                                            }
                                        </td>
                                        <td>@entry.MuscleGroup</td>
                                        <td>@entry.Sets</td>
                                        <td>@entry.Reps</td>
                                        <td>@entry.WeightLbs lbs</td>
                                        <td>@entry.Notes</td>
                                        <td>
                                            <a asp-action="ExerciseHistory"
                                               asp-route-exerciseName="@entry.ExerciseName"
                                               class="btn btn-sm btn-outline-info">History</a>
                                            <a asp-action="Edit" asp-route-id="@entry.Id"
                                               class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@entry.Id"
                                               class="btn btn-sm btn-outline-danger">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted">No exercises yet.</p>
                            <a asp-action="SessionDetail" asp-route-id="@session.Id" class="btn btn-success btn-sm">Add Exercises</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card p-4 text-center">
        <p class="text-muted mb-3">No workouts logged yet.</p>
        <a asp-action="CreateSession" class="btn btn-success">Create Your First Workout</a>
    </div>
}

<!-- Legacy unsessioned entries -->
@if (ViewBag.UnsessionedEntries != null && ((List<FitLog.Models.WorkoutEntry>)ViewBag.UnsessionedEntries).Any())
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>Previous Entries</strong>
            <span class="text-muted ms-2 small">Logged before workout sessions were introduced</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Exercise</th>
                        <th>Muscle Group</th>
                        <th>Date</th>
                        <th>Sets</th>
                        <th>Reps</th>
                        <th>Weight</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in ViewBag.UnsessionedEntries)
                    {
                        <tr>
                            <td>@entry.ExerciseName</td>
                            <td>@entry.MuscleGroup</td>
                            <td>@entry.WorkoutDate.ToShortDateString()</td>
                            <td>@entry.Sets</td>
                            <td>@entry.Reps</td>
                            <td>@entry.WeightLbs lbs</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Rename Modal -->
<div class="modal fade" id="renameModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: #2d2d44;">
            <div class="modal-header">
                <h5 class="modal-title">Rename Workout</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="RenameSession">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="renameSessionId" name="sessionId" />
                    <div class="form-group">
                        <label class="control-label">Workout Name</label>
                        <input type="text" id="renameName" name="sessionName" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSession(id) {
            const el = document.getElementById('session-' + id);
            const chevron = document.getElementById('chevron-' + id);
            if (el.style.display === 'none') {
                el.style.display = 'block';
                chevron.textContent = '▲';
            } else {
                el.style.display = 'none';
                chevron.textContent = '▼';
            }
        }

        function showRename(id, currentName) {
            document.getElementById('renameSessionId').value = id;
            document.getElementById('renameName').value = currentName;
            new bootstrap.Modal(document.getElementById('renameModal')).show();
        }
    </script>
}