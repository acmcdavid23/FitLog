@model IEnumerable<FitLog.Models.WorkoutSession>
@{
    ViewData["Title"] = "My Workouts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Workouts</h2>
    <a asp-action="CreateSession" class="btn btn-success">New Workout</a>
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form id="filterForm" class="row g-3 align-items-end" onsubmit="return false;">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Search workouts..." id="searchInput" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Muscle Group</label>
            <select name="muscleGroup" class="form-control" id="muscleGroupSelect">
                <option value="">All Muscle Groups</option>
                @foreach (var mg in ViewBag.MuscleGroups)
                {
                    if (ViewBag.MuscleGroup == mg)
                    {
                        <option value="@mg" selected>@mg</option>
                    }
                    else
                    {
                        <option value="@mg">@mg</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" id="dateFrom" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" id="dateTo" />
        </div>
    </form>
</div>

<div id="workoutEntriesResults">
    @await Html.PartialAsync("_IndexWorkoutList", Model)
</div>

@section Scripts {
    <script>
        let searchTimeout;
        async function refreshWorkouts() {
            const form = document.getElementById('filterForm');
            const params = new URLSearchParams(new FormData(form));
            const res = await fetch('@Url.Action("SessionsList", "WorkoutEntries")?' + params.toString());
            document.getElementById('workoutEntriesResults').innerHTML = await res.text();
            try {
                const url = new URL(window.location.href);
                url.search = params.toString();
                window.history.replaceState({}, '', url);
            } catch { }
        }
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(refreshWorkouts, 400);
        });
        document.getElementById('muscleGroupSelect').addEventListener('change', refreshWorkouts);
        document.getElementById('dateFrom').addEventListener('change', refreshWorkouts);
        document.getElementById('dateTo').addEventListener('change', refreshWorkouts);
    </script>
}
