@model IEnumerable<FitLog.Models.WorkoutEntry>
@{
    ViewData["Title"] = "My Workouts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Workouts</h2>
    <a asp-action="Create" class="btn btn-success">Log New Workout</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Exercise</th>
                    <th>Muscle Group</th>
                    <th>Date</th>
                    <th>Sets</th>
                    <th>Reps</th>
                    <th>Weight (lbs)</th>
                    <th>Notes</th>
                    <th>Completed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isPR = ViewBag.PersonalRecords != null &&
                    ViewBag.PersonalRecords.ContainsKey(item.ExerciseName) &&
                    ViewBag.PersonalRecords[item.ExerciseName] == item.WeightLbs &&
                    item.WeightLbs > 0;
                    <tr>
                        <td>
                            @item.ExerciseName
                            @if (isPR)
                            {
                                <span class="badge bg-warning text-dark ms-1">PR</span>
                            }
                        </td>
                        <td>@item.MuscleGroup</td>
                        <td>@item.WorkoutDate.ToShortDateString()</td>
                        <td>@item.Sets</td>
                        <td>@item.Reps</td>
                        <td>@item.WeightLbs lbs</td>
                        <td>@item.Notes</td>
                        <td>@(item.IsCompleted ? "Yes" : "No")</td>
                        <td>
                            <a asp-action="ExerciseHistory" asp-route-exerciseName="@item.ExerciseName" class="btn btn-sm btn-outline-info">History</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>