@model IEnumerable<FitLog.Models.WorkoutEntry>
@{
    ViewData["Title"] = "Exercise History";
}

<div class="mb-3">
    <a asp-action="Index" class="text-muted" style="font-size: 0.9rem;">Back to My Workouts</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@ViewBag.ExerciseName</h2>
        <p class="text-muted mb-0">Your full history for this exercise.</p>
    </div>
    @if (ViewBag.PR > 0)
    {
        <div class="card p-3 text-center" style="border: 2px solid #ffc107; min-width: 120px;">
            <p class="text-muted small mb-1">Personal Record</p>
            <h4 class="mb-0" style="color: #ffc107;">@ViewBag.PR lbs</h4>
        </div>
    }
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Sets</th>
                        <th>Reps</th>
                        <th>Weight (lbs)</th>
                        <th>Volume</th>
                        <th>Notes</th>
                        <th>Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isPR = item.WeightLbs == ViewBag.PR && item.WeightLbs > 0;
                        <tr>
                            <td>@item.WorkoutDate.ToShortDateString()</td>
                            <td>@item.Sets</td>
                            <td>@item.Reps</td>
                            <td>
                                @item.WeightLbs lbs
                                @if (isPR)
                                {
                                    <span class="badge bg-warning text-dark ms-1">PR</span>
                                }
                            </td>
                            <td>@(item.Sets* item.Reps* item.WeightLbs) lbs</td>
                            <td>@item.Notes</td>
                            <td>@(item.IsCompleted ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-4">
                <p class="text-muted">No history found for this exercise.</p>
                <a asp-action="Create" asp-route-exerciseName="@ViewBag.ExerciseName" class="btn btn-success">Log This Exercise</a>
            </div>
        }
    </div>
</div>