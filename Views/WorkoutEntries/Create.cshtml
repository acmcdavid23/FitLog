@model FitLog.Models.WorkoutEntry
@{
    ViewData["Title"] = "Log Workout";
}

<h2>Log a Workout</h2>
<hr />

<div class="row">
    <div class="col-md-5">
        <div class="card p-4">
            <form asp-action="Create" id="workoutForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="control-label">Exercise</label>
                    <select id="exerciseSelect" class="form-control" onchange="updateFromExercise()">
                        <option value="">-- Select an Exercise --</option>
                        @foreach (var ex in ViewBag.Exercises)
                        {
                            if (ViewBag.ExerciseName == ex.Name)
                            {
                                <option value="@ex.Name" data-muscle="@ex.MuscleGroup" selected>@ex.MuscleGroup - @ex.Name</option>
                            }
                            else
                            {
                                <option value="@ex.Name" data-muscle="@ex.MuscleGroup">@ex.MuscleGroup - @ex.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ExerciseName" class="control-label"></label>
                    <input asp-for="ExerciseName" class="form-control" placeholder="Or type a custom exercise" />
                    <span asp-validation-for="ExerciseName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MuscleGroup" class="control-label"></label>
                    <select asp-for="MuscleGroup" class="form-control" id="muscleGroupSelect">
                        <option value="">-- Select Muscle Group --</option>
                        <option>Chest</option>
                        <option>Back</option>
                        <option>Shoulders</option>
                        <option>Biceps</option>
                        <option>Triceps</option>
                        <option>Legs</option>
                        <option>Core</option>
                        <option>Cardio</option>
                        <option>Full Body</option>
                    </select>
                    <span asp-validation-for="MuscleGroup" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="WorkoutDate" class="control-label"></label>
                    <input asp-for="WorkoutDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="WorkoutDate" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-4">
                        <label asp-for="Sets" class="control-label"></label>
                        <input asp-for="Sets" class="form-control" placeholder="e.g. 3" />
                        <span asp-validation-for="Sets" class="text-danger"></span>
                    </div>
                    <div class="col-4">
                        <label asp-for="Reps" class="control-label"></label>
                        <input asp-for="Reps" class="form-control" placeholder="e.g. 10" />
                        <span asp-validation-for="Reps" class="text-danger"></span>
                    </div>
                    <div class="col-4">
                        <label asp-for="WeightLbs" class="control-label"></label>
                        <input asp-for="WeightLbs" class="form-control" placeholder="e.g. 135" />
                        <span asp-validation-for="WeightLbs" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Notes" class="control-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                </div>

                <div class="form-group form-check mb-3">
                    <input class="form-check-input" asp-for="IsCompleted" />
                    <label class="form-check-label" asp-for="IsCompleted">Mark as Completed</label>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save Workout" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Last Session + Rest Timer -->
    <div class="col-md-4">
        @if (ViewBag.LastSession != null)
        {
            <div class="card p-4 mb-4" style="border-left: 3px solid var(--fitlog-green);">
                <h5 class="fw-bold mb-3">Last Session</h5>
                <p class="text-muted small mb-1">@ViewBag.LastSession.WorkoutDate.ToShortDateString()</p>
                <dl class="row mb-0">
                    <dt class="col-6 text-muted small">Sets</dt>
                    <dd class="col-6 small">@ViewBag.LastSession.Sets</dd>
                    <dt class="col-6 text-muted small">Reps</dt>
                    <dd class="col-6 small">@ViewBag.LastSession.Reps</dd>
                    <dt class="col-6 text-muted small">Weight</dt>
                    <dd class="col-6 small">@ViewBag.LastSession.WeightLbs lbs</dd>
                    <dt class="col-6 text-muted small">Notes</dt>
                    <dd class="col-6 small">@ViewBag.LastSession.Notes</dd>
                </dl>
            </div>
        }

        <!-- Rest Timer -->
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Rest Timer</h5>
            <div class="text-center mb-3">
                <h1 id="timerDisplay" style="font-size: 3rem; color: var(--fitlog-green);">1:30</h1>
            </div>
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-outline-secondary btn-sm" onclick="setTimer(60)">1:00</button>
                <button class="btn btn-outline-secondary btn-sm" onclick="setTimer(90)">1:30</button>
                <button class="btn btn-outline-secondary btn-sm" onclick="setTimer(120)">2:00</button>
                <button class="btn btn-outline-secondary btn-sm" onclick="setTimer(180)">3:00</button>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-success w-100" onclick="startTimer()">Start</button>
                <button class="btn btn-outline-danger w-100" onclick="resetTimer()">Reset</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let timerSeconds = 90;
        let timerInterval = null;
        let currentSeconds = 90;

        function setTimer(seconds) {
            resetTimer();
            timerSeconds = seconds;
            currentSeconds = seconds;
            updateDisplay();
        }

        function startTimer() {
            if (timerInterval) return;
            timerInterval = setInterval(() => {
                currentSeconds--;
                updateDisplay();
                if (currentSeconds <= 0) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    document.getElementById('timerDisplay').style.color = '#dc3545';
                    alert('Rest time is up! Time for your next set.');
                    document.getElementById('timerDisplay').style.color = 'var(--fitlog-green)';
                }
            }, 1000);
        }

        function resetTimer() {
            clearInterval(timerInterval);
            timerInterval = null;
            currentSeconds = timerSeconds;
            updateDisplay();
        }

        function updateDisplay() {
            const mins = Math.floor(currentSeconds / 60);
            const secs = currentSeconds % 60;
            document.getElementById('timerDisplay').textContent =
                mins + ':' + (secs < 10 ? '0' : '') + secs;
        }

        function updateFromExercise() {
            const select = document.getElementById('exerciseSelect');
            const option = select.options[select.selectedIndex];
            if (option.value) {
                document.getElementById('ExerciseName').value = option.value;
                document.getElementById('muscleGroupSelect').value = option.dataset.muscle;

                // Reload page with exercise name to fetch last session
                window.location.href = '/WorkoutEntries/Create?exerciseName=' + encodeURIComponent(option.value);
            }
        }
    </script>
}