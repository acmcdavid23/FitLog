@using FitLog.Models
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Friends";
    var friends = ViewBag.Friends as List<IdentityUser> ?? new List<IdentityUser>();
    var displayNames = ViewBag.FriendDisplayNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var profileUrls = ViewBag.FriendProfileUrls as Dictionary<string, string> ?? new Dictionary<string, string>();
    var pending = ViewBag.PendingRequests as List<FriendRequest> ?? new List<FriendRequest>();
    var pendingSenders = ViewBag.PendingSenders as List<IdentityUser> ?? new List<IdentityUser>();
    var myUsername = ViewBag.MyUsername as string ?? "";
    var baseUrl = ViewBag.BaseUrl as string ?? "";
    var myQrUrl = string.IsNullOrWhiteSpace(myUsername) ? "" : $"{baseUrl}/Friends/AddViaQR?username={Uri.EscapeDataString(myUsername)}";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0">Friends</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addFriendModal">Add Friend</button>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Your Friends</div>
        <div class="card-body p-0" id="friendsListCardBody">
            @if (friends.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var f in friends)
                    {
                        var label = displayNames.TryGetValue(f.Id, out var dn) && !string.IsNullOrWhiteSpace(dn) ? dn : (f.UserName ?? f.Email ?? f.Id);
                        var photo = profileUrls.TryGetValue(f.Id, out var pu) ? pu : "";
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(photo))
                                {
                                    <img src="@photo" alt="" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;font-size:0.85rem;">@(label.Length > 0 ? label.Substring(0, 1).ToUpper() : "?")</div>
                                }
                                <div>
                                    <div class="fw-semibold">@label</div>
                                    <small class="text-muted">@@@(f.UserName ?? "")</small>
                                </div>
                            </div>
                            <form asp-action="RemoveFriend" method="post" class="m-0" onsubmit="return confirm('Remove this friend?');"
                                  data-fitlog-ajax-url="@Url.Action("RemoveFriendAjax", "Friends")"
                                  data-fitlog-success-event="fitlog:friend-removed">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="friendId" value="@f.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No friends yet. Send a request by username or email.</p>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(myQrUrl))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Friend QR</div>
            <div class="card-body">
                <p class="text-muted small mb-2">Share this QR so people can add you instantly.</p>
                <div id="friendQrCode" class="d-inline-flex justify-content-center"></div>
                <div class="mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#scanFriendQrModal">Scan Friend QR</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="border border-warning border-opacity-50 rounded p-3 mb-0 small text-warning-emphasis">
            Set a username in <a asp-controller="Settings" asp-action="Index">Settings</a> to enable your friend QR code.
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Incoming Requests</div>
        <div class="card-body p-0" id="friendRequestsCardBody">
            @if (pending.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var r in pending)
                    {
                        var from = pendingSenders.FirstOrDefault(u => u.Id == r.SenderId);
                        var fromLabel = from == null ? "User" : (displayNames.TryGetValue(from.Id, out var dn2) && !string.IsNullOrWhiteSpace(dn2) ? dn2 : (from.UserName ?? from.Email ?? ""));
                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>@fromLabel <small class="text-muted">@@@(from?.UserName ?? "")</small></span>
                            <div class="d-flex gap-2">
                                <form asp-action="AcceptRequest" method="post" class="m-0"
                                      data-fitlog-ajax-url="@Url.Action("AcceptRequestAjax", "Friends")"
                                      data-fitlog-success-event="fitlog:friend-request-accepted">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                </form>
                                <form asp-action="DeclineRequest" method="post" class="m-0"
                                      data-fitlog-ajax-url="@Url.Action("DeclineRequestAjax", "Friends")"
                                      data-fitlog-success-event="fitlog:friend-request-declined">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Decline</button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted p-3 mb-0">No pending requests.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="addFriendModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SendRequest" method="post"
                  data-fitlog-ajax-url="@Url.Action("SendRequestAjax", "Friends")"
                  data-fitlog-close-modal="addFriendModal">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Friend</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Username or email</label>
                    <input type="text" name="searchQuery" class="form-control" placeholder="username or email" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Send Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="scanFriendQrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Scan Friend QR</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Point your camera at a friend's QR code.</p>
                <div id="friendQrReader" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(myQrUrl))
    {
        var qrJson = System.Text.Json.JsonSerializer.Serialize(myQrUrl);
        <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
        <script>
            new QRCode(document.getElementById('friendQrCode'), {
                text: @Html.Raw(qrJson),
                width: 150,
                height: 150,
                colorDark: '#28a745',
                colorLight: '#2d2d44',
                correctLevel: QRCode.CorrectLevel.M
            });
        </script>
    }
    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script>
        (function () {
            const modalEl = document.getElementById('scanFriendQrModal');
            if (!modalEl) return;
            let reader = null;
            let active = false;

            function stopReader() {
                if (reader && active) {
                    reader.stop().catch(() => { });
                }
                active = false;
            }

            modalEl.addEventListener('shown.bs.modal', function () {
                if (typeof Html5Qrcode === 'undefined') return;
                reader = new Html5Qrcode('friendQrReader');
                reader.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: 220 },
                    (decodedText) => {
                        stopReader();
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                        if (decodedText.includes('/Friends/AddViaQR?username=')) {
                            window.location.href = decodedText;
                            return;
                        }
                        if (window.fitlogToast) window.fitlogToast('Unrecognized friend QR code.', 'warning');
                    },
                    () => { }
                ).then(() => { active = true; }).catch(() => { });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                stopReader();
            });
        })();

        function escFriends(s) {
            if (s == null) return '';
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        }

        function escFriendsAttr(s) {
            if (s == null) return '';
            return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        }

        function friendsAntiForgeryValue() {
            var t = document.querySelector('input[name="__RequestVerificationToken"]');
            return t ? t.value : '';
        }

        const removeFriendUrl = '@Url.Action("RemoveFriendAjax", "Friends")';

        document.addEventListener('fitlog:friend-removed', function (e) {
            const fid = e.detail?.data?.friendId;
            if (!fid) return;
            var sel = '#friendsListCardBody input[name="friendId"][value="' + CSS.escape(fid) + '"]';
            var inp = document.querySelector(sel);
            inp?.closest('li')?.remove();
        });

        document.addEventListener('fitlog:friend-request-declined', function (e) {
            const rid = e.detail?.data?.requestId;
            if (rid == null) return;
            const inp = document.querySelector('#friendRequestsCardBody input[name="id"][value="' + rid + '"]');
            inp?.closest('li')?.remove();
        });

        document.addEventListener('fitlog:friend-request-accepted', function (e) {
            const d = e.detail?.data || {};
            const rid = d.requestId;
            const friendId = d.friendId;
            const un = d.friendUserName || '';
            const label = d.friendDisplayName || un || 'Friend';
            if (rid != null) {
                const inp = document.querySelector('#friendRequestsCardBody input[name="id"][value="' + rid + '"]');
                inp?.closest('li')?.remove();
            }
            if (!friendId) return;
            const body = document.getElementById('friendsListCardBody');
            if (!body) return;
            let ul = body.querySelector('ul.list-group');
            const emptyP = body.querySelector('p.text-muted');
            if (!ul && emptyP) {
                emptyP.remove();
                ul = document.createElement('ul');
                ul.className = 'list-group list-group-flush';
                body.appendChild(ul);
            }
            if (!ul) return;
            const letter = label.length > 0 ? label.substring(0, 1).toUpperCase() : '?';
            const tok = friendsAntiForgeryValue();
            const li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center';
            li.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;font-size:0.85rem;">' + escFriends(letter) + '</div><div><div class="fw-semibold">' + escFriends(label) + '</div><small class="text-muted">@@' + escFriends(un) + '</small></div></div><form method="post" class="m-0" data-fitlog-ajax-url="' + removeFriendUrl + '" data-fitlog-success-event="fitlog:friend-removed"><input type="hidden" name="__RequestVerificationToken" value="' + escFriendsAttr(tok) + '" /><input type="hidden" name="friendId" value="' + escFriendsAttr(friendId) + '" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm(\'Remove this friend?\');">Remove</button></form>';
            ul.appendChild(li);
        });
    </script>
}
