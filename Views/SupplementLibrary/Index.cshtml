@model Dictionary<string, List<FitLog.Models.SupplementLibraryItem>>

@{
    ViewData["Title"] = "Supplement Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Supplement Library</h2>
        <p class="text-muted mb-0">Evidence-based supplement recommendations for performance, recovery, and health.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">Add Supplement</a>
    }
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form method="get" id="filterForm" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Search supplements..." id="searchInput" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-control" id="categorySelect">
                <option value="">All Categories</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    if (ViewBag.Category == cat)
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Evidence Level</label>
            <select name="evidenceLevel" class="form-control" id="evidenceSelect">
                <option value="">All Evidence Levels</option>
                @foreach (var level in ViewBag.EvidenceLevels)
                {
                    if (ViewBag.EvidenceLevel == level)
                    {
                        <option value="@level" selected>@level</option>
                    }
                    else
                    {
                        <option value="@level">@level</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Evidence Legend -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #28a745;">
            <h6 class="fw-bold">Strong Evidence</h6>
            <p class="text-muted small mb-0">Backed by multiple high-quality studies. Consistent results across research.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #ffc107;">
            <h6 class="fw-bold">Moderate Evidence</h6>
            <p class="text-muted small mb-0">Some good research exists but results may vary. Generally considered safe.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #dc3545;">
            <h6 class="fw-bold">Limited Evidence</h6>
            <p class="text-muted small mb-0">Early research or anecdotal support. More studies needed.</p>
        </div>
    </div>
</div>

@if (Model.Any())
{
    @foreach (var group in Model)
    {
        <div class="mb-4">
            <h4 class="mb-3" style="border-bottom: 1px solid #3a3a5c; padding-bottom: 8px;">@group.Key</h4>
            <div class="row">
                @foreach (var item in group.Value)
                {
                    var borderColor = item.EvidenceLevel == "Strong" ? "#28a745" : item.EvidenceLevel == "Moderate" ? "#ffc107" : "#dc3545";
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 p-3" style="border-left: 3px solid @borderColor;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">@item.Name</h6>
                                @if (item.IsRecommended)
                                {
                                    <span class="badge bg-success">Recommended</span>
                                }
                            </div>
                            <span class="badge mb-2" style="background-color: @borderColor; width: fit-content;">@item.EvidenceLevel Evidence</span>
                            <p class="text-muted small mb-2">@item.RecommendedDosage</p>
                            <p class="text-muted small mb-2">@item.WhenToTake</p>
                            <div class="mt-auto pt-2 d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Learn More</a>
                                @if (!string.IsNullOrEmpty(item.InfoUrl))
                                {
                                    <a href="@item.InfoUrl" target="_blank" class="btn btn-sm btn-outline-secondary">Info</a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this supplement?')">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <p class="text-muted">No supplements found. Try adjusting your search or filters.</p>
    </div>
}

@section Scripts {
    <script>
        let searchTimeout;

        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                document.getElementById('filterForm').submit();
            }, 400);
        });

        document.getElementById('categorySelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });

        document.getElementById('evidenceSelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });
    </script>
}