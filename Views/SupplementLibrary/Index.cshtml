@model FitLog.ViewModels.SupplementLibraryIndexPageViewModel

@{
    ViewData["Title"] = "Supplement Library";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Supplement Library</h2>
        <p class="text-muted mb-0">Evidence-based supplement information. Click Learn More for dosing, benefits, and personalized recommendations.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="CreatePersonal" class="btn btn-outline-success">+ My Supplement</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">Add to Library</a>
        }
    </div>
</div>

<!-- Search and Filter -->
<div class="card p-3 mb-4">
    <form id="filterForm" class="row g-3 align-items-end" onsubmit="return false;">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Search supplements..." id="searchInput" autocomplete="off" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-select" id="categorySelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All Categories</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    if (ViewBag.Category == cat)
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Evidence Level</label>
            <select name="evidenceLevel" class="form-select" id="evidenceSelect"
                    style="background-color: #2d2d44; border-color: #3a3a5c; color: #e0e0e0;">
                <option value="">All Evidence Levels</option>
                @foreach (var level in ViewBag.EvidenceLevels)
                {
                    if (ViewBag.EvidenceLevel == level)
                    {
                        <option value="@level" selected>@level</option>
                    }
                    else
                    {
                        <option value="@level">@level</option>
                    }
                }
            </select>
        </div>
    </form>
</div>

<!-- Evidence Legend -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #28a745;">
            <h6 class="fw-bold">Strong Evidence</h6>
            <p class="text-muted small mb-0">Backed by multiple high-quality studies with consistent results.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #ffc107;">
            <h6 class="fw-bold">Moderate Evidence</h6>
            <p class="text-muted small mb-0">Some good research exists but results may vary.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100" style="border-left: 3px solid #dc3545;">
            <h6 class="fw-bold">Limited Evidence</h6>
            <p class="text-muted small mb-0">Early research or anecdotal support. More studies needed.</p>
        </div>
    </div>
</div>

<div id="libraryMain">
    @await Html.PartialAsync("_SupplementLibraryMain", Model)
</div>

@section Scripts {
    <script>
        let searchTimeout;
        async function refreshLibrary() {
            const form = document.getElementById('filterForm');
            const params = new URLSearchParams(new FormData(form));
            const res = await fetch('@Url.Action("LibraryMainPartial", "SupplementLibrary")?' + params.toString());
            document.getElementById('libraryMain').innerHTML = await res.text();
            try {
                const url = new URL(window.location.href);
                url.search = params.toString();
                window.history.replaceState({}, '', url);
            } catch { }
        }
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(refreshLibrary, 400);
        });
        document.getElementById('categorySelect').addEventListener('change', refreshLibrary);
        document.getElementById('evidenceSelect').addEventListener('change', refreshLibrary);
        document.addEventListener('fitlog:supplement-library-changed', function () { refreshLibrary(); });
    </script>
}
