@{
    ViewData["Title"] = "Groups";
    var groups = ViewBag.Groups as List<FitLog.Models.FitLogGroup> ?? new();
    var recommendedGroups = ViewBag.RecommendedGroups as List<FitLog.Models.FitLogGroup> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">Groups</h2>
        <p class="text-muted mb-0">Create or join a group and compete on the leaderboard.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#joinGroupModal">Join Group</button>
        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createGroupModal">+ Create Group</button>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><strong>Recommended groups for you</strong></div>
    <div class="card-body p-0">
        @if (recommendedGroups.Any())
        {
            @foreach (var rg in recommendedGroups)
            {
                <div class="p-3" style="border-bottom:1px solid #3a3a5c;">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div class="d-flex gap-2">
                            @if (!string.IsNullOrEmpty(rg.ImageUrl))
                            {
                                <img src="@rg.ImageUrl" alt="" class="rounded-circle border border-secondary" style="width:48px;height:48px;object-fit:cover;" />
                            }
                            <div>
                                <p class="fw-bold mb-0">@rg.Name</p>
                                @if (!string.IsNullOrEmpty(rg.Location))
                                {
                                    <p class="text-muted small mb-0">&#128205; @rg.Location</p>
                                }
                                <p class="text-muted small mb-0">@rg.Members.Count members</p>
                            </div>
                        </div>
                        <form method="get" asp-controller="Groups" asp-action="JoinByInvite" class="m-0">
                            <input type="hidden" name="code" value="@rg.InviteCode" />
                            <button type="submit" class="btn btn-sm btn-success">Join</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-3 text-muted small">No close matches right now. Your location, gender, and fitness goal in Settings help us rank groups—try joining an open group below.</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><strong>My Groups (@groups.Count)</strong></div>
    <div class="card-body p-0">
        @if (groups.Any())
        {
            @foreach (var group in groups)
            {
                <a asp-action="Detail" asp-route-id="@group.Id" class="d-flex justify-content-between align-items-center p-3 text-decoration-none" style="border-bottom: 1px solid #3a3a5c;">
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(group.ImageUrl))
                        {
                            <img src="@group.ImageUrl" alt="" class="rounded-circle border border-secondary" style="width:44px;height:44px;object-fit:cover;" />
                        }
                        <div>
                            <p class="fw-bold mb-0" style="color:#e0e0e0;">@group.Name @if (group.IsPrivate) {
                            <span class="badge bg-secondary ms-1" style="font-size:0.65rem;">Private</span>
                        }
                        </p>
                        @if (!string.IsNullOrEmpty(group.Description))
                        {
                            <p class="text-muted small mb-0">@group.Description</p>
                        }
                        <p class="text-muted small mb-0">@group.Members.Count members</p>
                        </div>
                    </div>
                    <span style="color: var(--fitlog-green);">&#8250;</span>
                </a>
            }
        }
        else
        {
            <div class="text-center py-4">
                <p class="text-muted mb-1">No groups yet.</p>
                <p class="text-muted small">Create or join a group above.</p>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="createGroupModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Create Group</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateGroup" method="post" enctype="multipart/form-data"
                  data-fitlog-ajax-url="@Url.Action("CreateGroupAjax", "Groups")"
                  data-fitlog-close-modal="createGroupModal">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Group Name <span class="text-danger">*</span></label>
                        <input name="groupName" class="form-control" placeholder="e.g. Monday Crew" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Description</label>
                        <input name="description" class="form-control" placeholder="What is this group about?" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Location</label>
                        <input name="location" class="form-control" placeholder="e.g. Tuscaloosa, AL" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Group picture <span class="text-muted fw-normal">(optional)</span></label>
                        <input name="groupImage" id="createGroupImage" type="file" accept="image/*" class="visually-hidden" data-image-crop-circle="true" />
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('createGroupImage').click()">Choose picture</button>
                        </div>
                        <small class="text-muted">JPG, PNG, WebP, GIF, or BMP (up to 15 MB). Use <strong>Create Group</strong> to save.</small>
                    </div>
                    <div class="form-group mb-2">
                        <label class="fw-bold mb-1">Password</label>
                        <input name="password" type="password" class="form-control" placeholder="Leave blank for public group" />
                    </div>
                    <small class="text-muted">Setting a password makes the group private.</small>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="joinGroupModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Join a Group</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">Have an invite code from a QR?</p>
                <form method="get" asp-controller="Groups" asp-action="JoinByInvite" class="mb-3">
                    <div class="input-group input-group-sm mb-1">
                        <input name="code" class="form-control" placeholder="Invite code" />
                        <button type="submit" class="btn btn-outline-success">Go</button>
                    </div>
                </form>
                <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#scanGroupQrModal">Scan Group QR</button>
                <hr class="border-secondary" />
                <form asp-action="JoinGroup" method="post"
                      data-fitlog-ajax-url="@Url.Action("JoinGroupAjax", "Groups")"
                      data-fitlog-close-modal="joinGroupModal">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label class="fw-bold mb-1">Group Name <span class="text-danger">*</span></label>
                        <input name="groupName" class="form-control" placeholder="Enter the exact group name" required />
                    </div>
                    <div class="form-group mb-2">
                        <label class="fw-bold mb-1">Password</label>
                        <input name="groupPassword" type="password" class="form-control" placeholder="Leave blank if public group" />
                    </div>
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Join Group</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="scanGroupQrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Scan Group QR</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Point your camera at a group invite QR code.</p>
                <div id="groupQrReader" style="width:100%;"></div>
                <small class="text-muted d-block mt-2">If scanning does not start, allow camera permission.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script>
        (function () {
            const modalEl = document.getElementById('scanGroupQrModal');
            if (!modalEl) return;
            let reader = null;
            let active = false;

            function stopReader() {
                if (reader && active) {
                    reader.stop().catch(() => { });
                }
                active = false;
            }

            modalEl.addEventListener('shown.bs.modal', function () {
                if (typeof Html5Qrcode === 'undefined') return;
                reader = new Html5Qrcode('groupQrReader');
                reader.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: 220 },
                    (decodedText) => {
                        stopReader();
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                        if (decodedText.includes('/Groups/JoinByInvite?code=')) {
                            window.location.href = decodedText;
                            return;
                        }
                        if (decodedText.startsWith('group-code:')) {
                            const code = decodedText.substring('group-code:'.length);
                            window.location.href = '/Groups/JoinByInvite?code=' + encodeURIComponent(code);
                            return;
                        }
                        if (window.fitlogToast) window.fitlogToast('Unrecognized group QR code.', 'warning');
                    },
                    () => { }
                ).then(() => { active = true; }).catch(() => { });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                stopReader();
            });
        })();
    </script>
}
