@{
    ViewData["Title"] = "Nutrition";
    var allMeals = new[] { "Breakfast", "Lunch", "Dinner", "Snack", "Pre-Workout", "Post-Workout" };
    var grouped = ViewBag.Grouped as Dictionary<string, List<FitLog.Models.NutritionLog>> ?? new();

    var weeklyProteinList = ViewBag.WeeklyProtein as List<decimal> ?? new List<decimal>();
    var weeklyCarbsList = ViewBag.WeeklyCarbs as List<decimal> ?? new List<decimal>();
    var weeklyFatList = ViewBag.WeeklyFat as List<decimal> ?? new List<decimal>();
    var weeklyLabels = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(i - 6).ToString("ddd M/d")).ToList();

    var proteinJson = System.Text.Json.JsonSerializer.Serialize(weeklyProteinList);
    var carbsJson = System.Text.Json.JsonSerializer.Serialize(weeklyCarbsList);
    var fatJson = System.Text.Json.JsonSerializer.Serialize(weeklyFatList);
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(weeklyLabels);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Nutrition</h2>
        <p class="text-muted mb-0">Track your daily food intake and macros.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card p-4 mb-4 macro-weekly-card">
    <h6 class="fw-bold mb-1">Weekly Macros</h6>
    <p class="text-muted small mb-3">Daily totals (grams) — stacked like a macro tracker</p>
    <div class="macro-chart-wrap">
        <canvas id="weeklyMacroChart" height="100"></canvas>
    </div>
    <div class="d-flex gap-4 mt-3 justify-content-center flex-wrap macro-legend-mfp">
        <span><span class="macro-swatch macro-swatch-p"></span>Protein</span>
        <span><span class="macro-swatch macro-swatch-c"></span>Carbs</span>
        <span><span class="macro-swatch macro-swatch-f"></span>Fat</span>
    </div>
</div>

<div class="card p-3 mb-4">
    <div class="row text-center g-2">
        <div class="col-3">
            <p class="text-muted small mb-0">Calories</p>
            <h5 style="color:var(--fitlog-green);">@ViewBag.TotalCalories</h5>
            <p class="text-muted" style="font-size:0.75rem;">/ @ViewBag.CalorieGoal</p>
        </div>
        <div class="col-3">
            <p class="text-muted small mb-0">Protein</p>
            <h5 style="color:#28a745;">@ViewBag.TotalProtein<span style="font-size:0.8rem;">g</span></h5>
            <p class="text-muted" style="font-size:0.75rem;">/ @ViewBag.ProteinGoal g</p>
        </div>
        <div class="col-3">
            <p class="text-muted small mb-0">Carbs</p>
            <h5 style="color:#17a2b8;">@ViewBag.TotalCarbs<span style="font-size:0.8rem;">g</span></h5>
            <p class="text-muted" style="font-size:0.75rem;">/ @ViewBag.CarbGoal g</p>
        </div>
        <div class="col-3">
            <p class="text-muted small mb-0">Fat</p>
            <h5 style="color:#ffc107;">@ViewBag.TotalFat<span style="font-size:0.8rem;">g</span></h5>
            <p class="text-muted" style="font-size:0.75rem;">/ @ViewBag.FatGoal g</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card p-4 mb-4" style="border-left: 3px solid var(--fitlog-green);">
            <ul class="nav nav-pills mb-3">
                <li class="nav-item"><button class="nav-link active" id="tab-ai" onclick="switchTab('ai')">AI Estimate</button></li>
                <li class="nav-item"><button class="nav-link" id="tab-manual" onclick="switchTab('manual')">Manual Entry</button></li>
            </ul>
            <div class="form-group mb-2">
                <select id="mealNameSelect" class="form-control">
                    <option value="">Select meal...</option>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch">Lunch</option>
                    <option value="Dinner">Dinner</option>
                    <option value="Snack">Snack</option>
                    <option value="Pre-Workout">Pre-Workout</option>
                    <option value="Post-Workout">Post-Workout</option>
                </select>
            </div>

            <div id="panel-ai">
                <div class="form-group mb-2">
                    <div class="position-relative">
                        <input type="text" id="aiFoodDescription" class="form-control" placeholder="What did you eat?" oninput="debounceSearch()" autocomplete="off" />
                        <div id="suggestions" class="position-absolute w-100 mt-1" style="z-index:1000;display:none;background:#2d2d44;border:1px solid #3a3a5c;border-radius:8px;max-height:200px;overflow-y:auto;"></div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2" data-bs-toggle="modal" data-bs-target="#barcodeScanModal">Scan barcode</button>
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="showRecentFoods()">Recent</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="showFavoriteFoods()">Favorites</button>
                </div>
                <div class="input-group mb-3">
                    <input type="number" id="servingAmount" class="form-control" placeholder="Amount" step="0.1" />
                    <select id="servingUnit" class="form-select" style="max-width:90px;">
                        <option value="g">g</option>
                        <option value="oz">oz</option>
                        <option value="lbs">lbs</option>
                        <option value="ml">ml</option>
                        <option value="cup">cup</option>
                        <option value="tbsp">tbsp</option>
                        <option value="tsp">tsp</option>
                        <option value="serving">serving</option>
                        <option value="piece">piece</option>
                    </select>
                </div>
                <button class="btn btn-success w-100 mb-2" onclick="estimateMacros()" id="estimateBtn">Estimate Macros with AI</button>
                <div id="aiResult" style="display:none;">
                    <hr />
                    <p class="text-muted small mb-2">AI Estimate — adjust if needed:</p>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="text-muted small">Macro source</label>
                            <select id="macroMode" class="form-select form-select-sm" onchange="applyMacroMode()">
                                <option value="serving">Per serving</option>
                                <option value="100g">Per 100g</option>
                            </select>
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="saveCurrentFavorite()">Save as Favorite</button>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><label class="text-muted small">Calories</label><input type="number" id="estCalories" class="form-control form-control-sm" /></div>
                        <div class="col-6"><label class="text-muted small">Protein (g)</label><input type="number" id="estProtein" class="form-control form-control-sm" step="0.1" /></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><label class="text-muted small">Carbs (g)</label><input type="number" id="estCarbs" class="form-control form-control-sm" step="0.1" /></div>
                        <div class="col-6"><label class="text-muted small">Fat (g)</label><input type="number" id="estFat" class="form-control form-control-sm" step="0.1" /></div>
                    </div>
                    <p id="aiNote" class="text-muted small mb-2"></p>
                    <button class="btn btn-success w-100" onclick="saveAILog()">Save to Food Log</button>
                </div>
            </div>

            <div id="panel-manual" style="display:none;">
                <form asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MealName" id="manualMealName" />
                    <div class="form-group mb-2"><input name="FoodItem" class="form-control" placeholder="Food item" required /></div>
                    <div class="input-group mb-2">
                        <input name="ServingSize" class="form-control" placeholder="Serving size" />
                        <select name="ServingUnit" class="form-select" style="max-width:90px;">
                            <option value="g">g</option>
                            <option value="oz">oz</option>
                            <option value="cup">cup</option>
                            <option value="serving">serving</option>
                        </select>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><input name="Calories" type="number" class="form-control" placeholder="Calories" required /></div>
                        <div class="col-6"><input name="Protein" type="number" step="0.1" class="form-control" placeholder="Protein (g)" required /></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6"><input name="Carbs" type="number" step="0.1" class="form-control" placeholder="Carbs (g)" required /></div>
                        <div class="col-6"><input name="Fat" type="number" step="0.1" class="form-control" placeholder="Fat (g)" required /></div>
                    </div>
                    <button type="submit" class="btn btn-success w-100"
                            onclick="document.getElementById('manualMealName').value = document.getElementById('mealNameSelect').value || 'Meal'">
                        Add Food
                    </button>
                </form>
            </div>
        </div>

    </div>

    <div class="col-md-7">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Today's Food Log — @ViewBag.Today.ToString("MMMM d, yyyy")</strong>
                <a asp-action="History" class="text-muted small">View History</a>
            </div>
            <div class="card-body p-0">
                @foreach (var mealName in allMeals)
                {
                    var items = grouped.ContainsKey(mealName) ? grouped[mealName] : new List<FitLog.Models.NutritionLog>();
                    var mealCals = items.Sum(i => i.Calories);
                    var mealProtein = items.Sum(i => i.Protein);
                    var mealCarbs = items.Sum(i => i.Carbs);
                    var mealFat = items.Sum(i => i.Fat);
                    <div style="border-bottom: 1px solid #3a3a5c;">
                        <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-1">
                            <p class="fw-bold mb-0 text-muted small" style="text-transform:uppercase;">@mealName</p>
                            @if (items.Any())
                            {
                                <span class="text-muted" style="font-size:0.75rem;">
                                    @mealCals kcal &bull;
                                    P: <span style="color:#28a745;">@Math.Round(mealProtein, 1)g</span> &bull;
                                    C: <span style="color:#17a2b8;">@Math.Round(mealCarbs, 1)g</span> &bull;
                                    F: <span style="color:#ffc107;">@Math.Round(mealFat, 1)g</span>
                                </span>
                            }
                        </div>
                        @if (items.Any())
                        {
                            <div class="px-3 pb-2">
                                @foreach (var item in items)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-1 py-1" style="border-top:1px solid #32383e;">
                                        <div>
                                            <span>@item.FoodItem</span>
                                            @if (!string.IsNullOrEmpty(item.ServingSize))
                                            {
                                                <span class="text-muted small ms-1">(@item.ServingSize)</span>
                                            }
                                            <div style="font-size:0.75rem;margin-top:2px;">
                                                <span class="text-muted">@item.Calories kcal</span> &bull;
                                                <span style="color:#28a745;">P: @item.Protein g</span> &bull;
                                                <span style="color:#17a2b8;">C: @item.Carbs g</span> &bull;
                                                <span style="color:#ffc107;">F: @item.Fat g</span>
                                            </div>
                                        </div>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">&#x2715;</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small px-3 pb-2 mb-0" style="font-size:0.8rem;">Nothing logged yet</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="barcodeScanModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #2d2d44; border: 1px solid #3a3a5c;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Scan Food Barcode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Scan UPC/EAN barcodes, then verify the food name before saving.</p>
                <div id="barcodeReader" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script>
        const labels = @Html.Raw(labelsJson);
        const proteinData = @Html.Raw(proteinJson);
        const carbData = @Html.Raw(carbsJson);
        const fatData = @Html.Raw(fatJson);
        const todayIndex = 6;

        const colP = (i) => i === todayIndex ? '#28a745' : 'rgba(40,167,69,0.38)';
        const colC = (i) => i === todayIndex ? '#20c997' : 'rgba(32,201,151,0.38)';
        const colF = (i) => i === todayIndex ? '#ffc107' : 'rgba(255,193,7,0.42)';

        new Chart(document.getElementById('weeklyMacroChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Protein', data: proteinData, backgroundColor: labels.map((_, i) => colP(i)), borderRadius: { topLeft: 5, topRight: 5 }, borderSkipped: 'middle', stack: 'macros', maxBarThickness: 48 },
                    { label: 'Carbs', data: carbData, backgroundColor: labels.map((_, i) => colC(i)), borderRadius: 0, borderSkipped: false, stack: 'macros', maxBarThickness: 48 },
                    { label: 'Fat', data: fatData, backgroundColor: labels.map((_, i) => colF(i)), borderRadius: { bottomLeft: 5, bottomRight: 5 }, borderSkipped: 'middle', stack: 'macros', maxBarThickness: 48 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                datasets: { bar: { categoryPercentage: 0.65, barPercentage: 0.82 } },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1c1e22',
                        titleColor: '#e0e0e0',
                        bodyColor: '#e0e0e0',
                        borderColor: '#32383e',
                        borderWidth: 1,
                        padding: 10,
                        callbacks: {
                            footer(items) {
                                const i = items[0]?.dataIndex;
                                if (i == null) return '';
                                const p = proteinData[i] || 0, c = carbData[i] || 0, f = fatData[i] || 0;
                                return 'Total: ' + Math.round(p + c + f) + ' g';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        ticks: { color: '#adb5bd', font: { size: 11, weight: '500' } },
                        grid: { display: false, drawBorder: false }
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        ticks: {
                            color: '#6c757d',
                            font: { size: 10 },
                            callback: v => (typeof v === 'number' && Number.isFinite(v) ? Math.round(v) + ' g' : '')
                        },
                        grid: { color: 'rgba(255,255,255,0.06)', drawBorder: false },
                        border: { display: false }
                    }
                }
            }
        });

        function switchTab(tab) {
            document.getElementById('panel-ai').style.display = tab === 'ai' ? 'block' : 'none';
            document.getElementById('panel-manual').style.display = tab === 'manual' ? 'block' : 'none';
            document.getElementById('tab-ai').classList.toggle('active', tab === 'ai');
            document.getElementById('tab-manual').classList.toggle('active', tab === 'manual');
        }

        let debounceTimer;
        let currentPackagedFood = null;
        const recentKey = 'fitlog_nutrition_recent_v1';
        const favoriteKey = 'fitlog_nutrition_favorites_v1';

        function debounceSearch() { clearTimeout(debounceTimer); debounceTimer = setTimeout(fetchSuggestions, 400); }

        function getStoredFoods(key) {
            try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; }
        }
        function setStoredFoods(key, items) {
            localStorage.setItem(key, JSON.stringify(items.slice(0, 30)));
        }
        function upsertStoredFood(key, food, dedupeField = 'barcode') {
            const items = getStoredFoods(key);
            const id = (food?.[dedupeField] || food?.name || '').toString().toLowerCase();
            const next = [food, ...items.filter(x => ((x?.[dedupeField] || x?.name || '').toString().toLowerCase() !== id))];
            setStoredFoods(key, next);
        }

        async function fetchSuggestions() {
            const query = document.getElementById('aiFoodDescription').value.trim();
            if (query.length < 2) { document.getElementById('suggestions').style.display = 'none'; return; }
            try {
                const res = await fetch('/Nutrition/SuggestFoods', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ query }) });
                const data = await res.json();
                const box = document.getElementById('suggestions');
                if (data.suggestions?.length > 0) {
                    box.innerHTML = data.suggestions.map(s => `<div class="px-3 py-2" style="cursor:pointer;border-bottom:1px solid #3a3a5c;" onmousedown="selectSuggestion('${s.replace(/'/g, "\\'")}')">${s}</div>`).join('');
                    box.style.display = 'block';
                } else { box.style.display = 'none'; }
            } catch (e) {}
        }

        function selectSuggestion(val) {
            document.getElementById('aiFoodDescription').value = val;
            document.getElementById('suggestions').style.display = 'none';
        }

        function showStoredFoodPicker(items, emptyMessage) {
            const box = document.getElementById('suggestions');
            if (!items || items.length === 0) {
                box.innerHTML = `<div class="px-3 py-2 text-muted small">${emptyMessage}</div>`;
                box.style.display = 'block';
                return;
            }
            window.__storedFoodPick = items;
            box.innerHTML = items.map((item, idx) => {
                const name = (item.name || 'Food').replace(/</g, '&lt;').replace(/'/g, '&#39;');
                return `<div class="px-3 py-2" style="cursor:pointer;border-bottom:1px solid #3a3a5c;" onmousedown="selectStoredFoodPick(${idx})">${name}</div>`;
            }).join('');
            box.style.display = 'block';
        }

        function selectStoredFoodPick(idx) {
            const item = window.__storedFoodPick?.[idx];
            if (!item) return;
            applyPackagedFood(item, 'serving');
            document.getElementById('suggestions').style.display = 'none';
        }

        function showRecentFoods() {
            showStoredFoodPicker(getStoredFoods(recentKey), 'No recent scans yet.');
        }

        function showFavoriteFoods() {
            showStoredFoodPicker(getStoredFoods(favoriteKey), 'No favorites yet.');
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('#aiFoodDescription') && !e.target.closest('#suggestions'))
                document.getElementById('suggestions').style.display = 'none';
        });

        async function estimateMacros() {
            const description = document.getElementById('aiFoodDescription').value.trim();
            if (!description) { alert('Please describe what you ate.'); return; }
            currentPackagedFood = null;
            const amount = document.getElementById('servingAmount').value;
            const unit = document.getElementById('servingUnit').value;
            const btn = document.getElementById('estimateBtn');
            btn.textContent = 'Estimating...'; btn.disabled = true;
            try {
                const res = await fetch('/Nutrition/EstimateMacros', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ foodDescription: description, servingSize: amount ? `${amount} ${unit}` : '' }) });
                const data = await res.json();
                document.getElementById('estCalories').value = data.calories;
                document.getElementById('estProtein').value = data.protein;
                document.getElementById('estCarbs').value = data.carbs;
                document.getElementById('estFat').value = data.fat;
                document.getElementById('aiNote').textContent = data.note || '';
                document.getElementById('aiResult').style.display = 'block';
            } catch { alert('Could not estimate macros. Try again or use manual entry.'); }
            btn.textContent = 'Estimate Macros with AI'; btn.disabled = false;
        }

        async function saveAILog() {
            const mealName = document.getElementById('mealNameSelect').value || 'Meal';
            const foodItem = document.getElementById('aiFoodDescription').value.trim();
            const amount = document.getElementById('servingAmount').value;
            const unit = document.getElementById('servingUnit').value;
            const res = await fetch('/Nutrition/AddAI', {
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({
                    mealName, foodItem,
                    calories: parseInt(document.getElementById('estCalories').value) || 0,
                    protein: parseFloat(document.getElementById('estProtein').value) || 0,
                    carbs: parseFloat(document.getElementById('estCarbs').value) || 0,
                    fat: parseFloat(document.getElementById('estFat').value) || 0,
                    servingSize: amount ? `${amount} ${unit}` : ''
                })
            });
            const data = await res.json();
            if (data.success) window.location.reload();
        }

        function applyPackagedFood(item, preferredMode) {
            if (!item) return;
            currentPackagedFood = item;
            document.getElementById('aiFoodDescription').value = item.name || '';
            applyServingSize(item.servingSize || '');

            let mode = preferredMode || 'serving';
            const servingMissing = !(item.caloriesServing > 0 || item.proteinServing > 0 || item.carbsServing > 0 || item.fatServing > 0);
            if (mode === 'serving' && servingMissing) mode = '100g';
            document.getElementById('macroMode').value = mode;
            applyMacroMode();
            document.getElementById('aiResult').style.display = 'block';
        }

        function applyMacroMode() {
            if (!currentPackagedFood) return;
            const mode = document.getElementById('macroMode').value;
            const useServing = mode === 'serving';

            const cal = useServing ? (currentPackagedFood.caloriesServing ?? 0) : (currentPackagedFood.calories100g ?? 0);
            const pro = useServing ? (currentPackagedFood.proteinServing ?? 0) : (currentPackagedFood.protein100g ?? 0);
            const carb = useServing ? (currentPackagedFood.carbsServing ?? 0) : (currentPackagedFood.carbs100g ?? 0);
            const fat = useServing ? (currentPackagedFood.fatServing ?? 0) : (currentPackagedFood.fat100g ?? 0);

            document.getElementById('estCalories').value = Math.round(cal || 0);
            document.getElementById('estProtein').value = (pro || 0).toFixed(1);
            document.getElementById('estCarbs').value = (carb || 0).toFixed(1);
            document.getElementById('estFat').value = (fat || 0).toFixed(1);

            const modeLabel = useServing ? (currentPackagedFood.servingSize || 'serving') : '100 g';
            const bc = currentPackagedFood.barcode ? `Barcode ${currentPackagedFood.barcode}` : 'Packaged food';
            document.getElementById('aiNote').textContent = `${bc} • macros shown per ${modeLabel}.`;
        }

        function saveCurrentFavorite() {
            if (!currentPackagedFood) return;
            upsertStoredFood(favoriteKey, currentPackagedFood, 'barcode');
            alert('Saved to favorites.');
        }

        function applyServingSize(servingText) {
            if (!servingText) return;
            const m = servingText.trim().match(/(\d+(\.\d+)?)\s*([a-zA-Z]+)/);
            if (!m) return;
            const amount = m[1];
            const unitRaw = (m[3] || '').toLowerCase();
            const unitMap = {
                g: 'g', gram: 'g', grams: 'g',
                ml: 'ml',
                oz: 'oz',
                lb: 'lbs', lbs: 'lbs',
                cup: 'cup', cups: 'cup',
                tbsp: 'tbsp', tablespoon: 'tbsp',
                tsp: 'tsp', teaspoon: 'tsp',
                serving: 'serving',
                piece: 'piece'
            };
            const mapped = unitMap[unitRaw];
            document.getElementById('servingAmount').value = amount;
            if (mapped) document.getElementById('servingUnit').value = mapped;
        }

        async function lookupBarcodeAndPrefill(code) {
            const input = document.getElementById('aiFoodDescription');
            input.value = '';
            try {
                const res = await fetch('/Nutrition/LookupBarcode?code=' + encodeURIComponent(code));
                const data = await res.json();
                if (!data.success) {
                    alert(data.message || 'Could not find this barcode.');
                    return;
                }
                const product = data.product;
                if (!product) {
                    alert('Could not parse barcode details.');
                    return;
                }
                applyPackagedFood(product, 'serving');
                upsertStoredFood(recentKey, product, 'barcode');

                if (Array.isArray(data.alternatives) && data.alternatives.length > 0) {
                    showStoredFoodPicker(data.alternatives, 'No alternatives found.');
                }
            } catch {
                alert('Barcode lookup failed. Please try again.');
            }
        }

        (function () {
            const modalEl = document.getElementById('barcodeScanModal');
            if (!modalEl) return;
            let reader = null;
            let active = false;

            function stopReader() {
                if (reader && active) {
                    reader.stop().catch(() => { });
                }
                active = false;
            }

            modalEl.addEventListener('shown.bs.modal', function () {
                if (typeof Html5Qrcode === 'undefined') return;
                const formats = [
                    Html5QrcodeSupportedFormats.EAN_13,
                    Html5QrcodeSupportedFormats.EAN_8,
                    Html5QrcodeSupportedFormats.UPC_A,
                    Html5QrcodeSupportedFormats.UPC_E
                ];
                reader = new Html5Qrcode('barcodeReader', { formatsToSupport: formats });
                reader.start(
                    { facingMode: 'environment' },
                    { fps: 10, qrbox: { width: 240, height: 140 } },
                    (decodedText) => {
                        stopReader();
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                        lookupBarcodeAndPrefill(decodedText);
                    },
                    () => { }
                ).then(() => { active = true; }).catch(() => { });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                stopReader();
            });
        })();
    </script>
}
